---
import type { Game } from "../data/games";

type Props = {
  game: Game;
};

const { game } = Astro.props;

// Category → CSS class slug (matches .cat-grad-* tokens in global.css).
// Keep this list in sync with the one in library.astro's client-side
// card renderer (catSlug helper) if you add a new category.
function catSlug(category: string): string {
  return category.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
}

const catIcon: Record<string, string> = {
  "Essential Collection": "✦",
  "Must Play":            "◆",
  "Story Focused":        "◈",
  "Open World":           "⬡",
  "Roguelike":            "✧",
  "Difficulty":           "⚔",
  "Fakemon":              "★",
  "Competitive":          "⊞",
  "Anime Inspired":       "◐",
  "Historical Classic":   "◉",
  "Hidden Gem":           "💎",
  "Experimental":         "⟁",
  "Collector Only":       "▣",
  "PMD Inspired":         "🗝",
};

const gradClass = `cat-grad-${catSlug(game.category)}`;
const icon = catIcon[game.category] ?? "◆";

const statusDotClass: Record<string, string> = {
  "Complete":   "status-dot-complete",
  "WIP":        "status-dot-wip",
  "Demo":       "status-dot-demo",
  "Historical": "status-dot-historical",
};
const dotClass = statusDotClass[game.status] ?? "status-dot-historical";

// Runtime label — shortened
const runtimeShort = game.runtime;
---

<a
  href={`/games/${game.id}`}
  class="tilt-card group relative flex flex-col h-full overflow-hidden rounded-2xl border border-slate-700/60 bg-[#0d1117] transition-all duration-300 hover:-translate-y-1 hover:border-cyan-400/40 hover:shadow-[0_0_0_1px_rgba(103,232,249,0.18),0_20px_60px_rgba(0,0,0,0.45)]"
>
  <!-- Specular glare layer driven by the global tilt handler -->
  <div class="tilt-glare"></div>

  <!-- ── Cover header ── -->
  <div
    class={`cover-card h-28 w-full shrink-0 ${gradClass}`}
    transition:name={`cover-${game.id}`}
  >
    <!-- Noise texture overlay -->
    <div class="card-noise absolute inset-0 opacity-[0.18]"></div>

    <!-- Category icon (decorative, behind overlay) -->
    <div
      class="absolute inset-0 flex items-center justify-center text-8xl leading-none opacity-15 select-none"
      style="z-index:1"
    >{icon}</div>

    <!-- Status dot -->
    <div
      class={`${dotClass} absolute top-3 left-3 h-2.5 w-2.5 rounded-full border border-white/20 z-[3]`}
      title={game.status}
    ></div>

    <!-- Runtime badge top-right -->
    <div class="absolute top-3 right-3 z-[3]">
      <span class="rounded-full border border-white/20 bg-black/50 px-2 py-0.5 text-[10px] font-black uppercase tracking-wider text-white/80 backdrop-blur-sm">
        {runtimeShort}
      </span>
    </div>

    <!-- Rating badge — overlaps header/body seam -->
    <div
      class="absolute bottom-[-14px] left-4 z-[4] flex items-center gap-1.5 rounded-full border border-yellow-300/40 bg-[#0d1117]/95 px-3 py-1 backdrop-blur-sm glow-yellow group-hover:border-yellow-300/60"
      transition:name={`rating-${game.id}`}
    >
      <span class="text-sm font-black text-yellow-300" style="text-shadow:0 0 12px rgba(253,224,71,0.6)">{game.rating}</span>
      <span class="text-[9px] text-yellow-300/50">/ 10</span>
    </div>
  </div>

  <!-- ── Card body ── -->
  <div class="flex flex-col flex-1 pt-7 px-4 pb-4">

    <!-- Name -->
    <h3
      class="text-sm font-black leading-tight text-white clamp-2 group-hover:text-cyan-100 transition-colors"
      transition:name={`name-${game.id}`}
    >
      {game.name}
    </h3>

    <!-- Type + Base -->
    <p class="mt-1 text-[11px] text-slate-500">
      {game.type} · {game.base}
    </p>

    <!-- Creator -->
    {game.creator && (
      <p class="mt-0.5 text-[11px] italic text-slate-600 truncate">{game.creator}</p>
    )}

    <!-- Description -->
    <p class="mt-2 text-[11px] leading-[1.55] text-slate-400 clamp-2 flex-1">
      {game.description}
    </p>

    <!-- Stat row -->
    <div class="mt-3 grid grid-cols-3 gap-1 border-t border-slate-800/80 pt-3">
      {[
        { label: "Length", value: game.length.replace("Run-Based","Runs") },
        { label: "Difficulty", value: game.difficulty.replace("Hard Mode Available","Hard+").replace("Normal Default","Normal").replace("Hard Default","Hard") },
        { label: "Story", value: game.story.replace("Very Story Heavy","V. Heavy").replace("Story Heavy","Heavy").replace("Good Story","Good").replace("Standard Story","Standard").replace("Minimal Story","Minimal") },
      ].map(({ label, value }) => (
        <div class="text-center">
          <div class="text-[9px] font-black uppercase tracking-widest text-slate-600">{label}</div>
          <div class="mt-0.5 text-[11px] font-bold text-slate-300 leading-tight">{value}</div>
        </div>
      ))}
    </div>

    <!-- Tag strip -->
    {game.tags.length > 0 && (
      <div class="mt-3 flex items-center gap-1.5 overflow-hidden" style="mask-image:linear-gradient(to right,black 80%,transparent)">
        {game.tags.slice(0, 4).map((tag: string) => (
          <button
            data-tag={tag}
            class="tag-chip shrink-0 rounded-full border border-cyan-400/20 bg-cyan-400/5 px-2 py-0.5 text-[10px] font-bold text-cyan-400/70 transition hover:border-cyan-400/50 hover:text-cyan-300"
          >
            {tag}
          </button>
        ))}
      </div>
    )}
  </div>
</a>

<script>
  function initTagChips() {
    document.querySelectorAll<HTMLButtonElement>(".tag-chip:not([data-bound])").forEach((chip) => {
      chip.setAttribute("data-bound", "1");
      chip.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        const tag = (e.currentTarget as HTMLButtonElement).dataset.tag;
        if (tag) window.location.href = `/library?tag=${encodeURIComponent(tag)}`;
      });
    });
  }
  document.addEventListener("astro:page-load", initTagChips);
</script>
