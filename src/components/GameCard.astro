---
import type { Game } from "../data/games";
import { getDifficultyPips, getPlaytime } from "../data/games";

type Props = {
  game: Game;
  layout?: "grid" | "horizontal";
};

const { game, layout = "grid" } = Astro.props;

function catSlug(category: string): string {
  return category.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
}

const gradClass = `cat-grad-${catSlug(game.category)}`;
const pips = getDifficultyPips(game);
const playtime = getPlaytime(game);

// Aspect ratio class based on hardware runtime
const aspectClass =
  game.runtime === "GBA" ? "aspect-box-gba" :
  game.runtime === "GBC" || game.runtime === "GB" ? "aspect-box-gbc" :
  game.runtime === "NDS" || game.runtime === "3DS" ? "aspect-box-nds" :
  "aspect-box-pc";

const statusDotColor =
  game.status === "Complete" ? "bg-emerald-400 shadow-[0_0_8px_#34d399]" :
  game.status === "WIP" ? "bg-amber-400 shadow-[0_0_8px_#fbbf24]" :
  game.status === "Demo" ? "bg-cyan-400 shadow-[0_0_8px_#38bdf8]" :
  "bg-slate-500";
---

{layout === "grid" ? (
  <div
    class="hardware-card-wrap tilt-card group relative flex flex-col h-[398px] max-h-[398px] overflow-hidden rounded-2xl border border-white/[0.08] border-t-white/[0.14] bg-[#161B29] transition-all duration-300 hover:border-cyan-400/40 hover:shadow-[0_20px_50px_rgba(0,0,0,0.6)] cursor-pointer select-none"
    data-card-href={`/games/${game.id}`}
  >
    <!-- Stretched Primary Link: guarantees whole card clicks navigate to game page -->
    <a
      href={`/games/${game.id}`}
      class="card-primary-link absolute inset-0 z-[4] cursor-pointer"
      aria-label={`Open ${game.name} game record`}
      tabindex="-1"
    ></a>

    <div class="tilt-glare"></div>

    <!-- ── 3D Hardware Box-Art Frame (Standardized Dedicated 208px Height) ── -->
    <div class={`relative w-full h-52 shrink-0 overflow-hidden ${gradClass} quick-peek-box`}>
      
      <!-- Static Box-Art Layer -->
      <div class="absolute inset-0 flex flex-col justify-between p-3.5 bg-gradient-to-b from-black/25 via-transparent to-black/85 z-[1]">
        
        <!-- Top bar: Hardware tag & Status badge -->
        <div class="flex items-center justify-between">
          <span class="rounded-md border border-white/20 bg-black/60 px-2 py-0.5 text-[10px] font-mono-spec font-bold text-white uppercase backdrop-blur-md">
            {game.runtime}
          </span>
          <div class="flex items-center gap-1.5 rounded-full border border-white/10 bg-black/50 px-2 py-0.5 backdrop-blur-md">
            <span class={`h-2 w-2 rounded-full ${statusDotColor}`}></span>
            <span class="text-[9px] font-mono-spec font-bold text-slate-300">{game.status}</span>
          </div>
        </div>

        <!-- Rating Badge -->
        <div class="self-end rounded-xl border border-yellow-400/30 bg-[#090B10]/90 px-2.5 py-1 backdrop-blur-md shadow-lg">
          <span class="text-xs font-mono-spec font-black text-yellow-300">★ {game.rating}</span>
        </div>
      </div>

      <!-- In-Game Screenshot / Quick-Peek Crossfade (400ms transition) -->
      <div class="quick-peek-screenshot z-[2] bg-gradient-to-br from-slate-900 via-[#111520] to-black flex items-center justify-center p-5 text-center pointer-events-none">
        <div class="space-y-1.5">
          <span class="text-3xl opacity-40 select-none">🎮</span>
          <div class="text-[11px] font-mono-spec font-bold text-cyan-300">Quick-Peek Preview</div>
          <p class="text-[10px] text-slate-300 line-clamp-3 px-1 leading-snug">{game.description}</p>
        </div>
      </div>

      <!-- Quick Action Floating Buttons (Revealed on hover) -->
      <div class="quick-actions-bar flex items-center justify-center gap-1.5 backdrop-blur-md bg-black/70 p-1.5 rounded-xl border border-white/15 relative z-[10]">
        <button
          type="button"
          class="card-action-wishlist flex-1 rounded-lg bg-white/10 py-1 text-[11px] font-bold text-slate-200 transition hover:bg-rose-500 hover:text-white pointer-events-auto"
          data-id={game.id}
          data-name={game.name}
          title="Add to Wishlist"
        >
          ♡ Wishlist
        </button>
        <button
          type="button"
          class="card-action-compare flex-1 rounded-lg bg-white/10 py-1 text-[11px] font-bold text-slate-200 transition hover:bg-cyan-500 hover:text-slate-950 pointer-events-auto"
          data-id={game.id}
          data-name={game.name}
          title="Add to Compare Dock"
        >
          ⇄ Compare
        </button>
        <button
          type="button"
          class="card-action-completed flex-1 rounded-lg bg-white/10 py-1 text-[11px] font-bold text-slate-200 transition hover:bg-emerald-500 hover:text-white pointer-events-auto"
          data-id={game.id}
          data-name={game.name}
          title="Mark as Completed"
        >
          ✓ Done
        </button>
      </div>
    </div>

    <!-- ── Card Main Info (Standardized Default Height: 154px) ── -->
    <div class="card-text-strip flex flex-col justify-between h-[154px] shrink-0 p-4 border-t border-white/[0.04] bg-[#161B29] overflow-hidden relative z-[2]">
      <div>
        <div class="flex items-start justify-between gap-2">
          <a href={`/games/${game.id}`} class="text-sm font-black text-white hover:text-cyan-200 line-clamp-1 leading-snug relative z-[10]">
            {game.name}
          </a>
        </div>

        <p class="mt-0.5 text-[11px] text-slate-500 line-clamp-1">
          by <span class="text-slate-400">{game.creator || "Community"}</span> · {game.category}
        </p>

        <p class="mt-1.5 text-xs leading-relaxed text-slate-400 line-clamp-2">
          {game.description}
        </p>
      </div>

      <!-- Tag strip (flat, clean tag pills) -->
      {game.tags.length > 0 && (
        <div class="mt-1.5 flex items-center gap-1.5 overflow-hidden h-6 relative z-[10]">
          {game.tags.slice(0, 3).map((tag) => (
            <a
              href={`/library?tag=${encodeURIComponent(tag)}`}
              class="shrink-0 rounded-full border border-white/[0.08] bg-[#111520] px-2 py-0.5 text-[10px] font-mono-spec font-bold text-slate-400 transition hover:border-cyan-400/40 hover:text-cyan-300 pointer-events-auto"
            >
              #{tag}
            </a>
          ))}
        </div>
      )}
    </div>

    <!-- ── At-a-Glance Micro-Spec Bar (Standardized 36px) ── -->
    <div class="micro-spec-bar text-slate-400 h-9 shrink-0 relative z-[2]">
      <!-- 1. Base Game / Engine -->
      <div class="truncate text-[10px]" title={`Base: ${game.base}`}>
        <span class="text-slate-600">Base:</span> <span class="text-slate-300">{game.base}</span>
      </div>

      <!-- 2. Difficulty Meter (1-5 Pips) -->
      <div class="flex items-center justify-center gap-1.5" title={`Difficulty: ${game.difficulty} (${pips}/5)`}>
        <span class="text-[9px] text-slate-600">DIFF:</span>
        <div class="difficulty-pips">
          {[1, 2, 3, 4, 5].map((idx) => (
            <span class={`diff-pip ${idx <= pips ? `filled-${pips}` : ""}`}></span>
          ))}
        </div>
      </div>

      <!-- 3. Playtime Estimate in JetBrains Mono -->
      <div class="text-right text-[10px] font-mono-spec text-slate-300" title={`Playtime estimate: ${playtime}`}>
        ⏱ {playtime}
      </div>
    </div>
  </div>
) : (
  <div
    class="hardware-card-wrap tilt-card group relative flex flex-col md:flex-row overflow-hidden rounded-2xl border border-white/[0.08] border-t-white/[0.14] bg-[#161B29] transition-all hover:border-cyan-400/40 hover:shadow-2xl cursor-pointer select-none"
    data-card-href={`/games/${game.id}`}
  >
    <a
      href={`/games/${game.id}`}
      class="card-primary-link absolute inset-0 z-[4] cursor-pointer"
      aria-label={`Open ${game.name} game record`}
      tabindex="-1"
    ></a>

    <div class="tilt-glare"></div>

    <!-- Left Box-Art Thumb -->
    <div class={`relative w-full md:w-56 shrink-0 h-44 ${gradClass} overflow-hidden p-4 flex flex-col justify-between`}>
      <div class="flex items-center justify-between z-10">
        <span class="rounded bg-black/60 px-2 py-0.5 text-[10px] font-mono-spec font-bold text-white uppercase backdrop-blur-md">
          {game.runtime}
        </span>
        <span class="rounded-xl border border-yellow-400/30 bg-[#090B10]/90 px-2 py-0.5 text-xs font-mono-spec font-black text-yellow-300">
          ★ {game.rating}
        </span>
      </div>
      <div class="z-10">
        <span class="rounded bg-black/60 px-2 py-0.5 text-[9px] font-mono-spec text-slate-300">
          {game.status}
        </span>
      </div>
    </div>

    <!-- Right Content Body -->
    <div class="flex flex-1 flex-col justify-between p-5 relative z-[2]">
      <div>
        <div class="flex items-start justify-between gap-4">
          <div>
            <a href={`/games/${game.id}`} class="text-lg font-black text-white hover:text-cyan-200 relative z-[10]">
              {game.name}
            </a>
            <p class="text-xs text-slate-500">
              by <span class="font-bold text-slate-400">{game.creator || "Community"}</span> · Base: <span class="text-cyan-300">{game.base}</span> · {game.category}
            </p>
          </div>
          
          <div class="flex items-center gap-1 shrink-0 relative z-[10]">
            <button
              class="card-action-wishlist rounded-lg border border-white/[0.08] bg-[#111520] p-2 text-xs text-slate-400 hover:border-rose-400/50 hover:text-rose-300 pointer-events-auto"
              data-id={game.id}
              data-name={game.name}
              title="Wishlist"
            >
              ♡
            </button>
            <button
              class="card-action-compare rounded-lg border border-white/[0.08] bg-[#111520] p-2 text-xs text-slate-400 hover:border-cyan-400/50 hover:text-cyan-300 pointer-events-auto"
              data-id={game.id}
              data-name={game.name}
              title="Compare"
            >
              ⇄
            </button>
          </div>
        </div>

        <p class="mt-3 text-xs leading-relaxed text-slate-300">
          {game.description}
        </p>

        <!-- Flat Tag Pills -->
        <div class="mt-4 flex flex-wrap gap-1.5 relative z-[10]">
          {game.tags.map((tag) => (
            <a
              href={`/library?tag=${encodeURIComponent(tag)}`}
              class="rounded-full border border-white/[0.08] bg-[#111520] px-2.5 py-0.5 text-[10px] font-mono-spec font-bold text-slate-400 hover:border-cyan-400/40 hover:text-cyan-300 pointer-events-auto"
            >
              #{tag}
            </a>
          ))}
        </div>
      </div>

      <!-- Micro-Spec Strip -->
      <div class="mt-4 flex items-center justify-between border-t border-white/[0.08] pt-3 text-[11px] font-mono-spec text-slate-400">
        <div>Base: <span class="text-slate-200">{game.base}</span></div>
        <div class="flex items-center gap-1.5">
          <span>Diff ({pips}/5):</span>
          <div class="difficulty-pips">
            {[1, 2, 3, 4, 5].map((idx) => (
              <span class={`diff-pip ${idx <= pips ? `filled-${pips}` : ""}`}></span>
            ))}
          </div>
        </div>
        <div>⏱ {playtime}</div>
      </div>
    </div>
  </div>
)}

<script>
  function bindCardActions() {
    // 1. Delegated Card Click Navigation
    if (!(window as any).__cardNavBound) {
      (window as any).__cardNavBound = true;
      document.addEventListener("click", (e) => {
        const target = e.target as HTMLElement | null;
        if (!target) return;
        // If clicked inside interactive buttons, tag links, or inputs, do not intercept
        if (target.closest("button, .quick-actions-bar, a[href*='tag='], a[href*='category='], input, select")) {
          return;
        }
        const card = target.closest<HTMLElement>("[data-card-href]");
        if (card) {
          const href = card.getAttribute("data-card-href");
          if (href) {
            window.location.href = href;
          }
        }
      });
    }

    // 2. Action Buttons Listeners
    document.querySelectorAll<HTMLButtonElement>(".card-action-wishlist:not([data-bound])").forEach((btn) => {
      btn.setAttribute("data-bound", "1");
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        (window as any).toggleWishlist?.(btn.dataset.id, btn.dataset.name);
      });
    });

    document.querySelectorAll<HTMLButtonElement>(".card-action-compare:not([data-bound])").forEach((btn) => {
      btn.setAttribute("data-bound", "1");
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        (window as any).toggleCompareItem?.(btn.dataset.id, btn.dataset.name);
      });
    });

    document.querySelectorAll<HTMLButtonElement>(".card-action-completed:not([data-bound])").forEach((btn) => {
      btn.setAttribute("data-bound", "1");
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        (window as any).toggleCompleted?.(btn.dataset.id, btn.dataset.name);
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", bindCardActions);
  } else {
    bindCardActions();
  }
  document.addEventListener("astro:page-load", bindCardActions);
</script>
