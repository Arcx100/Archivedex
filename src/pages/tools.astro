---
import BaseLayout from "../layouts/BaseLayout.astro";
import { tools } from "../data/tools";

const toolCategories = [
  "All",
  "Engine & Framework",
  "Decompilation",
  "Calculator",
  "Reference & Charts",
  "Audio & Music",
  "Utility",
];
---

<BaseLayout title="Developer Tools & Documentation · ArchiveDex" description="Dedicated archive of Pokémon ROM hacking engines, CFRU manuals, decompilation projects, damage calculators, and sound tools.">
  <main class="mx-auto max-w-[1500px] px-6 py-10">

    <div class="mb-4">
      <a href="/library" class="text-xs font-mono-spec font-bold text-cyan-400 hover:underline">← Back to Playable Games</a>
    </div>

    <!-- Header -->
    <header class="mb-8" data-reveal>
      <div class="flex items-center gap-2">
        <span class="rounded-md border border-cyan-400/30 bg-cyan-500/10 px-2.5 py-0.5 text-[10px] font-mono-spec font-black uppercase tracking-widest text-cyan-300">
          Technical Preservation Vault
        </span>
        <span class="text-xs font-mono-spec text-slate-500">10 Verified Tools & Engines</span>
      </div>
      <h1 class="mt-2 text-4xl sm:text-5xl font-black text-white">Tools, Engines & Documentation</h1>
      <p class="mt-2 text-xs sm:text-sm text-slate-400 max-w-2xl font-mono-spec">
        Separated from playable game routes: developer frameworks, decomp bases, CFRU documentation, battle calculators, and audio injection pipelines.
      </p>
    </header>

    <!-- Category Filter Strip -->
    <div class="mb-8 flex flex-wrap items-center gap-2 font-mono-spec text-xs" data-reveal style="--reveal-delay:40ms">
      {toolCategories.map((cat, i) => (
        <button
          class={`tool-filter-btn rounded-xl px-4 py-2 font-bold transition ${
            i === 0
              ? "active-tool-filter bg-cyan-500/20 text-cyan-300 border border-cyan-400/40"
              : "border border-white/[0.08] bg-[#161B29] text-slate-400 hover:text-white"
          }`}
          data-cat={cat}
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Tools Grid -->
    <div id="tools-grid" class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {tools.map((tool) => (
        <div class="tool-card tilt-card group rounded-3xl border border-white/[0.08] border-t-white/[0.14] bg-[#161B29] p-6 shadow-xl transition-all hover:border-cyan-400/40 hover:shadow-2xl flex flex-col justify-between" data-category={tool.category}>
          <div class="tilt-glare"></div>

          <div>
            <!-- Top Tag & Runtime -->
            <div class="flex items-center justify-between pb-3 border-b border-white/[0.06]">
              <span class="rounded bg-cyan-500/10 border border-cyan-400/30 px-2 py-0.5 text-[10px] font-mono-spec font-bold text-cyan-300">
                {tool.category}
              </span>
              <span class="text-[10px] font-mono-spec text-slate-400">
                {tool.runtime}
              </span>
            </div>

            <!-- Title & Creator -->
            <h2 class="mt-4 text-xl font-black text-white group-hover:text-cyan-200 transition-colors">
              {tool.name}
            </h2>
            <p class="text-xs font-mono-spec text-slate-500 mt-0.5">
              by <span class="text-slate-300 font-bold">{tool.creator}</span>
            </p>

            <!-- Description -->
            <p class="mt-3 text-xs leading-relaxed text-slate-300">
              {tool.description}
            </p>

            <!-- Why It Matters -->
            <div class="mt-4 rounded-xl border border-white/[0.06] bg-[#111520] p-3 text-[11px] leading-relaxed text-slate-400">
              <strong class="text-slate-200 block mb-0.5">Significance:</strong>
              {tool.whyItMatters}
            </div>

            <!-- Feature Bullet List -->
            <div class="mt-4 space-y-1.5 font-mono-spec text-[11px] text-slate-300">
              {tool.features.map((feat) => (
                <div class="flex items-start gap-2">
                  <span class="text-cyan-400 shrink-0">✦</span>
                  <span>{feat}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Bottom Actions & Verification Badge -->
          <div class="mt-6 pt-4 border-t border-white/[0.08] flex items-center justify-between">
            <span class="rounded-full bg-emerald-500/10 border border-emerald-400/30 px-2.5 py-0.5 text-[10px] font-mono-spec font-bold text-emerald-300">
              ✓ {tool.safetyStatus}
            </span>

            <div class="flex items-center gap-2">
              {tool.repositoryUrl && (
                <a
                  href={tool.repositoryUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="rounded-xl border border-white/[0.1] bg-[#111520] px-3 py-1.5 text-xs font-mono-spec font-bold text-slate-300 hover:border-cyan-400 hover:text-cyan-300"
                >
                  GitHub ↗
                </a>
              )}
              {tool.officialSource && (
                <a
                  href={tool.officialSource}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="rounded-xl bg-cyan-400 px-3.5 py-1.5 text-xs font-black text-slate-950 hover:bg-cyan-300"
                >
                  Visit Tool ↗
                </a>
              )}
            </div>
          </div>

        </div>
      ))}
    </div>

  </main>
</BaseLayout>

<script>
  function initToolsFilter() {
    const buttons = document.querySelectorAll<HTMLButtonElement>(".tool-filter-btn");
    const cards = document.querySelectorAll<HTMLElement>(".tool-card");

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const cat = btn.dataset.cat || "All";

        buttons.forEach((b) => {
          b.classList.remove("active-tool-filter", "bg-cyan-500/20", "text-cyan-300", "border-cyan-400/40");
          b.classList.add("border-white/[0.08]", "bg-[#161B29]", "text-slate-400");
        });

        btn.classList.add("active-tool-filter", "bg-cyan-500/20", "text-cyan-300", "border-cyan-400/40");
        btn.classList.remove("border-white/[0.08]", "bg-[#161B29]", "text-slate-400");

        cards.forEach((card) => {
          const cardCat = card.dataset.category;
          const show = cat === "All" || cardCat === cat;
          card.classList.toggle("hidden", !show);
        });
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initToolsFilter);
  } else {
    initToolsFilter();
  }
  document.addEventListener("astro:page-load", initToolsFilter);
</script>
