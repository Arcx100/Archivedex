---
import BaseLayout from "../layouts/BaseLayout.astro";
import GameCard from "../components/GameCard.astro";
import { games, categories, runtimes, statuses } from "../data/games";

const PAGE_SIZE = 48;

// Top popular tags for fast chips
const tagCounts = new Map<string, number>();
for (const g of games) {
  for (const tag of g.tags) tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
}
const allTags = [...tagCounts.keys()].filter((t) => (tagCounts.get(t) ?? 0) >= 4).sort();

const initialGames = [...games].sort((a, b) => b.rating - a.rating).slice(0, PAGE_SIZE);
---

<BaseLayout title="Library · ArchiveDex Pokémon Archive" description="Comprehensive searchable archive of 632 Pokémon ROM hacks, fan games, and preservation projects.">
  <main class="mx-auto max-w-[1600px] px-6 py-8">

    <!-- Header Section -->
    <header class="mb-6 flex flex-wrap items-end justify-between gap-4" data-reveal>
      <div>
        <div class="flex items-center gap-2">
          <span class="rounded-md border border-cyan-400/30 bg-cyan-500/10 px-2.5 py-0.5 text-[10px] font-mono-spec font-black uppercase tracking-widest text-cyan-300">
            Vault Index
          </span>
          <span class="text-xs font-mono-spec text-slate-500">632 Playable Titles</span>
        </div>
        <h1 class="mt-2 text-4xl font-black text-white sm:text-5xl">
          Archive Library
        </h1>
      </div>

      <!-- Live Match Counter & Reset -->
      <div class="flex items-center gap-3">
        <div class="rounded-xl border border-white/[0.08] bg-[#161B29] px-4 py-2 text-xs font-mono-spec">
          Showing <span id="result-count" class="font-bold text-cyan-300">{games.length}</span> of {games.length} games
        </div>
        <button id="reset-all-btn" class="rounded-xl border border-white/[0.08] bg-[#161B29] px-3.5 py-2 text-xs font-bold text-slate-400 transition hover:border-red-400/40 hover:text-red-300">
          Reset Filters
        </button>
      </div>
    </header>

    <!-- ═══════════════════════════════════════════ -->
    <!-- VIEW SWITCHER & MULTI-FILTER BAR            -->
    <!-- ═══════════════════════════════════════════ -->
    <section class="glass-panel mb-6 rounded-2xl p-4 sm:p-5" data-reveal style="--reveal-delay:40ms">
      
      <!-- Top Row: Search + View Mode Switcher -->
      <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
        
        <!-- Search Input -->
        <div class="relative flex-1">
          <span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-slate-500">🔍</span>
          <input
            id="lib-search"
            type="text"
            placeholder="Search by title, creator, engine, generation, mechanic (#following, #megas)…"
            class="w-full rounded-xl border border-white/[0.08] bg-[#111520] py-2.5 pl-10 pr-4 text-xs font-medium text-white placeholder-slate-500 outline-none transition focus:border-cyan-400 focus:shadow-[0_0_15px_rgba(34,211,238,0.2)]"
          />
        </div>

        <!-- Toolbar Controls: View Mode Switcher + Card Style Switcher -->
        <div class="flex flex-wrap items-center gap-2 self-start font-mono-spec">
          <!-- 3 View Modes Switcher: Grid, Horizontal, Table -->
          <div class="flex items-center gap-1 rounded-xl border border-white/[0.08] bg-[#111520] p-1">
            <button id="view-mode-grid" class="view-btn active-view flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-xs font-bold transition">
              <span>⊞</span>
              <span>Box-Art Grid</span>
            </button>
            <button id="view-mode-horizontal" class="view-btn flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-xs font-bold text-slate-400 transition hover:text-white">
              <span>☰</span>
              <span>Horizontal</span>
            </button>
            <button id="view-mode-table" class="view-btn flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-xs font-bold text-slate-400 transition hover:text-white">
              <span>▤</span>
              <span>Collector Table</span>
            </button>
          </div>

          <!-- Card Style Preset Switcher (Holo Neo / Retro Cartridge / Monolith Obsidian) -->
          <div class="relative">
            <button
              id="lib-card-theme-btn"
              title="Change Card View Theme Preset"
              class="flex items-center gap-1.5 rounded-xl border border-white/[0.08] bg-[#111520] px-3 py-2 text-xs font-bold text-slate-300 transition hover:border-cyan-400/40 hover:bg-[#1E2538]"
            >
              <span id="lib-card-theme-icon" class="text-cyan-400">✦</span>
              <span id="lib-card-theme-label">Holo Neo</span>
              <span class="text-[9px] text-slate-500">▼</span>
            </button>
            <div
              id="lib-card-theme-menu"
              class="absolute right-0 mt-2 hidden w-48 rounded-xl border border-white/[0.12] bg-[#161B29] p-1.5 shadow-2xl backdrop-blur-2xl z-50 space-y-0.5 text-xs"
            >
              <button data-lib-card-theme="holo" class="lib-card-theme-opt flex w-full items-center justify-between rounded-lg px-2.5 py-1.5 text-left text-slate-200 transition hover:bg-[#1E2538]">
                <div class="flex items-center gap-2"><span class="text-cyan-400">✦</span><span>Holo Neo</span></div>
                <span class="text-[9px] text-slate-500">Glass</span>
              </button>
              <button data-lib-card-theme="retro" class="lib-card-theme-opt flex w-full items-center justify-between rounded-lg px-2.5 py-1.5 text-left text-slate-200 transition hover:bg-[#1E2538]">
                <div class="flex items-center gap-2"><span class="text-yellow-400">🕹️</span><span>Retro Cartridge</span></div>
                <span class="text-[9px] text-slate-500">Slate</span>
              </button>
              <button data-lib-card-theme="monolith" class="lib-card-theme-opt flex w-full items-center justify-between rounded-lg px-2.5 py-1.5 text-left text-slate-200 transition hover:bg-[#1E2538]">
                <div class="flex items-center gap-2"><span class="text-white">⬛</span><span>Monolith Obsidian</span></div>
                <span class="text-[9px] text-slate-500">Vault</span>
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Second Row: Multi-Select Filter Dropdowns -->
      <div class="mt-4 grid grid-cols-2 gap-2.5 sm:grid-cols-3 lg:grid-cols-6 font-mono-spec text-xs">
        
        <!-- Platform -->
        <select id="filter-platform" class="lib-select rounded-xl border border-white/[0.08] bg-[#111520] px-3 py-2 text-slate-200 outline-none transition focus:border-cyan-400">
          <option value="">All Platforms</option>
          {runtimes.map((r) => <option value={r}>{r}</option>)}
        </select>

        <!-- Status -->
        <select id="filter-status" class="lib-select rounded-xl border border-white/[0.08] bg-[#111520] px-3 py-2 text-slate-200 outline-none transition focus:border-cyan-400">
          <option value="">All Statuses</option>
          {statuses.map((s) => <option value={s}>{s}</option>)}
        </select>

        <!-- Category -->
        <select id="filter-category" class="lib-select rounded-xl border border-white/[0.08] bg-[#111520] px-3 py-2 text-slate-200 outline-none transition focus:border-cyan-400">
          <option value="">All Categories</option>
          {categories.map((c) => <option value={c}>{c}</option>)}
        </select>

        <!-- Difficulty Meter Filter -->
        <select id="filter-difficulty" class="lib-select rounded-xl border border-white/[0.08] bg-[#111520] px-3 py-2 text-slate-200 outline-none transition focus:border-cyan-400">
          <option value="">Any Difficulty</option>
          <option value="1">1 Pip - Casual / Easy</option>
          <option value="2">2 Pips - Vanilla / Normal</option>
          <option value="3">3 Pips - Normal to Hard</option>
          <option value="4">4 Pips - Hard / Hardcore</option>
          <option value="5">5 Pips - Kaizo / Extreme</option>
        </select>

        <!-- Playtime / Length -->
        <select id="filter-length" class="lib-select rounded-xl border border-white/[0.08] bg-[#111520] px-3 py-2 text-slate-200 outline-none transition focus:border-cyan-400">
          <option value="">Any Playtime</option>
          <option value="Short">Short (&lt; 15h)</option>
          <option value="Medium">Medium (18-28h)</option>
          <option value="Long">Long (30-45h)</option>
          <option value="Huge">Huge (45-75h)</option>
          <option value="Run-Based">Run-Based / Roguelike</option>
        </select>

        <!-- Sort Option -->
        <select id="filter-sort" class="lib-select rounded-xl border border-white/[0.08] bg-[#111520] px-3 py-2 text-slate-200 outline-none transition focus:border-cyan-400">
          <option value="rating-desc">Rating: High → Low</option>
          <option value="rating-asc">Rating: Low → High</option>
          <option value="name-asc">Name: A → Z</option>
          <option value="name-desc">Name: Z → A</option>
          <option value="difficulty-desc">Difficulty: High → Low</option>
        </select>
      </div>

      <!-- Active Filter Pill Chips Strip -->
      <div id="active-pills-wrap" class="mt-3.5 hidden flex-wrap items-center gap-2 border-t border-white/[0.06] pt-3">
        <span class="text-[10px] font-black uppercase tracking-wider text-slate-500 font-mono-spec">Active:</span>
        <div id="active-pills-list" class="flex flex-wrap gap-1.5"></div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════ -->
    <!-- QUICK TAG CHIPS CAROUSEL                    -->
    <!-- ═══════════════════════════════════════════ -->
    <div class="mb-6 flex items-center gap-2 overflow-x-auto pb-1 no-scrollbar font-mono-spec text-xs">
      <span class="text-[10px] font-bold uppercase text-slate-500 shrink-0">Popular:</span>
      {allTags.slice(0, 18).map((tag) => (
        <button
          data-filter-tag={tag}
          class="cloud-tag-btn shrink-0 rounded-full border border-white/[0.08] bg-[#161B29] px-3 py-1 text-[11px] font-bold text-slate-400 transition hover:border-cyan-400/50 hover:text-cyan-300"
        >
          #{tag}
        </button>
      ))}
    </div>

    <!-- ═══════════════════════════════════════════ -->
    <!-- VIEW 1: 3D BOX-ART GRID                     -->
    <!-- ═══════════════════════════════════════════ -->
    <section id="library-grid-view" class="grid gap-5 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5">
      {initialGames.map((game) => (
        <div class="game-card-item" data-id={game.id}>
          <GameCard game={game} layout="grid" />
        </div>
      ))}
    </section>

    <!-- ═══════════════════════════════════════════ -->
    <!-- VIEW 2: DETAILED HORIZONTAL CARDS           -->
    <!-- ═══════════════════════════════════════════ -->
    <section id="library-horizontal-view" class="hidden space-y-4">
      <!-- Injected client-side or on mode switch -->
    </section>

    <!-- ═══════════════════════════════════════════ -->
    <!-- VIEW 3: COMPACT COLLECTOR TABLE             -->
    <!-- ═══════════════════════════════════════════ -->
    <section id="library-table-view" class="hidden overflow-x-auto rounded-2xl border border-white/[0.08] bg-[#161B29]">
      <table class="w-full text-left text-xs font-mono-spec">
        <thead class="border-b border-white/[0.08] bg-[#111520] text-slate-400 uppercase tracking-wider text-[10px]">
          <tr>
            <th class="cursor-pointer px-4 py-3 hover:text-cyan-300" data-col="name">Game Title ⬍</th>
            <th class="cursor-pointer px-3 py-3 hover:text-cyan-300" data-col="runtime">Platform ⬍</th>
            <th class="cursor-pointer px-3 py-3 hover:text-cyan-300" data-col="base">Base Engine ⬍</th>
            <th class="cursor-pointer px-3 py-3 hover:text-cyan-300" data-col="rating">Rating ⬍</th>
            <th class="cursor-pointer px-3 py-3 hover:text-cyan-300" data-col="status">Status ⬍</th>
            <th class="cursor-pointer px-3 py-3 hover:text-cyan-300" data-col="pips">Diff (1-5) ⬍</th>
            <th class="px-3 py-3">Playtime</th>
            <th class="px-3 py-3">Creator</th>
            <th class="px-4 py-3 text-right">Actions</th>
          </tr>
        </thead>
        <tbody id="collector-table-body" class="divide-y divide-white/[0.04] text-slate-300">
          <!-- Populated via client-side data -->
        </tbody>
      </table>
    </section>

    <!-- Load More Pagination Button -->
    <div class="mt-10 flex justify-center">
      <button
        id="lib-load-more"
        class="hidden rounded-2xl border border-white/[0.12] bg-[#161B29] px-8 py-3 text-xs font-mono-spec font-bold text-slate-300 transition hover:border-cyan-400/50 hover:bg-[#1E2538] hover:text-white"
      >
        Load More Games…
      </button>
    </div>
    <div id="lib-scroll-sentinel" class="h-4 w-full"></div>

    <!-- Empty State -->
    <div id="lib-empty-state" class="mt-8 hidden rounded-3xl border border-white/[0.08] bg-[#161B29] p-16 text-center">
      <div class="mb-4 text-6xl opacity-30">⬡</div>
      <h3 class="text-2xl font-black text-white">No Pokémon projects match your query</h3>
      <p class="mt-2 text-xs text-slate-400">Try broadening your search term or clearing active filter chips.</p>
      <button id="clear-empty-btn" class="mt-5 rounded-xl bg-cyan-400 px-6 py-2.5 text-xs font-black text-slate-950 hover:bg-cyan-300">
        Clear All Filters
      </button>
    </div>

  </main>
</BaseLayout>

<style>
  .active-view {
    background-color: var(--theme-pill-bg, rgba(34, 211, 238, 0.15));
    color: var(--accent-highlight, #22d3ee);
    border: 1px solid var(--theme-pill-border, rgba(34, 211, 238, 0.35));
  }
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>

<script>
  type GameEntry = {
    id: string;
    name: string;
    type: string;
    base: string;
    runtime: string;
    status: string;
    category: string;
    rating: number;
    length: string;
    difficulty: string;
    grind: string;
    story: string;
    dex: string;
    sourceStatus: string;
    tags: string[];
    mood: string[];
    description: string;
    creator: string;
    pips: number;
    playtime: string;
    __search?: string;
  };

  const PAGE_SIZE = 48;

  function initLibrary() {
    const searchInput = document.getElementById("lib-search") as HTMLInputElement;
    const platformSelect = document.getElementById("filter-platform") as HTMLSelectElement;
    const statusSelect = document.getElementById("filter-status") as HTMLSelectElement;
    const categorySelect = document.getElementById("filter-category") as HTMLSelectElement;
    const difficultySelect = document.getElementById("filter-difficulty") as HTMLSelectElement;
    const lengthSelect = document.getElementById("filter-length") as HTMLSelectElement;
    const sortSelect = document.getElementById("filter-sort") as HTMLSelectElement;
    const resultCountEl = document.getElementById("result-count") as HTMLElement;
    const resetBtn = document.getElementById("reset-all-btn");
    const emptyState = document.getElementById("lib-empty-state");
    const clearEmptyBtn = document.getElementById("clear-empty-btn");
    const loadMoreBtn = document.getElementById("lib-load-more") as HTMLButtonElement;
    const sentinel = document.getElementById("lib-scroll-sentinel") as HTMLElement;

    // View containers
    const gridView = document.getElementById("library-grid-view");
    const horizontalView = document.getElementById("library-horizontal-view");
    const tableView = document.getElementById("library-table-view");
    const tableBody = document.getElementById("collector-table-body");

    // View mode switch buttons
    const btnGrid = document.getElementById("view-mode-grid");
    const btnHorizontal = document.getElementById("view-mode-horizontal");
    const btnTable = document.getElementById("view-mode-table");

    const pillsWrap = document.getElementById("active-pills-wrap");
    const pillsList = document.getElementById("active-pills-list");

    if (!searchInput || !gridView) return;

    let currentMode: "grid" | "horizontal" | "table" = "grid";
    let activeTag = "";
    let allGames: GameEntry[] = [];
    let filteredList: GameEntry[] = [];
    let renderedCount = 0;
    let tableSortCol = "rating";
    let tableSortAsc = false;

    // Fast-seed from inline window state
    const seed = (window as any).__ARCHIVEDEX_INIT_GAMES__ || [];
    if (seed.length) {
      allGames = seed.map((g: any) => ({ ...g, __search: buildSearch(g) }));
      filteredList = [...allGames];
      renderedCount = Math.min(PAGE_SIZE, filteredList.length);
    }

    function esc(s: any) {
      return String(s || "").replace(/[&<>"']/g, (c) => (
        { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c] || ""
      ));
    }

    function catSlug(cat: string) {
      return cat.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
    }

    function buildSearch(g: GameEntry) {
      return `${g.name} ${g.creator} ${g.base} ${g.runtime} ${g.status} ${g.category} ${g.length} ${g.difficulty} ${g.dex} ${g.tags.join(" ")}`.toLowerCase();
    }

    // ── Render Card HTML for Grid Mode ──
    function renderGridCard(g: GameEntry): string {
      const gradClass = `cat-grad-${catSlug(g.category)}`;

      const statusDotColor =
        g.status === "Complete" ? "bg-emerald-400 shadow-[0_0_8px_#34d399]" :
        g.status === "WIP" ? "bg-amber-400 shadow-[0_0_8px_#fbbf24]" :
        g.status === "Demo" ? "bg-cyan-400 shadow-[0_0_8px_#38bdf8]" : "bg-slate-500";

      return `
        <div
          class="hardware-card-wrap tilt-card group relative flex flex-col h-[398px] max-h-[398px] overflow-hidden rounded-2xl border border-white/[0.08] border-t-white/[0.14] bg-[#161B29] transition-all duration-300 hover:border-cyan-400/40 hover:shadow-[0_20px_50px_rgba(0,0,0,0.6)] cursor-pointer select-none"
          data-card-href="/games/${esc(g.id)}"
        >
          <!-- Stretched Primary Link: guarantees whole card clicks navigate to game page -->
          <a
            href="/games/${esc(g.id)}"
            class="card-primary-link absolute inset-0 z-[4] cursor-pointer"
            aria-label="Open ${esc(g.name)} game record"
            tabindex="-1"
          ></a>

          <div class="tilt-glare"></div>
          <div class="relative w-full h-52 shrink-0 overflow-hidden ${gradClass} quick-peek-box">
            <div class="absolute inset-0 flex flex-col justify-between p-3.5 bg-gradient-to-b from-black/25 via-transparent to-black/85 z-[1]">
              <div class="flex items-center justify-between">
                <span class="rounded-md border border-white/20 bg-black/60 px-2 py-0.5 text-[10px] font-mono-spec font-bold text-white uppercase backdrop-blur-md">
                  ${esc(g.runtime)}
                </span>
                <div class="flex items-center gap-1.5 rounded-full border border-white/10 bg-black/50 px-2.5 py-0.5 backdrop-blur-md">
                  <span class="h-2 w-2 rounded-full ${statusDotColor}"></span>
                  <span class="text-[9px] font-mono-spec font-bold text-slate-300">${esc(g.status)}</span>
                </div>
              </div>
              <div class="self-end rounded-xl border border-yellow-400/30 bg-[#090B10]/90 px-2.5 py-1 backdrop-blur-md shadow-lg">
                <span class="text-xs font-mono-spec font-black text-yellow-300">★ ${g.rating}</span>
              </div>
            </div>

            <div class="quick-peek-screenshot z-[2] bg-gradient-to-br from-slate-900 via-[#111520] to-black flex items-center justify-center p-5 text-center pointer-events-none">
              <div class="space-y-1.5">
                <span class="text-3xl opacity-40 select-none">🎮</span>
                <div class="text-[11px] font-mono-spec font-bold text-cyan-300">Quick-Peek Preview</div>
                <p class="text-[10px] text-slate-300 line-clamp-3 px-1 leading-snug">${esc(g.description)}</p>
              </div>
            </div>

            <div class="quick-actions-bar flex items-center justify-center gap-1.5 backdrop-blur-md bg-black/70 p-1.5 rounded-xl border border-white/15 relative z-[10]">
              <button type="button" class="card-action-wishlist flex-1 rounded-lg bg-white/10 py-1 text-[11px] font-bold text-slate-200 transition hover:bg-rose-500 hover:text-white pointer-events-auto" data-id="${esc(g.id)}" data-name="${esc(g.name)}">♡ Wishlist</button>
              <button type="button" class="card-action-compare flex-1 rounded-lg bg-white/10 py-1 text-[11px] font-bold text-slate-200 transition hover:bg-cyan-500 hover:text-slate-950 pointer-events-auto" data-id="${esc(g.id)}" data-name="${esc(g.name)}">⇄ Compare</button>
              <button type="button" class="card-action-completed flex-1 rounded-lg bg-white/10 py-1 text-[11px] font-bold text-slate-200 transition hover:bg-emerald-500 hover:text-white pointer-events-auto" data-id="${esc(g.id)}" data-name="${esc(g.name)}">✓ Done</button>
            </div>
          </div>

          <div class="card-text-strip flex flex-col justify-between h-[154px] shrink-0 p-4 border-t border-white/[0.04] bg-[#161B29] overflow-hidden relative z-[2]">
            <div>
              <a href="/games/${esc(g.id)}" class="text-sm font-black text-white hover:text-cyan-200 line-clamp-1 leading-snug relative z-[10]">
                ${esc(g.name)}
              </a>
              <p class="mt-0.5 text-[11px] text-slate-500 line-clamp-1">
                by <span class="text-slate-400">${esc(g.creator || "Community")}</span> · ${esc(g.category)}
              </p>
              <p class="mt-1.5 text-xs leading-relaxed text-slate-400 line-clamp-2">
                ${esc(g.description)}
              </p>
            </div>
            <div class="mt-1.5 flex items-center gap-1.5 overflow-hidden h-6 relative z-[10]">
              ${g.tags.slice(0, 3).map((t) => `<a href="/library?tag=${encodeURIComponent(t)}" class="shrink-0 rounded-full border border-white/[0.08] bg-[#111520] px-2 py-0.5 text-[10px] font-mono-spec font-bold text-slate-400 hover:border-cyan-400/40 hover:text-cyan-300 pointer-events-auto">#${esc(t)}</a>`).join("")}
            </div>
          </div>

          <div class="micro-spec-bar text-slate-400 h-9 shrink-0 relative z-[2]">
            <div class="truncate text-[10px]"><span class="text-slate-600">Base:</span> <span class="text-slate-300">${esc(g.base)}</span></div>
            <div class="flex items-center justify-center gap-1.5">
              <span class="text-[9px] text-slate-600">DIFF:</span>
              <div class="difficulty-pips">
                ${[1, 2, 3, 4, 5].map((i) => `<span class="diff-pip ${i <= g.pips ? `filled-${g.pips}` : ""}"></span>`).join("")}
              </div>
            </div>
            <div class="text-right text-[10px] font-mono-spec text-slate-300">⏱ ${esc(g.playtime)}</div>
          </div>
        </div>
      `;
    }

    // ── Render Horizontal Card HTML ──
    function renderHorizontalCard(g: GameEntry): string {
      const gradClass = `cat-grad-${catSlug(g.category)}`;
      return `
        <div
          class="hardware-card-wrap tilt-card group relative flex flex-col md:flex-row overflow-hidden rounded-2xl border border-white/[0.08] border-t-white/[0.14] bg-[#161B29] transition-all hover:border-cyan-400/40 hover:shadow-2xl cursor-pointer select-none"
          data-card-href="/games/${esc(g.id)}"
        >
          <!-- Stretched Primary Link: guarantees whole card clicks navigate to game page -->
          <a
            href="/games/${esc(g.id)}"
            class="card-primary-link absolute inset-0 z-[4] cursor-pointer"
            aria-label="Open ${esc(g.name)} game record"
            tabindex="-1"
          ></a>

          <div class="relative w-full md:w-56 shrink-0 h-44 ${gradClass} overflow-hidden p-4 flex flex-col justify-between">
            <div class="flex items-center justify-between z-10">
              <span class="rounded bg-black/60 px-2 py-0.5 text-[10px] font-mono-spec font-bold text-white uppercase backdrop-blur-md">${esc(g.runtime)}</span>
              <span class="rounded-xl border border-yellow-400/30 bg-[#090B10]/90 px-2 py-0.5 text-xs font-mono-spec font-black text-yellow-300">★ ${g.rating}</span>
            </div>
            <div class="z-10">
              <span class="rounded bg-black/60 px-2 py-0.5 text-[9px] font-mono-spec text-slate-300">${esc(g.status)}</span>
            </div>
          </div>

          <div class="flex flex-1 flex-col justify-between p-5 relative z-[2]">
            <div>
              <div class="flex items-start justify-between gap-4">
                <div>
                  <a href="/games/${esc(g.id)}" class="text-lg font-black text-white hover:text-cyan-200 relative z-[10]">${esc(g.name)}</a>
                  <p class="text-xs text-slate-500">by <span class="font-bold text-slate-400">${esc(g.creator || "Community")}</span> · Base: <span class="text-cyan-300">${esc(g.base)}</span> · ${esc(g.category)}</p>
                </div>
                <div class="flex items-center gap-1 shrink-0 relative z-[10]">
                  <button class="card-action-wishlist rounded-lg border border-white/[0.08] bg-[#111520] p-2 text-xs text-slate-400 hover:border-rose-400/50 hover:text-rose-300 pointer-events-auto" data-id="${esc(g.id)}" data-name="${esc(g.name)}" title="Wishlist">♡</button>
                  <button class="card-action-compare rounded-lg border border-white/[0.08] bg-[#111520] p-2 text-xs text-slate-400 hover:border-cyan-400/50 hover:text-cyan-300 pointer-events-auto" data-id="${esc(g.id)}" data-name="${esc(g.name)}" title="Compare">⇄</button>
                </div>
              </div>
              <p class="mt-3 text-xs leading-relaxed text-slate-300">${esc(g.description)}</p>
              <div class="mt-4 flex flex-wrap gap-1.5 relative z-[10]">
                ${g.tags.map((t) => `<a href="/library?tag=${encodeURIComponent(t)}" class="rounded-full border border-white/[0.08] bg-[#111520] px-2.5 py-0.5 text-[10px] font-mono-spec font-bold text-slate-400 hover:border-cyan-400/40 hover:text-cyan-300 pointer-events-auto">#${esc(t)}</a>`).join("")}
              </div>
            </div>

            <div class="mt-4 flex items-center justify-between border-t border-white/[0.08] pt-3 text-[11px] font-mono-spec text-slate-400">
              <div>Base: <span class="text-slate-200">${esc(g.base)}</span></div>
              <div class="flex items-center gap-1.5">
                <span>Diff (${g.pips}/5):</span>
                <div class="difficulty-pips">
                  ${[1, 2, 3, 4, 5].map((i) => `<span class="diff-pip ${i <= g.pips ? `filled-${g.pips}` : ""}"></span>`).join("")}
                </div>
              </div>
              <div>⏱ ${esc(g.playtime)}</div>
            </div>
          </div>
        </div>
      `;
    }

    // ── Render Table Row HTML ──
    function renderTableRow(g: GameEntry): string {
      return `
        <tr class="hover:bg-[#1E2538] transition">
          <td class="px-4 py-3 font-bold">
            <a href="/games/${esc(g.id)}" class="text-white hover:text-cyan-300 block truncate max-w-[200px]">${esc(g.name)}</a>
          </td>
          <td class="px-3 py-3"><span class="rounded bg-black/40 px-1.5 py-0.5 text-[10px] text-cyan-300">${esc(g.runtime)}</span></td>
          <td class="px-3 py-3 text-slate-400">${esc(g.base)}</td>
          <td class="px-3 py-3 font-bold text-yellow-300">★ ${g.rating}</td>
          <td class="px-3 py-3"><span class="text-[10px] ${g.status === "Complete" ? "text-emerald-400" : "text-amber-400"}">${esc(g.status)}</span></td>
          <td class="px-3 py-3">
            <div class="difficulty-pips">
              ${[1, 2, 3, 4, 5].map((i) => `<span class="diff-pip ${i <= g.pips ? `filled-${g.pips}` : ""}"></span>`).join("")}
            </div>
          </td>
          <td class="px-3 py-3 text-slate-400">${esc(g.playtime)}</td>
          <td class="px-3 py-3 text-slate-500 truncate max-w-[120px]">${esc(g.creator || "Community")}</td>
          <td class="px-4 py-3 text-right">
            <div class="flex items-center justify-end gap-1.5">
              <button class="card-action-wishlist rounded border border-white/[0.08] px-2 py-0.5 text-[11px] text-slate-400 hover:text-rose-300" data-id="${esc(g.id)}" data-name="${esc(g.name)}">♡</button>
              <button class="card-action-compare rounded border border-white/[0.08] px-2 py-0.5 text-[11px] text-slate-400 hover:text-cyan-300" data-id="${esc(g.id)}" data-name="${esc(g.name)}">⇄</button>
              <a href="/games/${esc(g.id)}" class="rounded bg-white/10 px-2 py-0.5 text-[10px] text-slate-200 hover:bg-cyan-400 hover:text-black">View</a>
            </div>
          </td>
        </tr>
      `;
    }

    function applyFilterAndSort() {
      const q = searchInput.value.toLowerCase().trim();
      const platform = platformSelect.value;
      const status = statusSelect.value;
      const category = categorySelect.value;
      const difficulty = difficultySelect.value;
      const length = lengthSelect.value;
      const sort = sortSelect.value;

      filteredList = allGames.filter((g) => {
        if (q && !g.__search?.includes(q)) return false;
        if (platform && g.runtime !== platform) return false;
        if (status && g.status !== status) return false;
        if (category && g.category !== category) return false;
        if (difficulty && g.pips !== parseInt(difficulty, 10)) return false;
        if (length && !g.length.includes(length)) return false;
        if (activeTag && !g.tags.includes(activeTag)) return false;
        return true;
      });

      filteredList.sort((a, b) => {
        if (sort === "rating-desc") return b.rating - a.rating;
        if (sort === "rating-asc") return a.rating - b.rating;
        if (sort === "name-asc") return a.name.localeCompare(b.name);
        if (sort === "name-desc") return b.name.localeCompare(a.name);
        if (sort === "difficulty-desc") return b.pips - a.pips;
        return 0;
      });

      resultCountEl.textContent = String(filteredList.length);
      emptyState?.classList.toggle("hidden", filteredList.length > 0);

      renderedCount = Math.min(PAGE_SIZE, filteredList.length);
      renderCurrentView();
      updatePills();
      updateLoadMore();
      rebindActions();
    }

    function renderCurrentView() {
      const slice = filteredList.slice(0, renderedCount);

      if (currentMode === "grid") {
        gridView?.classList.remove("hidden");
        horizontalView?.classList.add("hidden");
        tableView?.classList.add("hidden");
        if (gridView) gridView.innerHTML = slice.map(renderGridCard).join("");
      } else if (currentMode === "horizontal") {
        gridView?.classList.add("hidden");
        horizontalView?.classList.remove("hidden");
        tableView?.classList.add("hidden");
        if (horizontalView) horizontalView.innerHTML = slice.map(renderHorizontalCard).join("");
      } else if (currentMode === "table") {
        gridView?.classList.add("hidden");
        horizontalView?.classList.add("hidden");
        tableView?.classList.remove("hidden");
        if (tableBody) tableBody.innerHTML = slice.map(renderTableRow).join("");
      }
    }

    function loadMore() {
      const nextSlice = filteredList.slice(renderedCount, renderedCount + PAGE_SIZE);
      if (!nextSlice.length) return;

      if (currentMode === "grid" && gridView) {
        gridView.insertAdjacentHTML("beforeend", nextSlice.map(renderGridCard).join(""));
      } else if (currentMode === "horizontal" && horizontalView) {
        horizontalView.insertAdjacentHTML("beforeend", nextSlice.map(renderHorizontalCard).join(""));
      } else if (currentMode === "table" && tableBody) {
        tableBody.insertAdjacentHTML("beforeend", nextSlice.map(renderTableRow).join(""));
      }

      renderedCount += nextSlice.length;
      updateLoadMore();
      rebindActions();
    }

    function updateLoadMore() {
      const remaining = filteredList.length - renderedCount;
      if (remaining > 0) {
        loadMoreBtn.classList.remove("hidden");
        loadMoreBtn.textContent = `Load More Games (${remaining} remaining)`;
      } else {
        loadMoreBtn.classList.add("hidden");
      }
    }

    function updatePills() {
      const pills: { label: string; onRemove: () => void }[] = [];
      if (searchInput.value) {
        pills.push({ label: `Search: "${searchInput.value}"`, onRemove: () => { searchInput.value = ""; applyFilterAndSort(); } });
      }
      if (platformSelect.value) {
        pills.push({ label: `Platform: ${platformSelect.value}`, onRemove: () => { platformSelect.value = ""; applyFilterAndSort(); } });
      }
      if (statusSelect.value) {
        pills.push({ label: `Status: ${statusSelect.value}`, onRemove: () => { statusSelect.value = ""; applyFilterAndSort(); } });
      }
      if (categorySelect.value) {
        pills.push({ label: `Category: ${categorySelect.value}`, onRemove: () => { categorySelect.value = ""; applyFilterAndSort(); } });
      }
      if (difficultySelect.value) {
        pills.push({ label: `Difficulty: ${difficultySelect.value} pips`, onRemove: () => { difficultySelect.value = ""; applyFilterAndSort(); } });
      }
      if (lengthSelect.value) {
        pills.push({ label: `Length: ${lengthSelect.value}`, onRemove: () => { lengthSelect.value = ""; applyFilterAndSort(); } });
      }
      if (activeTag) {
        pills.push({ label: `Tag: #${activeTag}`, onRemove: () => { activeTag = ""; applyFilterAndSort(); } });
      }

      if (!pills.length) {
        pillsWrap?.classList.add("hidden");
        return;
      }

      pillsWrap?.classList.remove("hidden");
      if (pillsList) {
        pillsList.innerHTML = pills.map((p, i) => `
          <button class="active-filter-chip flex items-center gap-1.5 rounded-full border border-cyan-400/40 bg-cyan-500/10 px-2.5 py-1 text-[11px] font-mono-spec font-bold text-cyan-200 transition hover:border-red-400 hover:text-red-300" data-idx="${i}">
            <span>${p.label}</span>
            <span>✕</span>
          </button>
        `).join("");

        pillsList.querySelectorAll<HTMLButtonElement>(".active-filter-chip").forEach((btn) => {
          btn.addEventListener("click", () => {
            const idx = parseInt(btn.dataset.idx || "0", 10);
            pills[idx]?.onRemove();
          });
        });
      }
    }

    function rebindActions() {
      document.querySelectorAll<HTMLButtonElement>(".card-action-wishlist:not([data-lib-bound])").forEach((b) => {
        b.setAttribute("data-lib-bound", "1");
        b.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          (window as any).toggleWishlist?.(b.dataset.id, b.dataset.name);
        });
      });

      document.querySelectorAll<HTMLButtonElement>(".card-action-compare:not([data-lib-bound])").forEach((b) => {
        b.setAttribute("data-lib-bound", "1");
        b.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          (window as any).toggleCompareItem?.(b.dataset.id, b.dataset.name);
        });
      });

      document.querySelectorAll<HTMLButtonElement>(".card-action-completed:not([data-lib-bound])").forEach((b) => {
        b.setAttribute("data-lib-bound", "1");
        b.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          (window as any).toggleCompleted?.(b.dataset.id, b.dataset.name);
        });
      });
    }

    // View mode handlers
    function switchMode(mode: "grid" | "horizontal" | "table") {
      currentMode = mode;
      btnGrid?.classList.toggle("active-view", mode === "grid");
      btnHorizontal?.classList.toggle("active-view", mode === "horizontal");
      btnTable?.classList.toggle("active-view", mode === "table");
      renderCurrentView();
      rebindActions();
    }

    btnGrid?.addEventListener("click", () => switchMode("grid"));
    btnHorizontal?.addEventListener("click", () => switchMode("horizontal"));
    btnTable?.addEventListener("click", () => switchMode("table"));

    // Event listeners for filters
    let searchTimer: any;
    searchInput?.addEventListener("input", () => {
      clearTimeout(searchTimer);
      searchTimer = setTimeout(applyFilterAndSort, 150);
    });

    [platformSelect, statusSelect, categorySelect, difficultySelect, lengthSelect, sortSelect].forEach((el) => {
      el?.addEventListener("change", applyFilterAndSort);
    });

    function resetFilters() {
      searchInput.value = "";
      platformSelect.value = "";
      statusSelect.value = "";
      categorySelect.value = "";
      difficultySelect.value = "";
      lengthSelect.value = "";
      sortSelect.value = "rating-desc";
      activeTag = "";
      applyFilterAndSort();
      (window as any).showToast?.("Filters reset", "info");
    }

    resetBtn?.addEventListener("click", resetFilters);
    clearEmptyBtn?.addEventListener("click", resetFilters);

    // Tag cloud buttons
    document.querySelectorAll<HTMLButtonElement>(".cloud-tag-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const tag = btn.dataset.filterTag || "";
        activeTag = activeTag === tag ? "" : tag;
        applyFilterAndSort();
      });
    });

    loadMoreBtn?.addEventListener("click", loadMore);

    // Card Theme Selector in Library toolbar
    const libCardBtn = document.getElementById("lib-card-theme-btn");
    const libCardMenu = document.getElementById("lib-card-theme-menu");
    const libCardLabel = document.getElementById("lib-card-theme-label");
    const libCardIcon = document.getElementById("lib-card-theme-icon");

    const cardThemeLabels: Record<string, { label: string; icon: string }> = {
      holo: { label: "Holo Neo", icon: "✦" },
      retro: { label: "Retro Cartridge", icon: "🕹️" },
      monolith: { label: "Monolith Obsidian", icon: "⬛" },
    };

    function updateLibCardThemeUI(theme: string) {
      const info = cardThemeLabels[theme] || cardThemeLabels.holo;
      if (libCardLabel) libCardLabel.textContent = info.label;
      if (libCardIcon) libCardIcon.textContent = info.icon;
    }

    const currentCardTheme = localStorage.getItem("archivedex_card_theme") || "holo";
    updateLibCardThemeUI(currentCardTheme);

    libCardBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      libCardMenu?.classList.toggle("hidden");
    });

    document.querySelectorAll<HTMLButtonElement>(".lib-card-theme-opt").forEach((btn) => {
      btn.addEventListener("click", () => {
        const theme = btn.dataset.libCardTheme || "holo";
        document.documentElement.setAttribute("data-card-theme", theme);
        document.body.setAttribute("data-card-theme", theme);
        localStorage.setItem("archivedex_card_theme", theme);
        updateLibCardThemeUI(theme);
        libCardMenu?.classList.add("hidden");
        (window as any).showToast?.(`Card style: ${cardThemeLabels[theme]?.label || theme}`, "info");
      });
    });

    document.addEventListener("click", () => {
      libCardMenu?.classList.add("hidden");
    });

    window.addEventListener("archivedex:card-theme-change", ((e: CustomEvent) => {
      if (e.detail?.theme) updateLibCardThemeUI(e.detail.theme);
    }) as EventListener);

    const mainScroll = document.getElementById("main-scroll-container");
    const observer = new IntersectionObserver((entries) => {
      if (entries[0]?.isIntersecting && !loadMoreBtn.classList.contains("hidden")) {
        loadMore();
      }
    }, { 
      root: mainScroll || null,
      rootMargin: "500px" 
    });
    if (sentinel) observer.observe(sentinel);

    // Read URL query parameters
    const params = new URLSearchParams(window.location.search);
    if (params.get("category")) categorySelect.value = params.get("category")!;
    if (params.get("q")) searchInput.value = params.get("q")!;
    if (params.get("tag")) activeTag = params.get("tag")!;
    if (params.get("platform")) platformSelect.value = params.get("platform")!;

    // Fetch full dataset
    fetch("/data/games.json")
      .then((r) => r.json())
      .then((data: GameEntry[]) => {
        allGames = data.map((g) => ({ ...g, __search: buildSearch(g) }));
        applyFilterAndSort();
      })
      .catch((err) => {
        console.error("ArchiveDex: Failed to load games database", err);
      });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initLibrary);
  } else {
    initLibrary();
  }
  document.addEventListener("astro:page-load", initLibrary);
</script>

<script is:inline define:vars={{ initJSON: JSON.stringify(initialGames.map(g => ({
  id: g.id,
  name: g.name,
  runtime: g.runtime,
  base: g.base,
  rating: g.rating,
  status: g.status,
  category: g.category,
  length: g.length,
  difficulty: g.difficulty,
  pips: (g as any).pips ?? 3,
  playtime: (g as any).playtime ?? "30-45h",
  description: g.description,
  creator: g.creator,
  tags: g.tags,
  mood: g.mood
}))) }}>
  window.__ARCHIVEDEX_INIT_GAMES__ = JSON.parse(initJSON);
</script>
