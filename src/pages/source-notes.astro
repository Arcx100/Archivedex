---
import BaseLayout from "../layouts/BaseLayout.astro";

const labels = [
  {
    label: "Safe Patch Source",
    meaning: "Official patch or creator thread found. The preferred source tier for ROM hacks. Patch is applied to a clean ROM you supply.",
    icon: "✦",
    color: "border-emerald-400/30 bg-emerald-400/6",
    accent: "text-emerald-300",
    badge: "bg-emerald-400/15 border-emerald-400/30 text-emerald-300",
    tier: "Recommended",
  },
  {
    label: "Official EXE, Scan Needed",
    meaning: "The developer distributes an official executable build. Legitimate source, but treat any EXE like software — scan before running, especially on Windows.",
    icon: "◈",
    color: "border-cyan-400/20 bg-cyan-400/5",
    accent: "text-cyan-300",
    badge: "bg-cyan-400/10 border-cyan-400/30 text-cyan-300",
    tier: "Recommended",
  },
  {
    label: "Sandbox First",
    meaning: "Source exists but warrants extra caution. Run in an isolated environment (VM, sandbox, separate user) before trusting fully.",
    icon: "◇",
    color: "border-yellow-400/20 bg-yellow-400/5",
    accent: "text-yellow-300",
    badge: "bg-yellow-400/10 border-yellow-400/30 text-yellow-300",
    tier: "Caution",
  },
  {
    label: "Watchlist Only",
    meaning: "Interesting entry, but the project is incomplete, uncertain, or not ready for active recommendation. Tracked for future inclusion.",
    icon: "◉",
    color: "border-slate-600/40 bg-slate-800/40",
    accent: "text-slate-300",
    badge: "bg-slate-700/50 border-slate-600 text-slate-400",
    tier: "Hold",
  },
  {
    label: "Historical Only",
    meaning: "Preserved for archive and research value. Not necessarily recommended for casual play — may have rough edges, outdated mechanics, or compatibility issues.",
    icon: "⬡",
    color: "border-violet-400/20 bg-violet-400/5",
    accent: "text-violet-300",
    badge: "bg-violet-400/10 border-violet-400/30 text-violet-300",
    tier: "Archive",
  },
  {
    label: "Mirror Only, Hold",
    meaning: "No clean official source has been located yet. The entry exists in the archive for tracking purposes but is not actively promoted until a proper source is found.",
    icon: "⊘",
    color: "border-orange-400/20 bg-orange-400/5",
    accent: "text-orange-300",
    badge: "bg-orange-400/10 border-orange-400/30 text-orange-300",
    tier: "Hold",
  },
  {
    label: "Prepatched Only, Reject",
    meaning: "Only prepatched ROMs circulate, with no clean patch available. Avoid recommending unless a proper patch or official source emerges.",
    icon: "✕",
    color: "border-red-400/20 bg-red-400/5",
    accent: "text-red-300",
    badge: "bg-red-400/10 border-red-400/30 text-red-300",
    tier: "Reject",
  },
  {
    label: "Unsafe / Skip",
    meaning: "Do not recommend or link. Known bad actors, malware reports, or fundamentally untrustworthy distribution. Logged only to avoid re-researching.",
    icon: "⛔",
    color: "border-red-500/30 bg-red-500/8",
    accent: "text-red-400",
    badge: "bg-red-500/15 border-red-500/30 text-red-400",
    tier: "Skip",
  },
];

const philosophy = [
  {
    icon: "🔗",
    title: "Link, don't host",
    body: "ArchiveDex directs users to official creator pages, PokéCommunity threads, and developer sites. We do not host ROMs, prepatched files, or arbitrary mirrors.",
  },
  {
    icon: "🛡️",
    title: "Patch over prepatched",
    body: "For ROM hacks, a clean patch applied to a legally-obtained ROM is always preferred over a prepatched binary of unknown origin.",
  },
  {
    icon: "🔬",
    title: "Scan EXEs",
    body: "Fan-made executables are legitimate software, but they are unsigned and come from independent developers. Run a virus scan before executing on your main system.",
  },
  {
    icon: "📦",
    title: "Preserve first, promote second",
    body: "Entries can be in the archive without being actively recommended. Watchlist and Historical entries exist for completeness, not as endorsements.",
  },
];

const tiers = [
  { name: "Recommended", labels: ["Safe Patch Source", "Official EXE, Scan Needed"], color: "text-emerald-300", dot: "bg-emerald-400" },
  { name: "Caution", labels: ["Sandbox First"], color: "text-yellow-300", dot: "bg-yellow-400" },
  { name: "Hold", labels: ["Watchlist Only", "Mirror Only, Hold"], color: "text-slate-300", dot: "bg-slate-500" },
  { name: "Archive", labels: ["Historical Only"], color: "text-violet-300", dot: "bg-violet-400" },
  { name: "Reject / Skip", labels: ["Prepatched Only, Reject", "Unsafe / Skip"], color: "text-red-300", dot: "bg-red-500" },
];
---

<BaseLayout title="Source Notes · ArchiveDex">
  <main class="mx-auto max-w-5xl px-6 py-12">

    <!-- Header -->
    <header class="mb-12" data-reveal>
      <p class="text-sm font-black uppercase tracking-[0.3em] text-cyan-300">Transparency</p>
      <h1 class="mt-3 text-5xl font-black text-white">Source Notes</h1>
      <p class="mt-4 max-w-3xl text-lg leading-7 text-slate-400">
        Every entry in ArchiveDex carries a source trust label. Here's what each label means, how we decide, and what our archive policy actually is.
      </p>
    </header>

    <!-- Archive rule — hero panel -->
    <section class="glass-panel relative mb-10 overflow-hidden rounded-[2rem] p-8" data-reveal>
      <div class="pointer-events-none absolute inset-0 theme-hero-glow-1"></div>
      <div class="pointer-events-none absolute inset-0 theme-hero-glow-2"></div>
      <div class="relative">
        <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-cyan-400/30 bg-cyan-400/10 px-3 py-1 text-xs font-black uppercase tracking-widest text-cyan-300">
          📋 Core archive rule
        </div>
        <h2 class="text-2xl font-black text-white">Document. Link. Don't host.</h2>
        <p class="mt-4 max-w-3xl leading-7 text-slate-300">
          ArchiveDex is a discovery and cataloguing tool, not a distribution platform. Our job is to document games thoroughly and point users toward official creator pages wherever possible. We do not host copyrighted ROMs, randomly prepatched files, or executable mirrors of unknown provenance.
        </p>
        <p class="mt-4 max-w-3xl leading-7 text-slate-400">
          Source trust is metadata that supports good decisions — it should inform discovery, not gate it entirely. Even entries with lower trust levels have archival value for the project's history.
        </p>
      </div>
    </section>

    <!-- Trust tier quick reference -->
    <section class="mb-10 rounded-3xl border border-slate-700 bg-slate-950/70 p-6" data-reveal>
      <p class="mb-4 text-xs font-black uppercase tracking-[0.3em] text-slate-500">Trust tier overview</p>
      <div class="flex flex-wrap gap-3">
        {tiers.map((tier) => (
          <div class="stat-card flex items-center gap-2 rounded-2xl border border-slate-700 bg-slate-900/60 px-4 py-2.5">
            <div class={`h-2 w-2 shrink-0 rounded-full ${tier.dot}`}></div>
            <span class={`text-sm font-black ${tier.color}`}>{tier.name}</span>
            <span class="text-xs text-slate-600">·</span>
            <span class="text-xs text-slate-500">{tier.labels.join(", ")}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Label grid -->
    <section class="mb-10">
      <p class="mb-5 text-xs font-black uppercase tracking-[0.3em] text-slate-500" data-reveal>All source labels</p>
      <div class="grid gap-4">
        {labels.map((item) => (
          <div class={`group rounded-3xl border p-5 transition hover:-translate-y-0.5 ${item.color}`} data-reveal="left">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div class="flex items-center gap-3">
                <div class={`grid h-10 w-10 shrink-0 place-items-center rounded-2xl border border-white/10 bg-black/20 text-lg ${item.accent}`}>
                  {item.icon}
                </div>
                <span class={`text-base font-black ${item.accent}`}>{item.label}</span>
              </div>
              <span class={`rounded-full border px-3 py-1 text-[11px] font-black uppercase tracking-wider ${item.badge}`}>
                {item.tier}
              </span>
            </div>
            <p class="mt-3 pl-13 text-sm leading-6 text-slate-400 lg:pl-[3.25rem]">{item.meaning}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Philosophy grid -->
    <section class="mb-12">
      <p class="mb-5 text-xs font-black uppercase tracking-[0.3em] text-slate-500" data-reveal>Sourcing philosophy</p>
      <div class="grid gap-4 sm:grid-cols-2">
        {philosophy.map((item) => (
          <div class="tilt-card group relative rounded-3xl border border-slate-700 bg-slate-950/70 p-6" data-reveal="scale">
            <div class="tilt-glare"></div>
            <div class="mb-3 text-2xl">{item.icon}</div>
            <h3 class="font-black text-white">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-400">{item.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Rating methodology note -->
    <section class="rounded-[2rem] border border-violet-400/20 bg-violet-400/5 p-7" data-reveal>
      <div class="mb-3 flex items-center gap-3">
        <div class="grid h-10 w-10 place-items-center rounded-2xl border border-violet-400/30 bg-violet-400/10 text-lg text-violet-300">⭐</div>
        <h2 class="text-xl font-black text-white">About archive ratings</h2>
      </div>
      <p class="max-w-3xl text-sm leading-7 text-slate-300">
        Ratings in ArchiveDex are curated archive scores, not crowdsourced popularity metrics. They reflect a combination of
        <span class="font-bold text-violet-200">preservation importance</span>,
        <span class="font-bold text-cyan-200">overall quality and polish</span>,
        <span class="font-bold text-yellow-200">uniqueness of contribution</span>, and
        <span class="font-bold text-emerald-200">playability today</span>.
        A 9.2 and a 9.8 are both exceptional — the difference is a matter of degree, not kind. Entries rated below 8.0 are typically Watchlist or Historical tier.
      </p>
    </section>

    <div class="h-10"></div>
  </main>
</BaseLayout>
