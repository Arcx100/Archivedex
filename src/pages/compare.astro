---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Compare Games · ArchiveDex" description="Compare Pokémon fan games and ROM hacks side-by-side across mechanics, ratings, difficulty, and playtime.">
  <main class="mx-auto max-w-[1500px] px-6 py-10">

    <div class="mb-4">
      <a href="/library" class="text-xs font-mono-spec font-bold text-cyan-400 hover:underline">← Back to Library</a>
    </div>

    <!-- Header -->
    <header class="mb-8" data-reveal>
      <div class="flex items-center gap-2">
        <span class="rounded-md border border-cyan-400/30 bg-cyan-500/10 px-2.5 py-0.5 text-[10px] font-mono-spec font-black uppercase tracking-widest text-cyan-300">
          Metrology Matrix
        </span>
        <span class="text-xs font-mono-spec text-slate-500">Up to 4 Projects Side-by-Side</span>
      </div>
      <h1 class="mt-2 text-4xl sm:text-5xl font-black text-white">Compare Projects</h1>
      <p class="mt-2 text-xs text-slate-400 max-w-2xl font-mono-spec">
        Select up to 4 Pokémon games to analyze mechanics, difficulty pips, clean base ROMs, and unique features side by side.
      </p>
    </header>

    <!-- Project Picker Card -->
    <section class="glass-panel mb-8 rounded-2xl p-5" data-reveal style="--reveal-delay:50ms">
      <div class="relative">
        <label class="block text-xs font-mono-spec font-bold uppercase tracking-wider text-slate-400 mb-2">
          Search & Add Game to Comparison (Max 4):
        </label>
        <div class="relative">
          <span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-slate-500">🔍</span>
          <input
            id="compare-search-input"
            type="text"
            placeholder="Type project name to add (e.g. Unbound, Emerald Rogue, Seaglass, Prism)…"
            class="w-full rounded-xl border border-white/[0.08] bg-[#111520] py-2.5 pl-10 pr-4 text-xs font-medium text-white placeholder-slate-500 outline-none transition focus:border-cyan-400 focus:shadow-[0_0_15px_rgba(34,211,238,0.2)]"
          />
          <div id="compare-search-dropdown" class="absolute left-0 right-0 top-full mt-2 hidden z-50 rounded-xl border border-white/[0.12] bg-[#161B29] p-2 shadow-2xl space-y-1 max-h-60 overflow-y-auto">
          </div>
        </div>

        <!-- Selected Game Chips -->
        <div id="compare-chips-row" class="mt-4 flex flex-wrap gap-2"></div>
      </div>
    </section>

    <!-- Empty State -->
    <div id="compare-empty" class="rounded-3xl border border-white/[0.08] bg-[#161B29] p-16 text-center">
      <div class="text-5xl opacity-30 mb-3">⇄</div>
      <h3 class="text-xl font-black text-white">No games added to comparison yet</h3>
      <p class="mt-1 text-xs text-slate-400 font-mono-spec">Search above or click the ⇄ button on any game card in the Library.</p>
      <a href="/library" class="mt-4 inline-block rounded-xl bg-cyan-400 px-5 py-2 text-xs font-black text-slate-950 hover:bg-cyan-300">
        Browse Library →
      </a>
    </div>

    <!-- Comparison Table Output Area -->
    <div id="compare-table-container" class="hidden space-y-6">
      <!-- Built dynamically via client JavaScript -->
    </div>

  </main>
</BaseLayout>

<script>
  type LibGame = {
    id: string;
    name: string;
    runtime: string;
    base: string;
    rating: number;
    status: string;
    category: string;
    length: string;
    difficulty: string;
    pips: number;
    playtime: string;
    description: string;
    creator: string;
    tags: string[];
    mood: string[];
    stats?: {
      difficulty: number;
      exploration: number;
      grinding: number;
      qol: number;
      balance: number;
      music: number;
    };
  };

  async function initCompare() {
    const input = document.getElementById("compare-search-input") as HTMLInputElement;
    const dropdown = document.getElementById("compare-search-dropdown");
    const chipsRow = document.getElementById("compare-chips-row");
    const emptyState = document.getElementById("compare-empty");
    const tableContainer = document.getElementById("compare-table-container");

    if (!input || !tableContainer) return;

    let allGames: LibGame[] = [];
    try {
      allGames = await fetch("/data/games.json").then((r) => r.json());
    } catch {
      allGames = [];
    }

    let selectedGames: LibGame[] = [];

    // Parse URL parameter ?games=id1,id2 or ?ids=id1,id2 or fallback to localStorage tray
    const urlParams = new URLSearchParams(window.location.search);
    const paramIds = (urlParams.get("games") || urlParams.get("ids") || "").split(",").filter(Boolean).slice(0, 4);
    
    let initialIds = paramIds;
    if (!initialIds.length) {
      try {
        const tray = JSON.parse(localStorage.getItem("archivedex_compare_tray") || "[]");
        if (Array.isArray(tray)) {
          initialIds = tray.map((item: any) => item.id).filter(Boolean).slice(0, 4);
        }
      } catch (e) {}
    }

    if (initialIds.length) {
      selectedGames = initialIds
        .map((id) => allGames.find((g) => g.id === id))
        .filter((g): g is LibGame => Boolean(g));
    }

    function syncURL() {
      const url = new URL(window.location.href);
      if (selectedGames.length) {
        url.searchParams.set("games", selectedGames.map((g) => g.id).join(","));
      } else {
        url.searchParams.delete("games");
      }
      history.replaceState({}, "", url.toString());

      // Sync with tray dock
      localStorage.setItem("archivedex_compare_tray", JSON.stringify(selectedGames.map(g => ({ id: g.id, name: g.name }))));
    }

    function renderChips() {
      if (!chipsRow) return;
      chipsRow.innerHTML = selectedGames.map((g) => `
        <div class="flex items-center gap-2 rounded-xl border border-cyan-400/40 bg-cyan-500/10 px-3 py-1.5 text-xs font-mono-spec font-bold text-cyan-200">
          <span>${g.name}</span>
          <span class="text-yellow-300">★ ${g.rating}</span>
          <button class="remove-chip ml-1 text-slate-400 hover:text-red-400 font-black" data-id="${g.id}">✕</button>
        </div>
      `).join("");

      chipsRow.querySelectorAll<HTMLButtonElement>(".remove-chip").forEach((btn) => {
        btn.addEventListener("click", () => {
          selectedGames = selectedGames.filter((g) => g.id !== btn.dataset.id);
          syncURL();
          render();
        });
      });
    }

    function buildStackedRadarHTML(games: LibGame[]) {
      if (!games.length) return "";

      const CX = 170;
      const CY = 170;
      const RADAR_R = 105;

      const METRICS = [
        { key: "difficulty", label: "Difficulty", avg: 51, angle: -90 },
        { key: "exploration", label: "Exploration", avg: 53, angle: -30 },
        { key: "grinding", label: "Grinding", avg: 53, angle: 30 },
        { key: "qol", label: "QoL Features", avg: 54, angle: 90 },
        { key: "balance", label: "Game Balance", avg: 54, angle: 150 },
        { key: "music", label: "OST & Audio", avg: 52, angle: 210 },
      ];

      function getPoint(val: number, angleDeg: number, maxRadius = RADAR_R) {
        const rad = (angleDeg * Math.PI) / 180;
        const dist = (val / 100) * maxRadius;
        return {
          x: Math.round((CX + dist * Math.cos(rad)) * 10) / 10,
          y: Math.round((CY + dist * Math.sin(rad)) * 10) / 10,
        };
      }

      // Concentric level outlines (25%, 50%, 75%, 100%)
      const rings = [25, 50, 75, 100].map((lvl, i) => {
        const pts = METRICS.map((m) => {
          const pt = getPoint(lvl, m.angle);
          return `${pt.x},${pt.y}`;
        }).join(" ");
        return `<polygon points="${pts}" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="${i === 3 ? "1.5" : "1"}" stroke-dasharray="${i < 3 ? "3 3" : "none"}" />`;
      }).join("");

      // Spoke axis lines
      const spokes = METRICS.map((m) => {
        const outer = getPoint(100, m.angle);
        return `<line x1="${CX}" y1="${CY}" x2="${outer.x}" y2="${outer.y}" stroke="rgba(255,255,255,0.12)" stroke-width="1" />`;
      }).join("");

      // Outer labels
      const labels = METRICS.map((m) => {
        const lp = getPoint(122, m.angle);
        return `<text x="${lp.x}" y="${lp.y + 4}" text-anchor="middle" font-size="9.5" font-family="JetBrains Mono, monospace" font-weight="bold" fill="#94a3b8">${m.label}</text>`;
      }).join("");

      // Faint Archive Average Benchmark Hexagon (Medium Hexagon ~53%)
      const avgPts = METRICS.map((m) => {
        const pt = getPoint(m.avg, m.angle);
        return `${pt.x},${pt.y}`;
      }).join(" ");
      const avgPolygon = `<polygon points="${avgPts}" fill="rgba(148, 163, 184, 0.12)" stroke="rgba(148, 163, 184, 0.45)" stroke-width="1.5" stroke-dasharray="4 3" />`;

      // Distinct theme palettes for up to 4 stacked games
      const PALETTES = [
        { stroke: "#22d3ee", fill: "rgba(34, 211, 238, 0.22)", glow: "rgba(34, 211, 238, 0.45)", text: "text-cyan-300", bg: "bg-cyan-500/10", border: "border-cyan-400/40" },
        { stroke: "#c084fc", fill: "rgba(192, 132, 252, 0.20)", glow: "rgba(192, 132, 252, 0.45)", text: "text-purple-300", bg: "bg-purple-500/10", border: "border-purple-400/40" },
        { stroke: "#34d399", fill: "rgba(52, 211, 153, 0.20)", glow: "rgba(52, 211, 153, 0.45)", text: "text-emerald-300", bg: "bg-emerald-500/10", border: "border-emerald-400/40" },
        { stroke: "#fbbf24", fill: "rgba(251, 191, 36, 0.20)", glow: "rgba(251, 191, 36, 0.45)", text: "text-amber-300", bg: "bg-amber-500/10", border: "border-amber-400/40" },
      ];

      // Stacked series polygons & vertices
      const stackedSeries = games.map((g, idx) => {
        const pal = PALETTES[idx % PALETTES.length];
        const s = g.stats || { difficulty: 50, exploration: 50, grinding: 50, qol: 50, balance: 50, music: 50 };
        const pts = METRICS.map((m) => {
          const val = (s as any)[m.key] ?? 50;
          const pt = getPoint(val, m.angle);
          return `${pt.x},${pt.y}`;
        }).join(" ");

        const dots = METRICS.map((m) => {
          const val = (s as any)[m.key] ?? 50;
          const pt = getPoint(val, m.angle);
          return `<circle cx="${pt.x}" cy="${pt.y}" r="3.5" fill="${pal.stroke}" stroke="#090B10" stroke-width="1.5" />`;
        }).join("");

        return `
          <g class="stacked-game-series" data-game="${g.id}">
            <polygon points="${pts}" fill="${pal.fill}" stroke="${pal.stroke}" stroke-width="2.5" style="filter: drop-shadow(0 0 8px ${pal.glow});" />
            ${dots}
          </g>
        `;
      }).join("");

      // Legend breakdown cards for the compared games
      const legendCards = games.map((g, idx) => {
        const pal = PALETTES[idx % PALETTES.length];
        const s = g.stats || { difficulty: 50, exploration: 50, grinding: 50, qol: 50, balance: 50, music: 50 };
        return `
          <div class="rounded-2xl border ${pal.border} ${pal.bg} p-3.5 space-y-2.5 backdrop-blur-md">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2 min-w-0">
                <span class="h-3 w-3 rounded-full shrink-0" style="background-color: ${pal.stroke}; box-shadow: 0 0 8px ${pal.stroke};"></span>
                <span class="font-bold text-white text-xs truncate">${g.name}</span>
              </div>
              <span class="font-mono-spec font-black text-xs ${pal.text}">★ ${g.rating}</span>
            </div>
            <div class="grid grid-cols-3 gap-1.5 text-[10px] font-mono-spec text-slate-300">
              <div class="rounded-lg bg-black/40 px-2 py-1">Dif: <strong class="text-white">${s.difficulty}</strong></div>
              <div class="rounded-lg bg-black/40 px-2 py-1">Exp: <strong class="text-white">${s.exploration}</strong></div>
              <div class="rounded-lg bg-black/40 px-2 py-1">Grd: <strong class="text-white">${s.grinding}</strong></div>
              <div class="rounded-lg bg-black/40 px-2 py-1">QoL: <strong class="text-white">${s.qol}</strong></div>
              <div class="rounded-lg bg-black/40 px-2 py-1">Bal: <strong class="text-white">${s.balance}</strong></div>
              <div class="rounded-lg bg-black/40 px-2 py-1">OST: <strong class="text-white">${s.music}</strong></div>
            </div>
          </div>
        `;
      }).join("");

      return `
        <div class="rounded-3xl border border-white/[0.08] bg-[#161B29] p-5 sm:p-7 shadow-2xl mb-6">
          <div class="flex flex-wrap items-center justify-between gap-3 pb-5 border-b border-white/[0.08]">
            <div>
              <div class="flex items-center gap-2">
                <span class="text-cyan-400 text-lg">⬡</span>
                <h3 class="text-lg font-black text-white tracking-wide">Multi-Game Stacked Radar Matrix</h3>
              </div>
              <p class="text-xs text-slate-400 mt-1">
                Visualizing all compared games simultaneously overlaid on the 6 core metrics against the medium Archive Benchmark (~53%).
              </p>
            </div>
            <div class="flex items-center gap-2 text-xs font-mono-spec rounded-xl border border-white/[0.08] bg-[#111520] px-3.5 py-1.5 text-slate-400">
              <span class="inline-block h-2.5 w-3.5 rounded border border-dashed border-slate-400 bg-slate-400/20"></span>
              <span>Archive Benchmark (53% Faint Hexagon)</span>
            </div>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-[360px_1fr] items-center gap-8 mt-5">
            <!-- Center Stacked SVG Canvas -->
            <div class="flex justify-center items-center py-2">
              <svg width="340" height="340" viewBox="0 0 340 340" class="overflow-visible select-none max-w-full">
                ${rings}
                ${spokes}
                ${avgPolygon}
                ${stackedSeries}
                ${labels}
              </svg>
            </div>

            <!-- Side Legend Breakdown Cards -->
            <div class="space-y-3">
              <div class="text-[11px] font-mono-spec uppercase tracking-wider text-slate-400 font-bold">
                Stacked Series Breakdown (${games.length} Compared Games)
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                ${legendCards}
              </div>
              <div class="flex items-center gap-2 pt-2 text-[11px] font-mono-spec text-slate-400">
                <span class="text-cyan-400">✦</span>
                <span>Protrusions beyond the faint dashed hexagon represent competitive edges in that dimension.</span>
              </div>
            </div>
          </div>
        </div>
      `;
    }

    function render() {
      renderChips();

      if (!selectedGames.length) {
        emptyState?.classList.remove("hidden");
        tableContainer?.classList.add("hidden");
        return;
      }

      emptyState?.classList.add("hidden");
      tableContainer?.classList.remove("hidden");

      const cols = selectedGames.length;
      const gridColClass =
        cols === 1 ? "grid-cols-[200px_1fr]" :
        cols === 2 ? "grid-cols-[200px_1fr_1fr]" :
        cols === 3 ? "grid-cols-[200px_1fr_1fr_1fr]" :
        "grid-cols-[200px_1fr_1fr_1fr_1fr]";

      const highestRating = Math.max(...selectedGames.map((g) => g.rating));

      // Comparison rows definition
      const specRows = [
        {
          label: "Platform Runtime",
          fn: (g: LibGame) => `
            <span class="inline-flex items-center gap-1.5 rounded-lg border border-white/10 bg-black/40 px-2.5 py-1 text-cyan-300 font-bold">
              ${g.runtime}
            </span>
          `,
        },
        {
          label: "Base Game / Engine",
          fn: (g: LibGame) => `<span class="font-bold text-slate-200">${g.base}</span>`,
        },
        {
          label: "Completion Status",
          fn: (g: LibGame) => {
            const isComp = g.status === "Complete";
            return `
              <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 font-bold ${
                isComp
                  ? "bg-emerald-500/10 text-emerald-400 border border-emerald-500/30"
                  : "bg-amber-500/10 text-amber-400 border border-amber-500/30"
              }">
                <span class="h-1.5 w-1.5 rounded-full ${isComp ? "bg-emerald-400" : "bg-amber-400"}"></span>
                ${g.status}
              </span>
            `;
          },
        },
        {
          label: "Difficulty Meter",
          fn: (g: LibGame) => {
            const pips = g.pips || 3;
            const diamonds = Array.from({ length: 5 }, (_, i) =>
              i < pips ? '<span class="text-amber-400">◆</span>' : '<span class="text-slate-600">◇</span>'
            ).join("");
            return `
              <div class="space-y-1">
                <div class="flex items-center gap-0.5 text-xs font-mono-spec">${diamonds}</div>
                <div class="font-bold text-slate-200">${g.difficulty} (${pips}/5)</div>
              </div>
            `;
          },
        },
        {
          label: "Estimated Playtime",
          fn: (g: LibGame) => `<span class="font-bold text-slate-200">⏱ ${g.playtime}</span>`,
        },
        {
          label: "Creator / Lead Team",
          fn: (g: LibGame) => `<span class="font-bold text-slate-200">👤 ${g.creator || "Community Team"}</span>`,
        },
        {
          label: "Core Focus Tags",
          fn: (g: LibGame) => `
            <div class="flex flex-wrap gap-1.5">
              ${g.tags.slice(0, 3).map((t) => `<span class="rounded bg-black/40 px-2 py-0.5 text-[10px] text-slate-300 border border-white/10">#${t}</span>`).join("")}
            </div>
          `,
        },
        {
          label: "Project Overview",
          fn: (g: LibGame) => `<p class="text-xs leading-relaxed text-slate-300 line-clamp-3">${g.description}</p>`,
        },
      ];

      // Overlap Analysis: Shared vs Unique Tags
      let overlapSection = "";
      if (selectedGames.length >= 2) {
        const sets = selectedGames.map((g) => new Set(g.tags));
        const sharedTags = [...sets[0]].filter((t) => sets.slice(1).every((s) => s.has(t)));

        overlapSection = `
          <div class="mt-6 rounded-3xl border border-white/[0.08] bg-[#161B29] p-5 sm:p-6 space-y-4 shadow-xl">
            <div class="flex items-center gap-2">
              <span class="text-cyan-300 text-sm">✦</span>
              <h3 class="text-xs font-mono-spec font-bold uppercase tracking-wider text-slate-300">
                Shared Mechanical Overlap (${sharedTags.length} Shared Features)
              </h3>
            </div>
            <div class="flex flex-wrap gap-2">
              ${sharedTags.length
                ? sharedTags.map((t) => `<span class="rounded-full border border-cyan-400/40 bg-cyan-500/10 px-3 py-1 text-xs font-mono-spec text-cyan-200">#${t}</span>`).join("")
                : '<span class="text-xs text-slate-500 font-mono-spec">No overlapping tags — each project represents a unique experience archetype.</span>'
              }
            </div>
          </div>
        `;
      }

      const tableMinWidth = Math.max(760, selectedGames.length * 260 + 220);

      tableContainer.innerHTML = `
        ${buildStackedRadarHTML(selectedGames)}

        <!-- Unified Architectural Comparison Table -->
        <div class="overflow-hidden rounded-3xl border border-white/[0.12] bg-[#151b2c] shadow-2xl">
          <!-- Table Bar Header with Scroll Notice -->
          <div class="flex items-center justify-between px-5 py-3 border-b border-white/[0.10] bg-[#0f1422] text-xs font-mono-spec">
            <div class="flex items-center gap-2 text-slate-300 font-bold">
              <span class="text-cyan-400">📊</span>
              <span>Architectural Comparison Matrix (${selectedGames.length} Projects)</span>
            </div>
            <span class="text-slate-500 hidden sm:inline">↔ Scroll horizontally to inspect all columns</span>
          </div>

          <!-- Responsive Scrollable Table Area -->
          <div class="overflow-x-auto custom-scrollbar">
            <table class="w-full text-left border-collapse" style="min-width: ${tableMinWidth}px;">
              <thead>
                <tr class="border-b border-white/[0.10] bg-[#0f1422]">
                  <th class="p-4 sm:p-5 w-[190px] sm:w-[220px] min-w-[190px] sm:min-w-[220px] compare-sticky-col border-r-2 border-white/[0.12] font-mono-spec text-xs font-black uppercase tracking-wider text-slate-400">
                    Project Overview
                  </th>
                  ${selectedGames.map((g) => `
                    <th class="p-5 border-r border-white/[0.08] last:border-r-0 align-top bg-[#151b2c] min-w-[240px] sm:min-w-[260px] space-y-2">
                      <div class="flex items-start justify-between gap-2">
                        <span class="rounded bg-black/50 px-2 py-0.5 text-[10px] font-mono-spec font-bold text-cyan-300 border border-white/10">${g.runtime}</span>
                        <button class="remove-chip rounded-lg border border-white/10 bg-white/5 px-2 py-0.5 text-[10px] font-mono-spec font-bold text-slate-400 hover:border-red-400 hover:text-red-300 transition" data-id="${g.id}">
                          ✕ Remove
                        </button>
                      </div>
                      <a href="/games/${g.id}" class="text-base font-black text-white hover:text-cyan-300 line-clamp-2 block leading-snug mt-1.5 transition-colors">
                        ${g.name}
                      </a>
                      <p class="text-xs text-slate-400 font-mono-spec">${g.category}</p>
                      <a href="/games/${g.id}" class="inline-flex items-center gap-1 text-[11px] font-mono-spec font-bold text-cyan-400 hover:underline pt-1">
                        Open Profile →
                      </a>
                    </th>
                  `).join("")}
                </tr>
              </thead>
              <tbody class="divide-y divide-white/[0.08]">
                <!-- Rating & Score Row -->
                <tr class="hover:bg-white/[0.02] transition-colors">
                  <td class="p-4 sm:p-5 compare-sticky-col border-r-2 border-white/[0.12] font-mono-spec text-xs font-bold text-slate-300 uppercase tracking-wider">
                    Rating & Score
                  </td>
                  ${selectedGames.map((g) => {
                    const pct = Math.round((g.rating / 10) * 100);
                    const isHighest = g.rating === highestRating;
                    return `
                      <td class="p-5 border-r border-white/[0.08] last:border-r-0 align-middle">
                        <div class="space-y-2.5">
                          <div class="flex items-center justify-between font-mono-spec">
                            <span class="text-lg font-black text-yellow-300">★ ${g.rating} <span class="text-[10px] text-slate-500 font-normal">/10</span></span>
                            ${isHighest ? '<span class="text-[9px] font-bold text-emerald-300 bg-emerald-500/20 border border-emerald-500/40 px-2 py-0.5 rounded-full shadow-[0_0_8px_rgba(16,185,129,0.2)]">★ Highest Rated</span>' : ''}
                          </div>
                          <!-- High-contrast rating bar with dark inset track -->
                          <div class="h-2.5 w-full rounded-full bg-black/70 border border-white/15 p-0.5 overflow-hidden shadow-inner">
                            <div class="h-full rounded-full bg-gradient-to-r from-amber-400 via-yellow-400 to-amber-300 shadow-[0_0_8px_rgba(251,191,36,0.5)]" style="width: ${pct}%;"></div>
                          </div>
                        </div>
                      </td>
                    `;
                  }).join("")}
                </tr>

                <!-- Spec Data Rows -->
                ${specRows.map((row, idx) => `
                  <tr class="${idx % 2 === 0 ? 'bg-white/[0.015]' : ''} hover:bg-white/[0.03] transition-colors">
                    <td class="p-4 sm:p-5 compare-sticky-col border-r-2 border-white/[0.12] font-mono-spec text-xs font-bold text-slate-300 uppercase tracking-wider">
                      ${row.label}
                    </td>
                    ${selectedGames.map((g) => `
                      <td class="p-4 sm:p-5 border-r border-white/[0.08] last:border-r-0 text-xs font-mono-spec text-slate-200 align-middle">
                        ${row.fn(g)}
                      </td>
                    `).join("")}
                  </tr>
                `).join("")}
              </tbody>
            </table>
          </div>
        </div>

        ${overlapSection}

        <div class="mt-5 flex justify-end">
          <button id="copy-compare-link" class="rounded-xl border border-white/[0.1] bg-[#111520] px-4 py-2.5 text-xs font-mono-spec font-bold text-slate-300 hover:border-cyan-400 hover:text-cyan-300 transition shadow-lg">
            🔗 Copy Shareable Matrix URL
          </button>
        </div>
      `;

      // Bind remove buttons inside table
      tableContainer.querySelectorAll<HTMLButtonElement>(".remove-chip").forEach((btn) => {
        btn.addEventListener("click", () => {
          selectedGames = selectedGames.filter((g) => g.id !== btn.dataset.id);
          syncURL();
          render();
        });
      });

      document.getElementById("copy-compare-link")?.addEventListener("click", () => {
        navigator.clipboard.writeText(window.location.href).then(() => {
          (window as any).showToast?.("Comparison link copied to clipboard!", "success");
        });
      });
    }

    // Search input handler
    input.addEventListener("input", () => {
      const q = input.value.toLowerCase().trim();
      if (!q) {
        dropdown?.classList.add("hidden");
        return;
      }

      const matches = allGames
        .filter((g) => !selectedGames.some((s) => s.id === g.id))
        .filter((g) => g.name.toLowerCase().includes(q) || g.tags.some((t) => t.toLowerCase().includes(q)))
        .slice(0, 6);

      if (!matches.length) {
        if (dropdown) dropdown.innerHTML = `<div class="p-3 text-xs text-slate-500 font-mono-spec">No games found</div>`;
      } else if (dropdown) {
        dropdown.innerHTML = matches.map((g) => `
          <button class="add-game-match flex w-full items-center justify-between rounded-lg p-2.5 text-left hover:bg-[#1E2538] transition" data-id="${g.id}">
            <div>
              <div class="text-xs font-bold text-white">${g.name}</div>
              <div class="text-[10px] text-slate-500 font-mono-spec">${g.runtime} · ${g.base} · ${g.category}</div>
            </div>
            <span class="text-xs font-mono-spec text-yellow-300 font-bold">★ ${g.rating}</span>
          </button>
        `).join("");

        dropdown.querySelectorAll<HTMLButtonElement>(".add-game-match").forEach((btn) => {
          btn.addEventListener("click", () => {
            const game = allGames.find((g) => g.id === btn.dataset.id);
            if (game && selectedGames.length < 4) {
              selectedGames.push(game);
              input.value = "";
              dropdown.classList.add("hidden");
              syncURL();
              render();
            }
          });
        });
      }

      dropdown?.classList.remove("hidden");
    });

    document.addEventListener("click", (e) => {
      if (dropdown && !input.contains(e.target as Node) && !dropdown.contains(e.target as Node)) {
        dropdown.classList.add("hidden");
      }
    });

    render();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initCompare);
  } else {
    initCompare();
  }
  document.addEventListener("astro:page-load", initCompare);
</script>
