---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Compare · ArchiveDex" description="Compare Pokémon fan games side by side.">
  <main class="mx-auto max-w-7xl px-6 py-12">

    <a href="/library" class="text-sm font-black text-cyan-300 transition hover:text-cyan-200">← Back to library</a>

    <header class="mb-10 mt-6" data-reveal>
      <p class="text-xs font-black uppercase tracking-[0.3em] text-cyan-300">Side by side</p>
      <h1 class="mt-3 text-5xl font-black text-white">Compare games</h1>
      <p class="mt-3 max-w-2xl text-slate-400">Pick up to 3 games to compare stats, tags, and mood at a glance.</p>
    </header>

    <!-- Game picker -->
    <section class="glass-panel relative mb-8 overflow-hidden rounded-[1.75rem] p-6" data-reveal style="--reveal-delay:60ms">
      <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_85%_15%,rgba(34,211,238,0.12),transparent_50%)]"></div>
      <div class="relative">
        <p class="mb-4 text-xs font-black uppercase tracking-[0.25em] text-slate-500">Add games to compare</p>
        <div class="relative">
          <span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-slate-600">🔍</span>
          <input
            id="picker-search"
            placeholder="Search by name, type, tag…"
            autocomplete="off"
            class="w-full rounded-2xl border border-slate-700 bg-slate-950 py-3 pl-10 pr-4 text-slate-100 outline-none transition focus:border-cyan-400 focus:shadow-[0_0_0_3px_rgba(34,211,238,0.12)]"
          />
          <div id="picker-results" class="absolute left-0 right-0 top-full z-50 mt-2 hidden overflow-hidden rounded-2xl border border-slate-700 bg-slate-900 shadow-2xl"></div>
        </div>

        <!-- Selected chips -->
        <div id="selected-chips" class="mt-4 flex flex-wrap gap-3"></div>
      </div>
    </section>

    <!-- Empty state -->
    <div id="empty-compare" class="rounded-[1.75rem] border border-slate-700/60 bg-slate-950/70 p-16 text-center">
      <div class="mb-4 text-6xl opacity-20 select-none">⊕</div>
      <p class="text-2xl font-black text-white">No games selected yet</p>
      <p class="mt-2 text-slate-500">
        Search above, or go to the
        <a href="/library" class="font-bold text-cyan-300 hover:text-cyan-200">Library</a>
        and use the ⊕ buttons on cards.
      </p>
    </div>

    <!-- Comparison table (built by JS) -->
    <div id="compare-output" class="hidden"></div>

  </main>
</BaseLayout>

<script>
  type CompareGame = {
    id: string; name: string; type: string; base: string; runtime: string;
    status: string; category: string; rating: number; length: string;
    difficulty: string; grind: string; story: string; dex: string;
    sourceStatus: string; tags: string[]; mood: string[]; description: string;
    creator: string;
  };

  async function initComparePage() {
    const pickerSearch  = document.getElementById("picker-search") as HTMLInputElement;
    if (!pickerSearch) return; // not on compare page

    const pickerResults = document.getElementById("picker-results") as HTMLElement;
    const chipsEl        = document.getElementById("selected-chips") as HTMLElement;
    const emptyEl         = document.getElementById("empty-compare") as HTMLElement;
    const outputEl        = document.getElementById("compare-output") as HTMLElement;
    const toast = (window as any).showToast as ((msg: string, type?: "success"|"info"|"remove") => void) | undefined;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Fetched from the shared data endpoint (see src/pages/data/games.json.ts)
    // instead of being embedded in this page's HTML — this used to be a
    // ~350KB inline <script> block duplicated on every compare-page load.
    // The browser caches this response, so repeat visits (and visits after
    // the library or home page already fetched it) are effectively free.
    let gameData: CompareGame[] = [];
    try {
      gameData = await fetch("/data/games.json").then((r) => r.json());
    } catch (err) {
      console.error("ArchiveDex: failed to load /data/games.json", err);
      toast?.("Couldn't load game data — try refreshing", "info");
      return;
    }

    // ── State ──────────────────────────────────────────────
    let selected: CompareGame[] = []; // array of game objects, max 3

    // ── Picker search ──────────────────────────────────────
    pickerSearch.addEventListener("input", () => {
      const q = pickerSearch.value.toLowerCase().trim();
      if (!q) { pickerResults.classList.add("hidden"); return; }

      const matches = gameData
        .filter((g) => !selected.find((s) => s.id === g.id))
        .filter((g) =>
          g.name.toLowerCase().includes(q) ||
          g.tags.some((t) => t.toLowerCase().includes(q)) ||
          g.type.toLowerCase().includes(q) ||
          g.category.toLowerCase().includes(q)
        )
        .slice(0, 6);

      if (!matches.length) {
        pickerResults.innerHTML = `<p class="px-4 py-3 text-sm text-slate-500">No results</p>`;
      } else {
        pickerResults.innerHTML = matches.map((g) => `
          <button
            class="picker-result w-full flex items-center justify-between px-4 py-3 text-left hover:bg-slate-800/80 transition"
            data-id="${g.id}"
          >
            <div>
              <div class="font-black text-white">${g.name}</div>
              <div class="text-xs text-slate-500">${g.type} · ${g.category}</div>
            </div>
            <div class="rounded-lg border border-yellow-400/25 bg-yellow-400/8 px-2 py-0.5 text-sm font-black text-yellow-300">${g.rating}</div>
          </button>
        `).join("");

        pickerResults.querySelectorAll<HTMLButtonElement>(".picker-result").forEach((btn) => {
          btn.addEventListener("click", () => {
            const game = gameData.find((g) => g.id === btn.dataset.id);
            if (game && selected.length < 3) {
              selected.push(game);
              pickerSearch.value = "";
              pickerResults.classList.add("hidden");
              render();
              updateURL();
              toast?.(`Added ${game.name}`, "success");
            }
          });
        });
      }

      pickerResults.classList.remove("hidden");
    });

    // Close picker on outside click — guarded so repeat visits to this
    // page (fresh script execution, but `document` itself persists)
    // don't stack duplicate listeners.
    if (!(window as any).__adexComparePickerCloseBound) {
      (window as any).__adexComparePickerCloseBound = true;
      document.addEventListener("click", (e) => {
        const search  = document.getElementById("picker-search");
        const results = document.getElementById("picker-results");
        if (search && results && !search.contains(e.target as Node) && !results.contains(e.target as Node)) {
          results.classList.add("hidden");
        }
      });
    }

    // ── Render chips ───────────────────────────────────────
    function renderChips() {
      if (!selected.length) {
        chipsEl.innerHTML = `<p class="text-xs text-slate-600">No games selected yet — max 3</p>`;
        return;
      }
      chipsEl.innerHTML = selected.map((g) => `
        <div class="flex items-center gap-2 rounded-2xl border border-cyan-400/30 bg-cyan-400/10 px-4 py-2 glow-cyan">
          <span class="text-sm font-black text-cyan-200">${g.name}</span>
          <span class="rounded-md border border-yellow-400/25 bg-yellow-400/8 px-1.5 py-0.5 text-xs font-black text-yellow-300">${g.rating}</span>
          <button
            class="remove-chip ml-1 text-slate-500 hover:text-red-400 transition font-black text-sm"
            data-id="${g.id}"
            aria-label="Remove ${g.name}"
          >✕</button>
        </div>
      `).join("");

      chipsEl.querySelectorAll<HTMLButtonElement>(".remove-chip").forEach((btn) => {
        btn.addEventListener("click", () => {
          const game = selected.find((g) => g.id === btn.dataset.id);
          selected = selected.filter((g) => g.id !== btn.dataset.id);
          render();
          updateURL();
          if (game) toast?.(`Removed ${game.name}`, "remove");
        });
      });
    }

    // ── Render comparison table ────────────────────────────
    const STAT_ROWS: { label: string; key: keyof CompareGame }[] = [
      { label: "Type",       key: "type" },
      { label: "Base",       key: "base" },
      { label: "Runtime",    key: "runtime" },
      { label: "Status",     key: "status" },
      { label: "Length",     key: "length" },
      { label: "Difficulty", key: "difficulty" },
      { label: "Grind",      key: "grind" },
      { label: "Story",      key: "story" },
      { label: "Pokédex",    key: "dex" },
      { label: "Source",     key: "sourceStatus" },
    ];

    function ratingBar(rating: number) {
      const pct = Math.round((rating / 10) * 100);
      return `
        <div class="flex items-center gap-3">
          <span class="text-3xl font-black text-yellow-300" style="text-shadow:0 0 16px rgba(253,224,71,0.5)">${rating}</span>
          <div class="flex-1 rounded-full bg-slate-800 h-2 overflow-hidden">
            <div class="h-2 rounded-full bg-gradient-to-r from-amber-400 to-yellow-300 rating-bar-fill" style="width:0%" data-target="${pct}"></div>
          </div>
        </div>
      `;
    }

    function tagOverlap() {
      if (selected.length < 2) return "";
      const sets = selected.map((g) => new Set(g.tags));
      const shared = [...sets[0]].filter((t) => sets.slice(1).every((s) => s.has(t)));
      if (!shared.length) return `<p class="text-xs text-slate-600">No shared tags</p>`;
      return shared.map((t) =>
        `<span class="rounded-full border border-cyan-400/30 bg-cyan-400/10 px-3 py-1 text-xs font-bold text-cyan-300">${t}</span>`
      ).join("");
    }

    function moodOverlap() {
      if (selected.length < 2) return "";
      const sets = selected.map((g) => new Set(g.mood));
      const shared = [...sets[0]].filter((t) => sets.slice(1).every((s) => s.has(t)));
      if (!shared.length) return `<p class="text-xs text-slate-600">No shared moods</p>`;
      return shared.map((t) =>
        `<span class="rounded-full border border-violet-400/30 bg-violet-400/10 px-3 py-1 text-xs font-bold text-violet-300">${t}</span>`
      ).join("");
    }

    function renderTable() {
      const cols = selected.length;
      // 1/2/3 selected games need 2/3/4 grid columns (label column + one
      // per game). This used to fall through to the 4-column class meant
      // for 3 games whenever cols was anything other than 2 — including 1
      // — leaving two blank trailing columns. Reachable by hitting
      // "Compare" on a single detail page with nothing else queued yet.
      const colClass =
        cols === 1 ? "grid-cols-[180px_1fr]" :
        cols === 2 ? "grid-cols-[180px_1fr_1fr]" :
        "grid-cols-[180px_1fr_1fr_1fr]";

      const header = `
        <div class="grid ${colClass} gap-px overflow-hidden rounded-t-[1.5rem] bg-slate-800">
          <div class="bg-slate-950 p-4"></div>
          ${selected.map((g) => `
            <div class="bg-slate-950/95 p-5">
              <a href="/games/${g.id}" class="font-black text-white hover:text-cyan-200 text-lg leading-tight block transition">${g.name}</a>
              <div class="mt-1 text-xs text-slate-500">${g.type} · ${g.category}</div>
              <div class="mt-4">${ratingBar(g.rating)}</div>
            </div>
          `).join("")}
        </div>
      `;

      const rows = STAT_ROWS.map((row, i) => {
        const bg = i % 2 === 0 ? "bg-slate-950/70" : "bg-slate-950/40";
        return `
          <div class="grid ${colClass} gap-px bg-slate-800">
            <div class="${bg} px-5 py-3 text-xs font-black uppercase tracking-widest text-slate-500 flex items-center">${row.label}</div>
            ${selected.map((g) => `
              <div class="${bg} px-5 py-3 text-sm font-bold text-slate-200">${g[row.key]}</div>
            `).join("")}
          </div>
        `;
      }).join("");

      const tagsRow = `
        <div class="grid ${colClass} gap-px bg-slate-800">
          <div class="bg-slate-950/70 px-5 py-4 text-xs font-black uppercase tracking-widest text-slate-500 flex items-start pt-4">Tags</div>
          ${selected.map((g) => `
            <div class="bg-slate-950/70 px-5 py-4 flex flex-wrap gap-2">
              ${g.tags.map((t) => `<span class="rounded-full border border-slate-700 bg-slate-900 px-2.5 py-1 text-xs text-slate-300">${t}</span>`).join("")}
            </div>
          `).join("")}
        </div>
      `;

      const moodRow = `
        <div class="grid ${colClass} gap-px bg-slate-800">
          <div class="bg-slate-950/70 px-5 py-4 text-xs font-black uppercase tracking-widest text-slate-500 flex items-start pt-4">Mood</div>
          ${selected.map((g) => `
            <div class="bg-slate-950/70 px-5 py-4 flex flex-wrap gap-2">
              ${g.mood.map((m) => `<span class="rounded-full border border-violet-400/20 bg-violet-400/5 px-2.5 py-1 text-xs text-violet-300">${m}</span>`).join("")}
            </div>
          `).join("")}
        </div>
      `;

      const overlapSection = selected.length >= 2 ? `
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          <div class="rounded-2xl border border-cyan-400/20 bg-cyan-400/5 p-5">
            <p class="mb-3 text-xs font-black uppercase tracking-widest text-cyan-300">Shared tags</p>
            <div class="flex flex-wrap gap-2">${tagOverlap()}</div>
          </div>
          <div class="rounded-2xl border border-violet-400/20 bg-violet-400/5 p-5">
            <p class="mb-3 text-xs font-black uppercase tracking-widest text-violet-300">Shared mood</p>
            <div class="flex flex-wrap gap-2">${moodOverlap()}</div>
          </div>
        </div>
      ` : "";

      return `
        <div class="overflow-x-auto rounded-[1.5rem] border border-slate-800 overflow-hidden">
          ${header}${rows}${tagsRow}${moodRow}
        </div>
        ${overlapSection}
        <div class="mt-6 flex justify-end">
          <button id="share-compare" class="magnetic-btn flex items-center gap-2 rounded-2xl border border-slate-700 bg-slate-900 px-5 py-2.5 text-sm font-black text-slate-300 hover:border-cyan-400/40 hover:text-cyan-300 transition">
            🔗 Copy share link
          </button>
        </div>
      `;
    }

    // ── Master render ──────────────────────────────────────
    function render() {
      renderChips();

      if (selected.length === 0) {
        emptyEl.classList.remove("hidden");
        outputEl.classList.add("hidden");
        outputEl.innerHTML = "";
      } else {
        emptyEl.classList.add("hidden");
        outputEl.classList.remove("hidden");
        if (!reduceMotion) {
          outputEl.style.animation = "none";
          void outputEl.offsetWidth;
          outputEl.style.animation = "card-rise 0.4s cubic-bezier(0.16,1,0.3,1) both";
        }
        outputEl.innerHTML = renderTable();

        // Animate rating bars filling in, and count up the numbers
        requestAnimationFrame(() => {
          outputEl.querySelectorAll<HTMLElement>(".rating-bar-fill").forEach((bar) => {
            const target = bar.dataset.target;
            if (reduceMotion) { bar.style.width = `${target}%`; }
            else { requestAnimationFrame(() => { bar.style.transition = "width 0.7s cubic-bezier(0.16,1,0.3,1)"; bar.style.width = `${target}%`; }); }
          });
        });

        document.getElementById("share-compare")?.addEventListener("click", () => {
          navigator.clipboard.writeText(window.location.href).then(() => {
            const btn = document.getElementById("share-compare");
            if (btn) { btn.textContent = "✓ Copied!"; setTimeout(() => { btn.textContent = "🔗 Copy share link"; }, 2000); }
            toast?.("Share link copied", "success");
          });
        });
      }
    }

    // ── URL sync ───────────────────────────────────────────
    function updateURL() {
      const url = new URL(window.location.href);
      if (selected.length) {
        url.searchParams.set("games", selected.map((g) => g.id).join(","));
      } else {
        url.searchParams.delete("games");
      }
      history.replaceState({}, "", url.toString());
    }

    // ── Load from URL on mount ─────────────────────────────
    const params = new URLSearchParams(window.location.search);
    const gamesParam = params.get("games");
    if (gamesParam) {
      const ids = gamesParam.split(",").slice(0, 3);
      selected = ids.map((id) => gameData.find((g) => g.id === id)).filter((g): g is CompareGame => Boolean(g));
    }

    render();
  }

  document.addEventListener("astro:page-load", initComparePage);
</script>

<style>
  @media (prefers-reduced-motion: reduce) {
    #compare-output { animation: none !important; }
  }
</style>
