---
import { games } from "../data/games";
const gameIds = games.map((g) => g.id);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Random Game · ArchiveDex</title>
    <style>
      body {
        margin: 0;
        background: #070914;
        color: #f8fafc;
        font-family: Inter, ui-sans-serif, system-ui, sans-serif;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        gap: 12px;
        flex-direction: column;
      }
      body {
        background:
          radial-gradient(circle at 30% 30%, var(--hero-glow-1, rgba(34,211,238,0.10)), transparent 30rem),
          radial-gradient(circle at 70% 70%, var(--hero-glow-2, rgba(168,85,247,0.10)), transparent 30rem),
          var(--surface-canvas, #070914);
      }
      .die {
        font-size: 2.75rem;
        animation: spin-die 1.1s cubic-bezier(0.45,0,0.55,1) infinite;
      }
      @keyframes spin-die {
        0%   { transform: rotate(0deg)   scale(1); }
        50%  { transform: rotate(180deg) scale(1.15); }
        100% { transform: rotate(360deg) scale(1); }
      }
      @media (prefers-reduced-motion: reduce) {
        .die { animation: none; }
      }
    </style>
  </head>
  <body>
    <div class="die">🎲</div>
    <p style="color:#94a3b8;font-size:0.875rem;font-weight:700">Finding a random game…</p>
    <noscript>
      <p style="color:#94a3b8">JavaScript is required. <a href="/library" style="color:#67e8f9">Go to Library →</a></p>
    </noscript>
    <script define:vars={{ gameIds }} is:inline>
      const id = gameIds[Math.floor(Math.random() * gameIds.length)];
      window.location.replace("/games/" + id);
    </script>
  </body>
</html>
