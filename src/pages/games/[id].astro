---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GameCard from "../../components/GameCard.astro";
import {
  games,
  getDifficultyPips,
  getPlaytime,
  getCleanBaseRom,
  getPatchFormat,
  getEmulatorCompat,
  getHexagonStats,
  getLineage,
  getKeyDetails,
  ARCHIVE_STAT_AVERAGES
} from "../../data/games";

export function getStaticPaths() {
  return games.map((game) => ({ params: { id: game.id }, props: { game } }));
}

const { game } = Astro.props;

// 1. Similar Gameplay recommendations
const similarGames = games
  .filter((e) => e.id !== game.id)
  .map((e) => {
    let score = 0;
    if (e.category === game.category) score += 4;
    if (e.runtime === game.runtime) score += 3;
    if (e.difficulty === game.difficulty) score += 2;
    if (e.base === game.base) score += 1;
    return { game: e, score };
  })
  .sort((a, b) => (b.score !== a.score ? b.score - a.score : b.game.rating - a.game.rating))
  .slice(0, 4)
  .map((x) => x.game);

// 2. By Mechanics & Shared Tags recommendations
const tagGames = games
  .filter((e) => e.id !== game.id)
  .map((e) => {
    const sharedTags = e.tags.filter((t) => game.tags.includes(t));
    return { game: e, sharedCount: sharedTags.length };
  })
  .filter((x) => x.sharedCount > 0)
  .sort((a, b) => (b.sharedCount !== a.sharedCount ? b.sharedCount - a.sharedCount : b.game.rating - a.game.rating))
  .slice(0, 4)
  .map((x) => x.game);

// 3. More from Creator recommendations
const creatorNorm = (game.creator || "").trim().toLowerCase();
const creatorGames =
  creatorNorm && creatorNorm !== "community" && creatorNorm !== "unknown"
    ? games.filter((e) => e.id !== game.id && (e.creator || "").trim().toLowerCase() === creatorNorm)
    : [];

const fallbackCreatorGames =
  creatorGames.length === 0
    ? games.filter((e) => e.id !== game.id && e.runtime === game.runtime).sort((a, b) => b.rating - a.rating).slice(0, 4)
    : [];

function catSlug(category: string): string {
  return category.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
}

const gradClass = `cat-grad-${catSlug(game.category)}`;
const pips = getDifficultyPips(game);
const playtime = getPlaytime(game);
const cleanBaseRom = getCleanBaseRom(game);
const patchFormat = getPatchFormat(game);
const compat = getEmulatorCompat(game);
const radar = getHexagonStats(game);
const lineage = getLineage(game);
const keySpecs = getKeyDetails(game);

const hasActualLineage =
  lineage !== null &&
  Boolean(
    (lineage.prequels && lineage.prequels.length > 0) ||
    (lineage.sequels && lineage.sequels.length > 0) ||
    (lineage.variants && lineage.variants.length > 0) ||
    (lineage.sharedUniverse && lineage.sharedUniverse.length > 0)
  );

// Aspect ratio class for 3D cartridge box
const aspectClass =
  game.runtime === "GBA" ? "aspect-box-gba" :
  game.runtime === "GBC" || game.runtime === "GB" ? "aspect-box-gbc" :
  game.runtime === "NDS" || game.runtime === "3DS" ? "aspect-box-nds" : "aspect-box-pc";

// Dual Rating 4 Ring Gauges
const ringScores = [
  { label: "Story", score: Math.round(game.story.includes("Very") ? 95 : game.story.includes("Story Heavy") ? 88 : game.story.includes("Good") ? 78 : 65), color: "#c4b5fd" },
  { label: "Gameplay", score: Math.round(game.rating * 9.8), color: "#22d3ee" },
  { label: "Content", score: Math.round(game.length.includes("Huge") ? 98 : game.length.includes("Long") ? 85 : 72), color: "#34d399" },
  { label: "Replayability", score: Math.round(game.category === "Roguelike" ? 99 : game.tags.includes("Open World") ? 92 : 75), color: "#fde047" },
];

const RING_R = 30;
const RING_C = 2 * Math.PI * RING_R;

// Hexagon Radar Chart Coordinates math
// Center (150, 150), Radius 100
const CX = 150;
const CY = 150;
const RADAR_R = 95;

const metrics = [
  { key: "difficulty", label: "Difficulty", val: radar.difficulty, avg: ARCHIVE_STAT_AVERAGES.difficulty, angle: -90 },
  { key: "exploration", label: "Exploration", val: radar.exploration, avg: ARCHIVE_STAT_AVERAGES.exploration, angle: -30 },
  { key: "grinding", label: "Grinding", val: radar.grinding, avg: ARCHIVE_STAT_AVERAGES.grinding, angle: 30 },
  { key: "qol", label: "QoL Features", val: radar.qol, avg: ARCHIVE_STAT_AVERAGES.qol, angle: 90 },
  { key: "balance", label: "Game Balance", val: radar.balance, avg: ARCHIVE_STAT_AVERAGES.balance, angle: 150 },
  { key: "music", label: "OST & Audio", val: radar.music, avg: ARCHIVE_STAT_AVERAGES.music, angle: 210 },
];

function getRadarPoint(val: number, angleDeg: number, maxRadius = RADAR_R) {
  const rad = (angleDeg * Math.PI) / 180;
  const dist = (val / 100) * maxRadius;
  return {
    x: Math.round((CX + dist * Math.cos(rad)) * 10) / 10,
    y: Math.round((CY + dist * Math.sin(rad)) * 10) / 10,
  };
}

// Generate concentric hexagon level outlines (25%, 50%, 75%, 100%)
const hexLevels = [25, 50, 75, 100].map((level) => {
  return metrics
    .map((m) => {
      const p = getRadarPoint(level, m.angle);
      return `${p.x},${p.y}`;
    })
    .join(" ");
});

// Polygon points for Archive Average Benchmark (Medium Hexagon ~53%)
const avgPolygonPoints = metrics
  .map((m) => {
    const p = getRadarPoint(m.avg, m.angle);
    return `${p.x},${p.y}`;
  })
  .join(" ");

// Polygon points for game's actual stats
const statPolygonPoints = metrics
  .map((m) => {
    const p = getRadarPoint(m.val, m.angle);
    return `${p.x},${p.y}`;
  })
  .join(" ");
---

<BaseLayout title={`${game.name} · ArchiveDex Preservation Record`} description={game.description}>
  
  <!-- ═══════════════════════════════════════════ -->
  <!-- STICKY FROSTED-GLASS SUBHEADER ON SCROLL   -->
  <!-- ═══════════════════════════════════════════ -->
  <div id="sticky-record-bar" class="fixed top-16 inset-x-0 z-20 hidden border-b border-white/[0.1] bg-[#111520]/90 px-6 py-2.5 backdrop-blur-xl shadow-lg transition-all duration-300">
    <div class="mx-auto flex max-w-6xl items-center justify-between">
      <div class="flex items-center gap-3 min-w-0">
        <span class="rounded bg-black/40 px-2 py-0.5 text-[10px] font-mono-spec font-bold text-cyan-300">{game.runtime}</span>
        <h2 class="text-sm font-black text-white truncate">{game.name}</h2>
        <span class="text-xs font-mono-spec text-yellow-300 font-bold">★ {game.rating}</span>
      </div>

      <div class="flex items-center gap-2">
        <button class="card-action-wishlist rounded-lg border border-white/[0.1] px-3 py-1 text-xs font-bold text-slate-300 hover:border-rose-400 hover:text-rose-300" data-id={game.id} data-name={game.name}>
          ♡ Wishlist
        </button>
        <button class="card-action-compare rounded-lg border border-white/[0.1] px-3 py-1 text-xs font-bold text-slate-300 hover:border-cyan-400 hover:text-cyan-300" data-id={game.id} data-name={game.name}>
          ⇄ Compare
        </button>
        {game.officialSource && (
          <a href={game.officialSource} target="_blank" rel="noopener noreferrer" class="rounded-lg bg-cyan-400 px-3.5 py-1 text-xs font-black text-slate-950 hover:bg-cyan-300">
            Official Source ↗
          </a>
        )}
      </div>
    </div>
  </div>

  <main class="mx-auto max-w-6xl px-6 py-8">

    <!-- Breadcrumb Nav -->
    <div class="mb-5 flex items-center gap-2 text-xs font-mono-spec text-slate-500">
      <a href="/library" class="text-cyan-400 hover:underline">Library</a>
      <span>/</span>
      <span class="text-slate-400">{game.category}</span>
      <span>/</span>
      <span class="text-white truncate">{game.name}</span>
    </div>

    <!-- ═══════════════════════════════════════════ -->
    <!-- HERO: BLURRED BANNER & 3D CARTRIDGE BOX     -->
    <!-- ═══════════════════════════════════════════ -->
    <section id="record-hero-trigger" class="relative overflow-hidden rounded-3xl border border-white/[0.08] border-t-white/[0.14] bg-[#161B29] p-6 lg:p-8 shadow-2xl">
      
      <!-- Blurred in-game background banner overlay -->
      <div class={`absolute inset-0 ${gradClass} opacity-15 filter blur-3xl pointer-events-none`}></div>
      <div class="absolute inset-0 hero-backdrop-gradient bg-gradient-to-t from-[#161B29] via-[#161B29]/90 to-transparent pointer-events-none"></div>

      <div class="relative grid gap-8 lg:grid-cols-[auto_1fr] items-start">
        
        <!-- 3D Cartridge Box-Art Card overlapping edge -->
        <div class="tilt-card relative w-48 sm:w-56 shrink-0 mx-auto lg:mx-0">
          <div class="tilt-glare"></div>
          <div class={`hardware-box-frame ${aspectClass} ${gradClass} p-4 flex flex-col justify-between shadow-2xl border-2 border-white/20`}>
            
            <div class="flex items-center justify-between z-10">
              <span class="rounded bg-black/70 px-2 py-0.5 text-[10px] font-mono-spec font-black text-white uppercase backdrop-blur-md">
                {game.runtime}
              </span>
              <span class="rounded-full bg-emerald-400/20 px-2 py-0.5 text-[9px] font-mono-spec font-bold text-emerald-300 border border-emerald-400/30">
                {game.status}
              </span>
            </div>

            <!-- Visual cartridge label insignia -->
            <div class="my-auto text-center z-10 py-4">
              <span class="text-4xl opacity-30 select-none">🎮</span>
              <div class="mt-1 text-xs font-black text-white leading-tight drop-shadow-md clamp-2">
                {game.name}
              </div>
            </div>

            <div class="flex items-center justify-between z-10 border-t border-white/10 pt-2 text-[10px] font-mono-spec text-slate-300">
              <span>{game.base}</span>
              <span class="font-bold text-yellow-300">★ {game.rating}</span>
            </div>
          </div>
        </div>

        <!-- Hero Metadata & Title -->
        <div class="space-y-4">
          <div class="flex flex-wrap items-center gap-2">
            <span class="rounded-md bg-cyan-500/10 border border-cyan-400/30 px-2.5 py-1 text-xs font-mono-spec font-bold text-cyan-300">
              {game.type}
            </span>
            <span class="rounded-md bg-violet-500/10 border border-violet-400/30 px-2.5 py-1 text-xs font-mono-spec font-bold text-violet-300">
              Base: {game.base}
            </span>
            <span class="rounded-md bg-yellow-500/10 border border-yellow-400/30 px-2.5 py-1 text-xs font-mono-spec font-bold text-yellow-300">
              ★ {game.rating} / 10
            </span>
            <span class="rounded-md bg-slate-800 px-2.5 py-1 text-xs font-mono-spec text-slate-400">
              ⏱ {playtime}
            </span>
          </div>

          <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight">
            {game.name}
          </h1>

          <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs font-mono-spec text-slate-400">
            <span>Creator: <strong class="text-white">{game.creator || "Community Project"}</strong></span>
            <span>·</span>
            <span>Category: <strong class="text-cyan-300">{game.category}</strong></span>
            <span>·</span>
            <span>Status: <strong class="text-emerald-400">{game.status}</strong></span>
          </div>

          <p class="text-sm leading-relaxed text-slate-300 max-w-3xl">
            {game.description}
          </p>

          <!-- Action Buttons Bar -->
          <div class="pt-2 flex flex-wrap items-center gap-3">
            {game.officialSource ? (
              <a
                href={game.officialSource}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-2 rounded-xl bg-cyan-400 px-5 py-2.5 text-xs font-black text-slate-950 transition hover:bg-cyan-300 shadow-[0_0_20px_rgba(34,211,238,0.3)]"
              >
                <span>↗ Official Creator Channel</span>
              </a>
            ) : (
              <span class="rounded-xl border border-white/[0.08] bg-[#111520] px-4 py-2.5 text-xs font-mono-spec text-slate-500">
                Creator Channel Not Indexed
              </span>
            )}

            <button
              class="card-action-wishlist flex items-center gap-1.5 rounded-xl border border-white/[0.1] bg-[#111520] px-4 py-2.5 text-xs font-bold text-slate-300 hover:border-rose-400/50 hover:text-rose-300"
              data-id={game.id}
              data-name={game.name}
            >
              <span>♡</span> Add to Wishlist
            </button>

            <button
              class="card-action-compare flex items-center gap-1.5 rounded-xl border border-white/[0.1] bg-[#111520] px-4 py-2.5 text-xs font-bold text-slate-300 hover:border-cyan-400/50 hover:text-cyan-300"
              data-id={game.id}
              data-name={game.name}
            >
              <span>⇄</span> Compare Game
            </button>
          </div>
        </div>

      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- SIDE-BY-SIDE: KEY DETAILS (LIST) & DUAL RATING VISUALIZER      -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <section class="mt-8 grid gap-6 lg:grid-cols-2 items-stretch" data-reveal>
      
      <!-- ═══════════════════════════════════════════ -->
      <!-- 1. KEY DETAILS (STRUCTURED VERTICAL LIST)   -->
      <!-- ═══════════════════════════════════════════ -->
      <div class="rounded-3xl border border-white/[0.08] bg-[#161B29] p-6 sm:p-7 flex flex-col justify-between shadow-xl">
        <div>
          <!-- Header -->
          <div class="flex items-center justify-between pb-4 border-b border-white/[0.08]">
            <div>
              <span class="text-[10px] font-black uppercase tracking-widest text-cyan-300 font-mono-spec">Technical Architecture & Features</span>
              <h2 class="text-xl font-black text-white mt-1 flex items-center gap-2">
                <span>⚙️</span> Key Project Details
              </h2>
            </div>
            <span class="rounded-xl border border-white/[0.08] bg-[#111520] px-3 py-1 font-mono-spec text-[10px] text-slate-400">
              Curated Museum Spec
            </span>
          </div>

          <!-- Structured Vertical List -->
          <ul class="mt-4 divide-y divide-white/[0.06] text-xs">
            
            <!-- 1. Pokédex & Generations Scope -->
            <li class="py-3.5 first:pt-1">
              <div class="flex flex-wrap sm:flex-nowrap items-center justify-between gap-1.5 mb-1.5">
                <span class="flex items-center gap-1.5 text-cyan-300 font-mono-spec font-black text-[11px] uppercase tracking-wider">
                  <span>🧬</span> Pokédex & Generations
                </span>
                <span class="rounded bg-cyan-400/10 px-2 py-0.5 text-cyan-300 font-mono-spec font-bold text-[10px] max-w-full leading-tight">
                  {keySpecs.dexCount}
                </span>
              </div>
              <p class="text-slate-300 font-medium leading-relaxed pl-5">
                {keySpecs.pokedexGenerations}
              </p>
            </li>

            <!-- 2. Combat Mechanics & Battle Gimmicks -->
            <li class="py-3.5">
              <div class="flex flex-wrap sm:flex-nowrap items-center justify-between gap-1.5 mb-1.5">
                <span class="flex items-center gap-1.5 text-violet-300 font-mono-spec font-black text-[11px] uppercase tracking-wider">
                  <span>⚔️</span> Combat Mechanics & Gimmicks
                </span>
                <span class="rounded bg-violet-400/10 px-2 py-0.5 text-violet-300 font-mono-spec font-bold text-[10px] max-w-full leading-tight">
                  {game.base} ({game.runtime})
                </span>
              </div>
              <div class="flex flex-wrap gap-1.5 pl-5 mt-1">
                {keySpecs.combatGimmicks.map((gimmick) => (
                  <span class="rounded-lg border border-violet-400/20 bg-violet-500/10 px-2 py-0.5 text-[10px] font-mono-spec font-bold text-violet-200">
                    {gimmick}
                  </span>
                ))}
              </div>
            </li>

            <!-- 3. World & Region Architecture -->
            <li class="py-3.5">
              <div class="flex flex-wrap sm:flex-nowrap items-center justify-between gap-1.5 mb-1.5">
                <span class="flex items-center gap-1.5 text-emerald-300 font-mono-spec font-black text-[11px] uppercase tracking-wider">
                  <span>🗺️</span> World & Region Architecture
                </span>
                <span class="rounded bg-emerald-400/10 px-2 py-0.5 text-emerald-300 font-mono-spec font-bold text-[10px] max-w-full leading-tight">
                  {game.tags.includes("Open World") ? "Open Sandbox" : game.tags.includes("Roguelike") ? "Procedural Rogue" : "Structured Map"}
                </span>
              </div>
              <p class="text-slate-300 font-medium leading-relaxed pl-5">
                {keySpecs.worldRegion}
              </p>
            </li>

            <!-- 4. Battle AI & Difficulty Systems -->
            <li class="py-3.5">
              <div class="flex flex-wrap sm:flex-nowrap items-center justify-between gap-1.5 mb-1.5">
                <span class="flex items-center gap-1.5 text-rose-300 font-mono-spec font-black text-[11px] uppercase tracking-wider">
                  <span>🧠</span> Battle AI & Difficulty
                </span>
                <span class="rounded bg-rose-400/10 px-2 py-0.5 text-rose-300 font-mono-spec font-bold text-[10px] max-w-full leading-tight">
                  {game.difficulty}
                </span>
              </div>
              <p class="text-slate-300 font-medium leading-relaxed pl-5">
                {keySpecs.battleAI}
              </p>
            </li>

            <!-- 5. Storyline & Narrative Overhaul -->
            <li class="py-3.5">
              <div class="flex flex-wrap sm:flex-nowrap items-center justify-between gap-1.5 mb-1.5">
                <span class="flex items-center gap-1.5 text-amber-300 font-mono-spec font-black text-[11px] uppercase tracking-wider">
                  <span>📜</span> Storyline & Narrative
                </span>
                <span class="rounded bg-amber-400/10 px-2 py-0.5 text-amber-300 font-mono-spec font-bold text-[10px] max-w-full leading-tight">
                  {game.story}
                </span>
              </div>
              <p class="text-slate-300 font-medium leading-relaxed pl-5">
                {keySpecs.storyChanges}
              </p>
            </li>

            <!-- 6. Quality-of-Life & Systems -->
            <li class="py-3.5 last:pb-1">
              <div class="flex flex-wrap sm:flex-nowrap items-center justify-between gap-1.5 mb-1.5">
                <span class="flex items-center gap-1.5 text-blue-300 font-mono-spec font-black text-[11px] uppercase tracking-wider">
                  <span>🛠️</span> Quality-of-Life Systems
                </span>
                <span class="rounded bg-blue-400/10 px-2 py-0.5 text-blue-300 font-mono-spec font-bold text-[10px] max-w-full leading-tight">
                  Grind: {game.grind}
                </span>
              </div>
              <div class="flex flex-wrap gap-1.5 pl-5 mt-1">
                {keySpecs.qolHighlights.map((qol) => (
                  <span class="rounded border border-blue-400/20 bg-blue-500/10 px-2 py-0.5 text-[10px] font-mono-spec text-blue-200">
                    ✦ {qol}
                  </span>
                ))}
              </div>
            </li>

          </ul>
        </div>
      </div>

      <!-- ═══════════════════════════════════════════ -->
      <!-- 2. DUAL RATING VISUALIZER (GAUGES + RADAR)  -->
      <!-- ═══════════════════════════════════════════ -->
      <div class="rounded-3xl border border-white/[0.08] bg-[#161B29] p-6 sm:p-7 flex flex-col justify-between shadow-xl">
        <div>
          <!-- Header -->
          <div class="flex items-center justify-between pb-4 border-b border-white/[0.08]">
            <div>
              <span class="text-[10px] font-black uppercase tracking-widest text-cyan-300 font-mono-spec">Metrology & Experience</span>
              <h2 class="text-xl font-black text-white mt-1">Dual Rating Visualizer</h2>
            </div>
            <span class="text-[10px] font-mono-spec text-slate-500">4 Pillars + 6-Stat Radar</span>
          </div>

          <!-- Top: 4 Circular SVG Ring Gauges -->
          <div class="mt-4">
            <h3 class="text-[11px] font-mono-spec font-bold uppercase tracking-wider text-slate-400 mb-2.5">
              Core Pillars (Ring Gauges)
            </h3>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
              {ringScores.map(({ label, score, color }) => {
                const fill = RING_C * (score / 100);
                const gap = RING_C - fill;
                return (
                  <div class="flex flex-col items-center rounded-2xl border border-white/[0.06] bg-[#111520] py-3 px-2 text-center">
                    <div class="relative h-14 w-14 sm:h-16 sm:w-16">
                      <svg viewBox="0 0 80 80" class="h-full w-full -rotate-90">
                        <circle cx="40" cy="40" r={RING_R} stroke="rgba(255,255,255,0.08)" stroke-width="6" fill="none"/>
                        <circle
                          cx="40"
                          cy="40"
                          r={RING_R}
                          stroke={color}
                          stroke-width="6"
                          stroke-linecap="round"
                          stroke-dasharray={`${fill} ${gap}`}
                          fill="none"
                          style={`filter: drop-shadow(0 0 6px ${color}88);`}
                        />
                      </svg>
                      <div class="absolute inset-0 flex flex-col items-center justify-center font-mono-spec">
                        <span class="text-sm font-black text-white">{score}</span>
                        <span class="text-[7px] text-slate-500">/100</span>
                      </div>
                    </div>
                    <span class="mt-1 text-[11px] font-bold text-slate-300">{label}</span>
                  </div>
                );
              })}
            </div>
          </div>

          <!-- Below: Pokémon-Styled Hexagon Stat Radar Chart -->
          <div class="mt-4 flex flex-col items-center rounded-2xl border border-white/[0.06] bg-[#111520] p-4">
            <div class="w-full flex items-center justify-between pb-2">
              <span class="text-[11px] font-mono-spec font-bold uppercase tracking-wider text-slate-400">
                Deep Metrics (Hexagon Radar)
              </span>
              <span class="text-[10px] font-mono-spec text-cyan-300 font-bold">Radar 2.0</span>
            </div>

            <div class="relative my-1 flex justify-center w-full">
              <svg width="270" height="270" viewBox="0 0 300 300" class="overflow-visible select-none max-w-full">
                <!-- Concentric Hexagon Background Rings -->
                {hexLevels.map((pts, i) => (
                  <polygon
                    points={pts}
                    fill="none"
                    stroke="rgba(255,255,255,0.08)"
                    stroke-width={i === 3 ? "1.5" : "1"}
                    stroke-dasharray={i < 3 ? "3 3" : undefined}
                  />
                ))}

                <!-- Spoke Axis Lines -->
                {metrics.map((m) => {
                  const outer = getRadarPoint(100, m.angle);
                  return (
                    <line
                      x1={CX}
                      y1={CY}
                      x2={outer.x}
                      y2={outer.y}
                      stroke="rgba(255,255,255,0.12)"
                      stroke-width="1"
                    />
                  );
                })}

                <!-- 1. Archive Benchmark Average Hexagon (Medium-Sized ~53% in Faint Shade) -->
                <polygon
                  points={avgPolygonPoints}
                  fill="rgba(148, 163, 184, 0.12)"
                  stroke="rgba(148, 163, 184, 0.45)"
                  stroke-width="1.5"
                  stroke-dasharray="4 3"
                />

                <!-- 2. Game's Actual Stats Polygon (Stacked on Top with Vibrant Glow) -->
                <polygon
                  points={statPolygonPoints}
                  fill="rgba(34, 211, 238, 0.28)"
                  stroke="#22d3ee"
                  stroke-width="2.5"
                  class="radar-game-polygon"
                  style="filter: drop-shadow(0 0 10px rgba(34, 211, 238, 0.4));"
                />

                <!-- Vertex Dots -->
                {metrics.map((m) => {
                  const pt = getRadarPoint(m.val, m.angle);
                  const isAbove = m.val > m.avg;
                  return (
                    <circle
                      cx={pt.x}
                      cy={pt.y}
                      r="4"
                      fill={isAbove ? "#67e8f9" : "#94a3b8"}
                      stroke="#090B10"
                      stroke-width="1.5"
                    />
                  );
                })}

                <!-- Outer Labels -->
                {metrics.map((m) => {
                  const labelPos = getRadarPoint(118, m.angle);
                  const isAbove = m.val > m.avg;
                  return (
                    <text
                      x={labelPos.x}
                      y={labelPos.y + 3}
                      text-anchor="middle"
                      font-size="9"
                      font-family="JetBrains Mono, monospace"
                      font-weight="bold"
                      fill={isAbove ? "#67e8f9" : "#94a3b8"}
                    >
                      {m.label} ({m.val})
                    </text>
                  );
                })}
              </svg>
            </div>

            <!-- Comparison Legend: Archive Benchmark vs This Game -->
            <div class="mt-2.5 flex flex-wrap items-center justify-center gap-4 text-[10px] font-mono-spec">
              <div class="flex items-center gap-1.5 text-slate-400">
