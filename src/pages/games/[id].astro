---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GameCard from "../../components/GameCard.astro";
import { games } from "../../data/games";

export function getStaticPaths() {
  return games.map(game => ({ params: { id: game.id }, props: { game } }));
}

const { game } = Astro.props;

const related = games
  .filter(e => e.id !== game.id)
  .filter(e => e.category === game.category || e.type === game.type)
  .sort((a,b) => b.rating - a.rating)
  .slice(0, 3);

// SVG arc math — r=54, circumference = 2πr ≈ 339.3
const ARC_R   = 54;
const ARC_C   = 2 * Math.PI * ARC_R;
const arcFill = ARC_C * (game.rating / 10);
const arcGap  = ARC_C - arcFill;

// Category gradient
const catGradient: Record<string, { from: string; to: string }> = {
  "Essential Collection": { from: "#06b6d4", to: "#7c3aed" },
  "Must Play":            { from: "#7c3aed", to: "#db2777" },
  "Story Focused":        { from: "#7c3aed", to: "#4338ca" },
  "Open World":           { from: "#059669", to: "#0891b2" },
  "Roguelike":            { from: "#ea580c", to: "#dc2626" },
  "Difficulty":           { from: "#dc2626", to: "#9f1239" },
  "Fakemon":              { from: "#d97706", to: "#b45309" },
  "Competitive":          { from: "#0891b2", to: "#1d4ed8" },
  "Anime Inspired":       { from: "#db2777", to: "#7c3aed" },
  "Historical Classic":   { from: "#92400e", to: "#78350f" },
  "Hidden Gem":           { from: "#059669", to: "#047857" },
  "Experimental":         { from: "#6d28d9", to: "#4c1d95" },
  "Collector Only":       { from: "#374151", to: "#1f2937" },
  "PMD Inspired":         { from: "#0d9488", to: "#134e4a" },
};
const grad = catGradient[game.category] ?? { from: "#334155", to: "#1e293b" };

// Experience scores derived from fields
function storyScore(s: string) {
  if (s.includes("Very Story Heavy")) return 9.5;
  if (s.includes("Story Heavy"))      return 8.5;
  if (s.includes("Good Story"))       return 7.5;
  if (s.includes("Standard"))         return 6.0;
  return 4.0;
}
function difficultyScore(d: string) {
  if (d.includes("Kaizo"))       return 10;
  if (d.includes("Hard Default") && !d.includes("Optional")) return 8.5;
  if (d.includes("Hard"))        return 7.0;
  if (d.includes("Normal"))      return 5.5;
  return 3.0;
}
function lengthScore(l: string) {
  if (l.includes("Huge"))         return 9.5;
  if (l.includes("Long"))         return 7.5;
  if (l.includes("Medium"))       return 6.0;
  if (l.includes("Run-Based"))    return 5.0;
  return 4.0;
}
function replayScore(cat: string) {
  if (cat === "Roguelike")    return 9.5;
  if (cat === "Competitive")  return 8.5;
  if (cat === "Open World")   return 8.0;
  return 5.0;
}

const expScores = [
  { label: "Story",       score: storyScore(game.story),          color: "#c4b5fd" },
  { label: "Difficulty",  score: difficultyScore(game.difficulty), color: "#f87171" },
  { label: "Length",      score: lengthScore(game.length),         color: "#6ee7b7" },
  { label: "Replayability", score: replayScore(game.category),    color: "#67e8f9" },
];

// Arc for experience score (r=28, c≈175.9)
const EXP_R = 28;
const EXP_C = 2 * Math.PI * EXP_R;

const linuxCompatColor =
  game.linuxCompat === "mGBA Ready"    ? { border:"border-emerald-400/30", bg:"bg-emerald-400/10", text:"text-emerald-300" }
  : game.linuxCompat === "Wine / Proton" ? { border:"border-yellow-400/30",  bg:"bg-yellow-400/10",  text:"text-yellow-300"  }
  : { border:"border-slate-700", bg:"bg-slate-900", text:"text-slate-400" };

const tagIcon: Record<string, string> = {
  "New Region":"🗺️","Mega Evolution":"💎","Fakemon":"✨","Difficulty":"⚔️",
  "Roguelike":"🎲","Open World":"🌍","Side Quests":"📋","Battle Frontier":"⚔",
  "QoL":"✅","Post Game":"🏆","Great Story":"📖",
};
---

<BaseLayout title={`${game.name} · ArchiveDex`} description={game.description}>
  <main class="mx-auto max-w-6xl px-6 py-10">

    <!-- Breadcrumb -->
    <div class="mb-6 flex items-center gap-3 text-sm">
      <a href="/library" class="font-black text-cyan-300 transition hover:text-cyan-200">Library</a>
      <span class="text-slate-700">/</span>
      <span class="truncate text-slate-500">{game.name}</span>
    </div>

    <!-- ══════════════════════════════════════ -->
    <!-- HERO                                  -->
    <!-- ══════════════════════════════════════ -->
    <section class="relative overflow-hidden rounded-[2rem] border border-slate-700/60 spotlight-active">
      <!-- Category gradient backdrop at low opacity — shared-element morph target -->
      <div
        class="absolute inset-0"
        style={`background: linear-gradient(135deg, ${grad.from}22, ${grad.to}18, #070914 65%)`}
        transition:name={`cover-${game.id}`}
      ></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_80%_20%,rgba(34,211,238,0.10),transparent_50%)]"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_80%,rgba(168,85,247,0.08),transparent_50%)]"></div>

      <!-- Ambient particles -->
      <div class="particle-field">
        {Array.from({ length: 14 }).map((_, i) => {
          const left = (i * 137.5) % 100;
          const duration = 7 + (i % 5) * 1.4;
          const delay = (i % 7) * -1.3;
          const size = i % 3 === 0 ? "0.65rem" : "0.4rem";
          const glyphs = ["✦","◆","✧","⬡"];
          const glyph = glyphs[i % glyphs.length];
          return (
            <span
              class="particle text-cyan-200"
              style={`left:${left}%; font-size:${size}; --p-duration:${duration}s; --p-delay:${delay}s; --p-opacity:0.35; --p-dx:${(i % 5 - 2) * 14}px;`}
            >{glyph}</span>
          );
        })}
      </div>

      <!-- Cursor spotlight -->
      <div class="spotlight"></div>

      <div class="relative p-7 lg:p-10">
        <!-- Badges -->
        <div class="mb-5 flex flex-wrap gap-2" data-reveal>
          <span class="rounded-full border border-cyan-400/30 bg-cyan-400/10 px-3 py-1 text-xs font-black text-cyan-300">{game.type}</span>
          <span class="rounded-full border border-violet-400/30 bg-violet-400/10 px-3 py-1 text-xs font-black text-violet-300">{game.base}</span>
          <span class="rounded-full border border-emerald-400/30 bg-emerald-400/10 px-3 py-1 text-xs font-black text-emerald-300">{game.status}</span>
          <span
            class="rounded-full border px-3 py-1 text-xs font-black"
            style={`border-color:${grad.from}60; background:${grad.from}18; color:${grad.from}`}
          >{game.category}</span>
        </div>

        <div class="grid gap-8 lg:grid-cols-[1fr_auto]">
          <!-- Left -->
          <div>
            <h1
              class="text-5xl font-black leading-tight tracking-tight text-white md:text-6xl"
              transition:name={`name-${game.id}`}
            >{game.name}</h1>
            <p class="mt-2.5 text-sm text-slate-500" data-reveal style="--reveal-delay:80ms">by <span class="font-bold text-slate-300">{game.creator}</span></p>
            <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-300" data-reveal style="--reveal-delay:140ms">{game.description}</p>

            <!-- CTA row -->
            <div class="mt-7 flex flex-wrap gap-3" data-reveal style="--reveal-delay:200ms">
              {game.officialSource && (
                <a href={game.officialSource} target="_blank" rel="noopener noreferrer"
                   class="magnetic-btn flex items-center gap-2 rounded-2xl border border-emerald-400/30 bg-emerald-400/10 px-5 py-2.5 text-sm font-black text-emerald-300 transition hover:border-emerald-400/50 hover:bg-emerald-400/15">
                  ↗ Official Source
                </a>
              )}
              <button id="add-to-compare" data-game-id={game.id}
                class="magnetic-btn flex items-center gap-2 rounded-2xl border border-cyan-400/30 bg-cyan-400/8 px-5 py-2.5 text-sm font-black text-cyan-300 transition hover:border-cyan-400/50 hover:bg-cyan-400/12">
                ⊕ Compare
              </button>
              <a href="/random"
                 class="magnetic-btn flex items-center gap-2 rounded-2xl border border-slate-700 bg-slate-900/80 px-5 py-2.5 text-sm font-black text-slate-400 transition hover:border-violet-400/50 hover:text-violet-300">
                🎲 Random
              </a>
            </div>
          </div>

          <!-- Right: SVG arc rating -->
          <div
            class="flex flex-col items-center justify-center rounded-2xl border border-yellow-300/20 bg-yellow-300/5 px-8 py-6"
            transition:name={`rating-${game.id}`}
          >
            <svg width="140" height="140" viewBox="0 0 140 140" class="block">
              <defs>
                <linearGradient id="arcGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                  <stop offset="0%"   stop-color="#f59e0b"/>
                  <stop offset="100%" stop-color="#fde047"/>
                </linearGradient>
              </defs>
              <!-- Track -->
              <circle cx="70" cy="70" r={ARC_R} fill="none" stroke="#1e293b" stroke-width="8" />
              <!-- Fill — starts from 12 o'clock (rotate -90deg) -->
              <circle
                cx="70" cy="70" r={ARC_R}
                fill="none"
                stroke="url(#arcGrad)"
                stroke-width="8"
                stroke-linecap="round"
                stroke-dasharray={`${arcFill} ${arcGap}`}
                transform="rotate(-90 70 70)"
                style="filter:drop-shadow(0 0 6px rgba(253,224,71,0.6));--arc-total:339.3;stroke-dashoffset:339.3;animation:arc-fill 1.1s cubic-bezier(0.16,1,0.3,1) 0.15s both;"
              />
              <!-- Center text -->
              <text x="70" y="65" text-anchor="middle" font-size="26" font-weight="900" fill="#fde047" font-family="system-ui, sans-serif" data-counter={game.rating} data-counter-duration="1100">0</text>
              <text x="70" y="82" text-anchor="middle" font-size="10" fill="#92400e" font-family="system-ui, sans-serif" font-weight="700">/ 10</text>
            </svg>
            <div class="mt-2 text-center">
              <div class="text-xs font-black uppercase tracking-widest text-yellow-300/60">Archive Rating</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════ -->
    <!-- TABS                                  -->
    <!-- ══════════════════════════════════════ -->
    <div class="sticky top-[88px] z-30 mt-1 border-b border-slate-800/80 bg-[#070914]/90 backdrop-blur-xl">
      <div class="relative flex gap-0">
        {["Overview","Features","Source Notes","Similar"].map((tab) => (
          <button
            class="tab-btn px-5 py-3.5 text-sm font-black text-slate-500 transition-colors hover:text-slate-300"
            data-tab={tab.toLowerCase().replace(" ","-")}
          >{tab}</button>
        ))}
        <span class="tab-indicator" id="tab-indicator"></span>
      </div>
    </div>

    <!-- ══════════════════════════════════════ -->
    <!-- TAB: OVERVIEW                         -->
    <!-- ══════════════════════════════════════ -->
    <div id="tab-overview" class="tab-panel mt-8">
      <!-- Why it matters -->
      <div class="mb-6 rounded-2xl border-l-4 border-cyan-400/70 bg-slate-950/60 p-6 backdrop-blur-sm ring-1 ring-slate-700/40" data-reveal>
        <p class="mb-2 text-xs font-black uppercase tracking-[0.28em] text-cyan-300">Why it matters</p>
        <p class="leading-7 text-slate-300">{game.whyItMatters}</p>
      </div>

      <!-- Experience scores -->
      <div class="mb-6 rounded-2xl border border-slate-700/60 bg-slate-950/60 p-6" data-reveal style="--reveal-delay:60ms">
        <p class="mb-5 text-xs font-black uppercase tracking-[0.28em] text-slate-500">Experience Scores</p>
        <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
          {expScores.map(({ label, score, color }) => {
            const fill = EXP_C * (score / 10);
            const gap  = EXP_C - fill;
            return (
              <div class="flex flex-col items-center gap-2">
                <svg width="80" height="80" viewBox="0 0 80 80">
                  <circle cx="40" cy="40" r={EXP_R} fill="none" stroke="#1e293b" stroke-width="6"/>
                  <circle cx="40" cy="40" r={EXP_R} fill="none" stroke={color} stroke-width="6"
                    stroke-linecap="round" stroke-dasharray={`${fill} ${gap}`}
                    transform="rotate(-90 40 40)"
                    style={`filter:drop-shadow(0 0 4px ${color}66);--arc-total:${EXP_C};stroke-dashoffset:${EXP_C};animation:arc-fill 0.9s cubic-bezier(0.16,1,0.3,1) 0.2s both;`}
                  />
                  <text x="40" y="44" text-anchor="middle" font-size="15" font-weight="900" fill={color} font-family="system-ui,sans-serif" data-counter={score} data-counter-duration="900">0</text>
                </svg>
                <span class="text-xs font-black text-slate-400">{label}</span>
              </div>
            );
          })}
        </div>
      </div>

      <!-- Best for / Avoid if -->
      <div class="grid gap-4 md:grid-cols-2" data-reveal style="--reveal-delay:100ms">
        <div class="rounded-2xl border border-emerald-400/20 bg-emerald-400/5 p-5">
          <p class="mb-3 text-xs font-black uppercase tracking-[0.28em] text-emerald-300">Best For</p>
          <ul class="space-y-2">
            {game.bestFor.map((item: string) => (
              <li class="flex items-start gap-2.5 text-sm leading-6 text-slate-300">
                <span class="mt-0.5 shrink-0 font-black text-emerald-400">✦</span>{item}
              </li>
            ))}
          </ul>
        </div>
        <div class="rounded-2xl border border-red-400/20 bg-red-400/5 p-5">
          <p class="mb-3 text-xs font-black uppercase tracking-[0.28em] text-red-400">Avoid If</p>
          <ul class="space-y-2">
            {game.avoidIf.map((item: string) => (
              <li class="flex items-start gap-2.5 text-sm leading-6 text-slate-300">
                <span class="mt-0.5 shrink-0 font-black text-red-500">✕</span>{item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <!-- ══════════════════════════════════════ -->
    <!-- TAB: FEATURES                         -->
    <!-- ══════════════════════════════════════ -->
    <div id="tab-features" class="tab-panel mt-8 hidden">

      <!-- Tags -->
      <div class="mb-5 rounded-2xl border border-slate-700/60 bg-slate-950/60 p-6">
        <p class="mb-4 text-xs font-black uppercase tracking-[0.28em] text-slate-500">Feature Tags</p>
        <div class="flex flex-wrap gap-2">
          {game.tags.map((tag: string) => {
            const icon = tagIcon[tag] ?? "▸";
            return (
              <a href={`/library?tag=${encodeURIComponent(tag)}`}
                 class="flex items-center gap-1.5 rounded-full border border-cyan-400/25 bg-cyan-400/8 px-4 py-2 text-sm font-bold text-cyan-300 transition hover:border-cyan-400/50 hover:bg-cyan-400/14">
                <span>{icon}</span>{tag}
              </a>
            );
          })}
        </div>
      </div>

      <!-- Mood -->
      <div class="mb-5 rounded-2xl border border-slate-700/60 bg-slate-950/60 p-6">
        <p class="mb-4 text-xs font-black uppercase tracking-[0.28em] text-slate-500">Mood</p>
        <div class="flex flex-wrap gap-2">
          {game.mood.map((m: string) => (
            <a href={`/library?mood=${encodeURIComponent(m)}`}
               class="rounded-full border border-violet-400/30 bg-violet-400/10 px-4 py-2 text-sm font-bold text-violet-300 transition hover:border-violet-400/50 hover:bg-violet-400/18">
              {m}
            </a>
          ))}
        </div>
      </div>

      <!-- Quick facts grid -->
      <div class="rounded-2xl border border-slate-700/60 bg-slate-950/60 p-6">
        <p class="mb-4 text-xs font-black uppercase tracking-[0.28em] text-slate-500">Quick Facts</p>
        <dl class="grid gap-3 sm:grid-cols-2">
          {[
            { label:"Creator",    value: game.creator    },
            { label:"Runtime",    value: game.runtime    },
            { label:"Base Game",  value: game.base       },
            { label:"Length",     value: game.length     },
            { label:"Difficulty", value: game.difficulty },
            { label:"Grinding",   value: game.grind      },
            { label:"Story",      value: game.story      },
            { label:"Dex Style",  value: game.dex        },
          ].map(({ label, value }) => (
            <div class="flex items-center justify-between rounded-xl border border-slate-800/80 bg-slate-900/50 px-4 py-2.5">
              <dt class="text-xs text-slate-500">{label}</dt>
              <dd class="text-sm font-bold text-slate-200">{value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>

    <!-- ══════════════════════════════════════ -->
    <!-- TAB: SOURCE NOTES                     -->
    <!-- ══════════════════════════════════════ -->
    <div id="tab-source-notes" class="tab-panel mt-8 hidden">
      <div class="rounded-2xl border border-slate-700/60 bg-slate-950/60 p-7">
        <p class="mb-6 text-xs font-black uppercase tracking-[0.28em] text-slate-500">Source Information</p>

        <!-- Trust level badge -->
        <div class="mb-5 flex items-center gap-3">
          <span class="text-sm text-slate-500">Source Status:</span>
          <span class={`rounded-full border px-3 py-1 text-sm font-black ${
            game.sourceStatus.includes("Safe")    ? "border-emerald-400/30 bg-emerald-400/10 text-emerald-300" :
            game.sourceStatus.includes("Caution") ? "border-yellow-400/30 bg-yellow-400/10 text-yellow-300"   :
            game.sourceStatus.includes("Scan")    ? "border-orange-400/30 bg-orange-400/10 text-orange-300"   :
                                                    "border-slate-700 bg-slate-900 text-slate-400"
          }`}>
            {game.sourceStatus.includes("Safe")    ? "✅ " : game.sourceStatus.includes("Caution") ? "⚠️ " : game.sourceStatus.includes("Scan") ? "🔍 " : ""}
            {game.sourceStatus}
          </span>
        </div>

        <!-- Linux compat -->
        <div class="mb-5 flex items-center gap-3">
          <span class="text-sm text-slate-500">Linux Compat:</span>
          <span class={`rounded-full border px-3 py-1 text-sm font-black ${linuxCompatColor.border} ${linuxCompatColor.bg} ${linuxCompatColor.text}`}>
            {game.linuxCompat === "mGBA Ready" ? "🐧 mGBA Ready" : game.linuxCompat === "Wine / Proton" ? "🍷 Wine / Proton" : game.linuxCompat}
          </span>
        </div>

        <!-- Official source link -->
        {game.officialSource ? (
          <a href={game.officialSource} target="_blank" rel="noopener noreferrer"
             class="mt-4 flex items-center justify-center gap-2 rounded-2xl border border-emerald-400/30 bg-emerald-400/10 py-3.5 text-sm font-black text-emerald-300 transition hover:border-emerald-400/50 hover:bg-emerald-400/15">
            ↗ Visit Official Source
          </a>
        ) : (
          <div class="mt-4 rounded-2xl border border-slate-700/60 bg-slate-900/60 py-3.5 text-center text-sm text-slate-600">
            No official source listed
          </div>
        )}

        <p class="mt-5 text-xs leading-5 text-slate-600">
          ArchiveDex does not host ROMs or prepatched files. Always download from official community sources.
          Check <a href="/source-notes" class="text-cyan-400 hover:text-cyan-300">Source Notes</a> for full trust level definitions.
        </p>
      </div>
    </div>

    <!-- ══════════════════════════════════════ -->
    <!-- TAB: SIMILAR                          -->
    <!-- ══════════════════════════════════════ -->
    <div id="tab-similar" class="tab-panel mt-8 hidden">
      {related.length > 0 ? (
        <div class="grid gap-4 md:grid-cols-3">
          {related.map(entry => <GameCard game={entry} />)}
        </div>
      ) : (
        <div class="rounded-2xl border border-slate-700/60 bg-slate-950/60 p-12 text-center">
          <div class="mb-3 text-4xl opacity-20">◈</div>
          <p class="text-lg font-black text-white">No similar entries found</p>
          <a href="/library" class="mt-4 inline-block text-sm font-black text-cyan-300 hover:text-cyan-200">Browse the full library →</a>
        </div>
      )}
    </div>

  </main>
</BaseLayout>

<style>
  .tab-btn.active { color: #f8fafc; }
</style>

<script>
  function initDetailPage() {
    // Guard: this listener is bound once to `document` via astro:page-load
    // (see bottom of this script) and, once bound, fires on every future
    // navigation site-wide — not just re-visits to a detail page. Without
    // this check, ".tab-btn"/".tab-panel"/".spotlight-active" below (class
    // names also used by library.astro's tag/mood tabs and index.astro's
    // hero panel) would match on OTHER pages too, adding duplicate/incorrect
    // listeners there. Bail out immediately unless we're actually on a game
    // detail page.
    if (!document.getElementById("add-to-compare")) return;

    // ── Tab switcher with sliding indicator ──────────────────
    const tabBtns    = Array.from(document.querySelectorAll<HTMLButtonElement>(".tab-btn"));
    const tabPanels  = Array.from(document.querySelectorAll<HTMLElement>(".tab-panel"));
    const indicator  = document.getElementById("tab-indicator");

    function moveIndicator(btn: HTMLButtonElement) {
      if (!indicator) return;
      indicator.style.width     = `${btn.offsetWidth}px`;
      indicator.style.transform = `translateX(${btn.offsetLeft}px)`;
    }

    function activateTab(tabId: string, opts: { instant?: boolean } = {}) {
      const activeBtn = tabBtns.find(b => b.dataset.tab === tabId);
      tabBtns.forEach(btn => btn.classList.toggle("active", btn === activeBtn));
      tabPanels.forEach(panel => {
        const match = panel.id === `tab-${tabId}`;
        const wasHidden = panel.classList.contains("hidden");
        panel.classList.toggle("hidden", !match);
        if (match && wasHidden) {
          // Retrigger the entrance animation every time a hidden panel opens
          panel.classList.remove("tab-panel-enter");
          void panel.offsetWidth; // force reflow to restart the keyframe
          panel.classList.add("tab-panel-enter");
        }
      });
      if (activeBtn) {
        if (opts.instant && indicator) indicator.style.transition = "none";
        moveIndicator(activeBtn);
        if (opts.instant && indicator) requestAnimationFrame(() => { indicator.style.transition = ""; });
      }
    }

    tabBtns.forEach(btn => {
      btn.addEventListener("click", () => activateTab(btn.dataset.tab!));
    });

    // Activate first tab on load — instant indicator placement, no slide-in from 0
    activateTab("overview", { instant: true });

    // Keep indicator aligned on resize (tab widths can reflow)
    window.addEventListener("resize", () => {
      const active = tabBtns.find(b => b.classList.contains("active"));
      if (active) moveIndicator(active);
    });

    // ── Compare button ────────────────────────────────────────
    const compareBtn = document.getElementById("add-to-compare");
    compareBtn?.addEventListener("click", () => {
      const id = (compareBtn as HTMLButtonElement).dataset.gameId;
      if (!id) return;
      let existing: string[] = [];
      try { existing = JSON.parse(sessionStorage.getItem("archivedex_compare") ?? "[]"); } catch {}
      if (!existing.includes(id)) existing.push(id);
      existing = existing.slice(0, 3);
      sessionStorage.setItem("archivedex_compare", JSON.stringify(existing));
      window.location.href = `/compare?games=${existing.join(",")}`;
    });

    // ── Cursor spotlight on hero ───────────────────────────────
    const hero = document.querySelector<HTMLElement>(".spotlight-active");
    hero?.addEventListener("mousemove", (e) => {
      const rect = hero.getBoundingClientRect();
      hero.style.setProperty("--mx", `${e.clientX - rect.left}px`);
      hero.style.setProperty("--my", `${e.clientY - rect.top}px`);
    });
  }

  document.addEventListener("astro:page-load", initDetailPage);
</script>
