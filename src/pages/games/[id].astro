<script>
  function initStickySubheader() {
    const subheader = document.getElementById("sticky-record-bar");
    const trigger = document.getElementById("record-hero-trigger");
    if (!subheader || !trigger) return;

    const scrollTarget = document.getElementById("main-scroll-container") || window;

    function handleScroll() {
      const rect = trigger.getBoundingClientRect();
      const show = rect.bottom < 80;
      subheader.classList.toggle("hidden", !show);
    }

    scrollTarget.addEventListener("scroll", handleScroll, { passive: true });
    window.addEventListener("scroll", handleScroll, { passive: true });
  }

  function initRecommendationTabs() {
    const tabs = document.querySelectorAll<HTMLButtonElement>(".rec-tab-btn");
    const panels = document.querySelectorAll<HTMLElement>(".rec-panel");

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const targetId = tab.dataset.target;
        if (!targetId) return;

        tabs.forEach((t) => {
          t.classList.remove("active-rec-tab");
          t.classList.add("text-slate-400");
        });

        tab.classList.add("active-rec-tab");
        tab.classList.remove("text-slate-400");

        panels.forEach((p) => {
          if (p.id === targetId) {
            p.classList.remove("hidden");
          } else {
            p.classList.add("hidden");
          }
        });
      });
    });
  }

  function initRomHashVerifier() {
    const box = document.getElementById("rom-verifier-box");
    const input = document.getElementById("rom-file-input") as HTMLInputElement;
    const output = document.getElementById("rom-verify-output");
    if (!box || !input || !output) return;

    const baseGame = (box.dataset.base || "").toLowerCase();

    async function handleFile(file: File) {
      if (!file) return;
      output.classList.remove("hidden");
      output.innerHTML = `
        <div class="flex items-center gap-2 text-slate-400 animate-pulse py-1">
          <span>⏳</span> Computing SHA-1 checksum for <strong>${file.name}</strong> (${(file.size / (1024 * 1024)).toFixed(2)} MB)…
        </div>
      `;

      try {
        const buffer = await file.arrayBuffer();
        const hashBuf = await crypto.subtle.digest("SHA-1", buffer);
        const hashArr = Array.from(new Uint8Array(hashBuf));
        const hashHex = hashArr.map((b) => b.toString(16).padStart(2, "0")).join("");

        const KNOWN: Record<string, { name: string; sha1: string }> = {
          "firered": { name: "1636 - Pokémon FireRed (USA) v1.0", sha1: "41cb23d8dccc8ebd7ea649cd8daac582d6e174c4" },
          "emerald": { name: "1986 - Pokémon Emerald (USA)", sha1: "f3ae088181bf583e55daf962a92bb46f4f1d07b7" },
          "ruby": { name: "0907 - Pokémon Ruby (USA)", sha1: "f56b0253459c2c62c2409f6e14a51ebcf40d99c7" },
          "crystal": { name: "Pokémon Crystal (USA/Europe)", sha1: "f4cd194b3f2d586370bbbaaa97210b4279c6d480" },
          "red": { name: "Pokémon Red (USA/Europe)", sha1: "ea9bcae617fdf159b045185467ae58b2e4a48b9a" },
          "platinum": { name: "3541 - Pokémon Platinum (USA)", sha1: "6a24177242ba4e12e1ffb15beaa067ff2c219666" },
          "heartgold": { name: "4788 - Pokémon HeartGold (USA)", sha1: "3c09b840003b51b3ce99180fce3ee72465eb19d4" },
          "black 2": { name: "6149 - Pokémon Black Version 2 (USA)", sha1: "5b184fc04d80980fa2a884da59d9c286e685f4c5" }
        };

        const isV11 = hashHex === "dd346299b9cf2a567675e810ebc281df6f50b4d4";
        const expected = Object.entries(KNOWN).find(([k]) => baseGame.includes(k))?.[1];

        if (expected && expected.sha1 === hashHex) {
          output.innerHTML = `
            <div class="rounded-xl border border-emerald-400/30 bg-emerald-500/10 p-3 text-emerald-300">
              <div class="flex items-center gap-2 font-black">
                <span>✓</span> MATCH VERIFIED: Perfect Clean Base ROM
              </div>
              <div class="mt-1 text-[11px] text-slate-300">
                Matches <strong>${expected.name}</strong>. Safe to apply official creator patch files (.ups / .bps).
              </div>
              <div class="mt-1.5 text-[10px] font-mono text-emerald-400/80">SHA-1: ${hashHex}</div>
            </div>
          `;
        } else if (isV11) {
          output.innerHTML = `
            <div class="rounded-xl border border-amber-400/30 bg-amber-500/10 p-3 text-amber-300">
              <div class="flex items-center gap-2 font-black">
                <span>⚠️</span> REVISION WARNING: FireRed v1.1 Detected
              </div>
              <div class="mt-1 text-[11px] text-slate-300">
                You provided FireRed Rev 1 (v1.1). Almost all GBA ROM hacks require <strong>1636 - FireRed v1.0</strong> to avoid graphical glitches and freeze bugs.
              </div>
              <div class="mt-1.5 text-[10px] font-mono text-amber-400/80">SHA-1: ${hashHex}</div>
            </div>
          `;
        } else {
          output.innerHTML = `
            <div class="rounded-xl border border-white/[0.1] bg-[#161B29] p-3 text-slate-300">
              <div class="font-bold text-white flex items-center justify-between">
                <span>Checksum Computed:</span>
                <span class="text-cyan-300 font-mono">${(file.size / (1024 * 1024)).toFixed(2)} MB</span>
              </div>
              <div class="mt-1 text-[11px] font-mono break-all text-slate-400">SHA-1: <span class="text-cyan-200">${hashHex}</span></div>
              ${expected ? `<div class="mt-1.5 text-[10px] text-slate-500">Expected for ${expected.name}: <span class="font-mono text-slate-400">${expected.sha1}</span></div>` : ""}
            </div>
          `;
        }
      } catch (err: any) {
        output.innerHTML = `<div class="text-red-400">Error reading file: ${err.message}</div>`;
      }
    }

    input.addEventListener("change", () => {
      if (input.files && input.files[0]) handleFile(input.files[0]);
    });

    box.addEventListener("dragover", (e) => {
      e.preventDefault();
      box.classList.add("border-cyan-400", "bg-cyan-500/[0.05]");
    });
    box.addEventListener("dragleave", () => {
      box.classList.remove("border-cyan-400", "bg-cyan-500/[0.05]");
    });
    box.addEventListener("drop", (e) => {
      e.preventDefault();
      box.classList.remove("border-cyan-400", "bg-cyan-500/[0.05]");
      if (e.dataTransfer && e.dataTransfer.files[0]) {
        handleFile(e.dataTransfer.files[0]);
      }
    });
  }

  function initGameRecord() {
    initStickySubheader();
    initRecommendationTabs();
    initRomHashVerifier();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initGameRecord);
  } else {
    initGameRecord();
  }
  document.addEventListener("astro:page-load", initGameRecord);
</script>
