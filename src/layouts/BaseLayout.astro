    <!-- CORE SCRIPT: THEMES, MODALS, STATE, SPOTLIGHT  -->
    <!-- ═══════════════════════════════════════════════ -->
    <script>
      // ── Pokédex & Card Theme Switcher ───────────────
      function initThemeSwitcher() {
        const themeBtn = document.getElementById("theme-dropdown-btn");
        const themeMenu = document.getElementById("theme-menu");
        const labelEl = document.getElementById("theme-active-label");

        const themeLabels: Record<string, string> = {
          cosmic: "Cosmic Cyan & Violet",
          atomic: "Atomic Purple & Rose",
          emerald: "Emerald & Sky Teal",
          firered: "FireRed & Amber",
          gold: "Solar Gold & Silver",
          sapphire: "Abyssal Sapphire & Aqua",
          pokeball: "Pokéball Contrast",
        };

        const cardThemeLabels: Record<string, string> = {
          holo: "Holo Neo",
          retro: "Retro Cartridge",
          monolith: "Monolith Obsidian",
        };

        function updateThemeOptionsUI(theme: string) {
          if (labelEl) labelEl.textContent = themeLabels[theme] || "Theme";
          document.querySelectorAll<HTMLButtonElement>(".theme-option").forEach((btn) => {
            const isActive = btn.dataset.setTheme === theme;
            btn.classList.toggle("bg-white/10", isActive);
            btn.classList.toggle("ring-1", isActive);
            btn.classList.toggle("ring-white/20", isActive);
          });
        }

        function updateCardThemeUI(cardTheme: string) {
          document.querySelectorAll<HTMLButtonElement>(".card-theme-option").forEach((btn) => {
            const isActive = btn.dataset.setCardTheme === cardTheme;
            btn.classList.toggle("bg-white/10", isActive);
            btn.classList.toggle("border-cyan-400/40", isActive);
          });
        }

        const currentTheme = localStorage.getItem("archivedex_theme") || "cosmic";
        updateThemeOptionsUI(currentTheme);

        const currentCardTheme = localStorage.getItem("archivedex_card_theme") || "holo";
        updateCardThemeUI(currentCardTheme);

        if (themeBtn) {
          themeBtn.onclick = (e) => {
            e.stopPropagation();
            themeMenu?.classList.toggle("hidden");
          };
        }

        // Pokédex hue options
        document.querySelectorAll<HTMLButtonElement>(".theme-option").forEach((btn) => {
          btn.onclick = () => {
            const theme = btn.dataset.setTheme || "cosmic";
            document.documentElement.setAttribute("data-theme", theme);
            document.body.setAttribute("data-theme", theme);
            localStorage.setItem("archivedex_theme", theme);
            updateThemeOptionsUI(theme);
            themeMenu?.classList.add("hidden");
            (window as any).showToast?.(`Pokédex theme set to ${themeLabels[theme]}`, "info");
          };
        });

        // Card view theme options
        document.querySelectorAll<HTMLButtonElement>(".card-theme-option").forEach((btn) => {
          btn.onclick = () => {
            const theme = btn.dataset.setCardTheme || "holo";
            document.documentElement.setAttribute("data-card-theme", theme);
            document.body.setAttribute("data-card-theme", theme);
            localStorage.setItem("archivedex_card_theme", theme);
            updateCardThemeUI(theme);
            themeMenu?.classList.add("hidden");
            window.dispatchEvent(new CustomEvent("archivedex:card-theme-change", { detail: { theme } }));
            (window as any).showToast?.(`Card style set to ${cardThemeLabels[theme] || theme}`, "info");
          };
        });

        if (!(window as any).__themeMenuDocBound) {
          (window as any).__themeMenuDocBound = true;
          document.addEventListener("click", () => {
            document.getElementById("theme-menu")?.classList.add("hidden");
          });
        }
      }

      // ── Left Rail Collapse & Mobile Drawer ───────────
      function initLeftRail() {
        const sidebar = document.getElementById("launcher-sidebar");
        const toggleBtn = document.getElementById("toggle-left-rail-btn");
        const collapseBtn = document.getElementById("collapse-left-rail-btn");
        const openMobileBtn = document.getElementById("open-mobile-rail");
        const closeMobileBtn = document.getElementById("close-mobile-rail");
        const backdrop = document.getElementById("mobile-rail-backdrop");

        function openMobile() {
          const rail = document.getElementById("launcher-sidebar");
          rail?.classList.remove("-translate-x-full");
          backdrop?.classList.remove("hidden");
        }
        function closeMobile() {
          const rail = document.getElementById("launcher-sidebar");
          rail?.classList.add("-translate-x-full");
          backdrop?.classList.add("hidden");
        }

        if (openMobileBtn) openMobileBtn.onclick = openMobile;
        if (closeMobileBtn) closeMobileBtn.onclick = closeMobile;
        if (backdrop) backdrop.onclick = closeMobile;

        // Desktop collapse state from localStorage
        const savedCollapsed = localStorage.getItem("archivedex_left_rail_collapsed");
        if (savedCollapsed === "true" && sidebar) {
          sidebar.classList.add("is-collapsed");
        }

        function toggleDesktopCollapse() {
          const rail = document.getElementById("launcher-sidebar");
          if (!rail) return;
          const isCollapsed = rail.classList.toggle("is-collapsed");
          localStorage.setItem("archivedex_left_rail_collapsed", isCollapsed ? "true" : "false");
          (window as any).showToast?.(isCollapsed ? "Launcher Rail collapsed (⌘B)" : "Launcher Rail expanded (⌘B)", "info");
        }

        if (toggleBtn) {
          toggleBtn.onclick = (e) => {
            e.stopPropagation();
            const rail = document.getElementById("launcher-sidebar");
            if (window.innerWidth < 768) {
              rail?.classList.contains("-translate-x-full") ? openMobile() : closeMobile();
            } else {
              toggleDesktopCollapse();
            }
          };
        }

        if (collapseBtn) {
          collapseBtn.onclick = (e) => {
            e.stopPropagation();
            toggleDesktopCollapse();
          };
        }

        // Keyboard shortcut: ⌘B or Ctrl+B bound once globally
        if (!(window as any).__leftRailShortcutBound) {
          (window as any).__leftRailShortcutBound = true;
          document.addEventListener("keydown", (e) => {
            if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "b") {
              e.preventDefault();
              const rail = document.getElementById("launcher-sidebar");
              if (window.innerWidth < 768) {
                rail?.classList.contains("-translate-x-full") ? openMobile() : closeMobile();
              } else {
                toggleDesktopCollapse();
              }
            }
          });
        }
      }

      // ── Dynamic Route Navigation Highlight ─────────────
      function updateActiveNav() {
        const path = window.location.pathname.replace(/\/$/, "") || "/";
        const navLinks = document.querySelectorAll<HTMLAnchorElement>("#launcher-sidebar nav a.nav-item-link");
        navLinks.forEach((a) => {
          const href = a.getAttribute("href")?.replace(/\/$/, "") || "/";
          let isActive = false;
          if (href === "/") {
            isActive = path === "/";
          } else if (href === "/library") {
            isActive = path === "/library" || path.startsWith("/games");
          } else {
            isActive = path === href || path.startsWith(href);
          }

          if (isActive) {
            a.classList.add("theme-pill", "font-black", "shadow-[0_0_15px_var(--accent-glow)]");
            a.classList.remove("text-slate-400", "hover:bg-[#1E2538]", "hover:text-white");
            a.setAttribute("aria-current", "page");
          } else {
            a.classList.remove("theme-pill", "font-black", "shadow-[0_0_15px_var(--accent-glow)]");
            a.classList.add("text-slate-400", "hover:bg-[#1E2538]", "hover:text-white");
            a.removeAttribute("aria-current");
          }
        });

        // Also highlight curated category route if search param matches
        const currentCategory = new URLSearchParams(window.location.search).get("category");
        document.querySelectorAll<HTMLAnchorElement>("#launcher-sidebar a[href*='category=']").forEach((a) => {
          const url = new URL(a.href, window.location.origin);
          const cat = url.searchParams.get("category");
          if (currentCategory && cat && currentCategory === cat) {
            a.classList.add("bg-[#1E2538]", "text-cyan-300", "font-black");
            a.classList.remove("text-slate-400");
          } else {
            a.classList.remove("bg-[#1E2538]", "text-cyan-300", "font-black");
            a.classList.add("text-slate-400");
          }
        });
      }
      (window as any).updateActiveNav = updateActiveNav;

      // ── Right Activity Rail (Wide Screen Default & Collapse) ──
      function initRightRail() {
        const rightRail = document.getElementById("home-right-rail");
        const toggleBtn = document.getElementById("toggle-right-rail-btn");
        const collapseBtn = document.getElementById("collapse-right-rail-btn");
        const dot = document.getElementById("right-rail-dot");

        if (!rightRail) return;

        // Wide-screen default logic:
        // >= 1440px resolution on Home defaults to 3-column mode (Right Rail open)
        // Interior pages default to collapsed to maximize workspace
        const savedState = localStorage.getItem("archivedex_right_rail_state");
        let shouldBeOpen = false;

        const isHome = window.location.pathname === "/" || window.location.pathname === "";
        if (savedState === "open") {
          shouldBeOpen = true;
        } else if (savedState === "collapsed") {
          shouldBeOpen = false;
        } else {
          shouldBeOpen = isHome && window.innerWidth >= 1440;
        }

        function applyRightRailState(open: boolean) {
          const rail = document.getElementById("home-right-rail");
          const d = document.getElementById("right-rail-dot");
          if (!rail) return;
          if (open) {
            rail.classList.remove("is-collapsed");
            d?.classList.remove("bg-slate-600", "shadow-none");
            d?.classList.add("bg-cyan-400", "shadow-[0_0_8px_#22d3ee]");
          } else {
            rail.classList.add("is-collapsed");
            d?.classList.remove("bg-cyan-400", "shadow-[0_0_8px_#22d3ee]");
            d?.classList.add("bg-slate-600", "shadow-none");
          }
        }

        applyRightRailState(shouldBeOpen);

        function toggleRightRail() {
          const rail = document.getElementById("home-right-rail");
          if (!rail) return;
          const isCurrentlyCollapsed = rail.classList.contains("is-collapsed");
          const nextOpen = isCurrentlyCollapsed; // if collapsed, next is open
          applyRightRailState(nextOpen);
          localStorage.setItem("archivedex_right_rail_state", nextOpen ? "open" : "collapsed");
          (window as any).showToast?.(nextOpen ? "Activity Feed expanded" : "Activity Feed collapsed", "info");
        }

        // Direct property assignment prevents duplicate listener stacking
        if (toggleBtn) {
          toggleBtn.onclick = (e) => {
            e.stopPropagation();
            toggleRightRail();
          };
        }
        if (collapseBtn) {
          collapseBtn.onclick = (e) => {
            e.stopPropagation();
            toggleRightRail();
          };
        }

        // Responsive resize listener: bound only once globally
        if (!(window as any).__rightRailResizeBound) {
          (window as any).__rightRailResizeBound = true;
          window.addEventListener("resize", () => {
            if (!localStorage.getItem("archivedex_right_rail_state")) {
              const onHome = window.location.pathname === "/" || window.location.pathname === "";
              applyRightRailState(onHome && window.innerWidth >= 1440);
            }
          });
        }
      }
      (window as any).initRightRail = initRightRail;
      (window as any).initLeftRail = initLeftRail;

      // ── Command Palette (⌘K) ─────────────────────────
      let cachedGamesList: any[] = [];
      async function getGamesList() {
        if (!cachedGamesList.length) {
          try {
            cachedGamesList = await fetch("/data/games.json").then((r) => r.json());
          } catch (e) {
            cachedGamesList = [];
          }
        }
        return cachedGamesList;
      }

      function initCommandPalette() {
        const modal = document.getElementById("cmd-k-modal");
        const trigger = document.getElementById("cmd-k-trigger");
        const input = document.getElementById("cmd-k-input") as HTMLInputElement;
        const results = document.getElementById("cmd-k-results");

        function open() {
          modal?.classList.remove("hidden");
          modal?.classList.add("flex");
          input?.focus();
          getGamesList();
        }
        function close() {
          modal?.classList.add("hidden");
          modal?.classList.remove("flex");
          if (input) input.value = "";
        }

        trigger?.addEventListener("click", open);

        document.addEventListener("keydown", (e) => {
          if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
            e.preventDefault();
            modal?.classList.contains("hidden") ? open() : close();
          }
          if (e.key === "Escape" && !modal?.classList.contains("hidden")) {
            close();
          }
        });

        modal?.addEventListener("click", (e) => {
          if (e.target === modal) close();
        });

        let currentMatches: any[] = [];
        let activeIndex = 0;

        function updateSelection() {
          if (!results) return;
          const items = results.querySelectorAll<HTMLAnchorElement>(".cmd-k-item");
          items.forEach((item, idx) => {
            if (idx === activeIndex) {
              item.classList.add("bg-[#1E2538]", "border-cyan-400/40");
              item.classList.remove("border-transparent");
              item.scrollIntoView({ block: "nearest" });
            } else {
              item.classList.remove("bg-[#1E2538]", "border-cyan-400/40");
              item.classList.add("border-transparent");
            }
          });
        }

        input?.addEventListener("keydown", (e) => {
          if (e.key === "ArrowDown") {
            e.preventDefault();
            if (currentMatches.length > 0) {
              activeIndex = (activeIndex + 1) % currentMatches.length;
              updateSelection();
            }
          } else if (e.key === "ArrowUp") {
            e.preventDefault();
            if (currentMatches.length > 0) {
              activeIndex = (activeIndex - 1 + currentMatches.length) % currentMatches.length;
              updateSelection();
            }
          } else if (e.key === "Enter") {
            e.preventDefault();
            if (currentMatches.length > 0 && currentMatches[activeIndex]) {
              window.location.href = `/games/${currentMatches[activeIndex].id}`;
            }
          }
        });

        input?.addEventListener("input", async () => {
          const q = input.value.toLowerCase().trim();
          if (!q) {
            currentMatches = [];
            activeIndex = 0;
            if (results) results.innerHTML = `<div class="p-4 text-center text-xs text-slate-500 font-mono-spec">Type to search across 632 Pokémon games and developer tools…</div>`;
            return;
          }

          const games = await getGamesList();
          const matches = games.filter((g: any) =>
            g.name.toLowerCase().includes(q) ||
            g.creator.toLowerCase().includes(q) ||
            g.tags.some((t: string) => t.toLowerCase().includes(q.replace("#", ""))) ||
            g.category.toLowerCase().includes(q)
          ).slice(0, 8);

          currentMatches = matches;
          activeIndex = 0;

          if (!matches.length) {
            if (results) results.innerHTML = `<div class="p-6 text-center text-xs text-slate-500 font-mono-spec">No matches for "${q}"</div>`;
            return;
          }

          if (results) {
            results.innerHTML = matches.map((g: any, i: number) => `
              <a href="/games/${g.id}" class="cmd-k-item border flex items-center justify-between rounded-xl px-3 py-2.5 transition group ${i === 0 ? "bg-[#1E2538] border-cyan-400/40" : "border-transparent hover:bg-[#1E2538]"}">
                <div class="flex items-center gap-3">
                  <span class="rounded bg-black/40 px-1.5 py-0.5 text-[10px] font-mono-spec font-bold text-cyan-300">${g.runtime}</span>
                  <div>
                    <div class="text-xs font-bold text-white group-hover:text-cyan-200">${g.name}</div>
                    <div class="text-[10px] text-slate-500">${g.creator || "Community"} · ${g.category}</div>
                  </div>
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-xs font-mono-spec text-yellow-300 font-bold">${g.rating}</span>
                  <span class="text-xs text-slate-600">→</span>
                </div>
              </a>
            `).join("");
          }
        });
      }

      // ── Pokéball Gacha Randomizer ────────────────────
      function initGacha() {
        const modal = document.getElementById("gacha-modal");
        const openBtn = document.getElementById("open-gacha-btn");
        const closeBtn = document.getElementById("close-gacha-btn");
        const spinBtn = document.getElementById("spin-gacha-btn");
        const ball = document.getElementById("gacha-ball");
        const statusMsg = document.getElementById("gacha-status-msg");
        const resultCard = document.getElementById("gacha-result");

        let lockGBA = false;
        let lockComplete = false;
        let lockRated = false;

        const gbaBtn = document.getElementById("gacha-lock-gba");
        const completeBtn = document.getElementById("gacha-lock-complete");
        const ratedBtn = document.getElementById("gacha-lock-rated");

        function togglePill(btn: HTMLElement | null, active: boolean, label: string) {
          if (!btn) return;
          btn.classList.toggle("bg-cyan-500/20", active);
          btn.classList.toggle("border-cyan-400", active);
          btn.classList.toggle("text-cyan-200", active);
        }

        gbaBtn?.addEventListener("click", () => {
          lockGBA = !lockGBA;
          togglePill(gbaBtn, lockGBA, "GBA Only");
        });
        completeBtn?.addEventListener("click", () => {
          lockComplete = !lockComplete;
          togglePill(completeBtn, lockComplete, "Complete Only");
        });
        ratedBtn?.addEventListener("click", () => {
          lockRated = !lockRated;
          togglePill(ratedBtn, lockRated, "Rating 9.0+");
        });

        function open() {
          modal?.classList.remove("hidden");
          modal?.classList.add("flex");
          getGamesList();
        }
        function close() {
          modal?.classList.add("hidden");
          modal?.classList.remove("flex");
        }

        openBtn?.addEventListener("click", open);
        closeBtn?.addEventListener("click", close);
        modal?.addEventListener("click", (e) => {
          if (e.target === modal) close();
        });

        async function roll() {
          const list = await getGamesList();
          let pool = list;
          if (lockGBA) pool = pool.filter((g: any) => g.runtime === "GBA");
          if (lockComplete) pool = pool.filter((g: any) => g.status === "Complete");
          if (lockRated) pool = pool.filter((g: any) => g.rating >= 9.0);

          if (!pool.length) {
            if (statusMsg) statusMsg.textContent = "No games matched constraints. Relax filters!";
            return;
          }

          ball?.classList.add("animate-pokeball-shake");
          if (statusMsg) statusMsg.textContent = "Shaking Pokéball vault…";
          resultCard?.classList.add("hidden");

          setTimeout(() => {
            ball?.classList.remove("animate-pokeball-shake");
            ball?.classList.add("animate-pokeball-pop");

            const pick = pool[Math.floor(Math.random() * pool.length)];

            setTimeout(() => {
              ball?.classList.remove("animate-pokeball-pop");
              if (statusMsg) statusMsg.textContent = "Gotcha! Project captured:";
              if (resultCard) {
                resultCard.classList.remove("hidden");
                (document.getElementById("gacha-result-runtime") as HTMLElement).textContent = pick.runtime;
                (document.getElementById("gacha-result-name") as HTMLElement).textContent = pick.name;
                (document.getElementById("gacha-result-base") as HTMLElement).textContent = `${pick.base} · ${pick.status} · ${pick.category}`;
                (document.getElementById("gacha-result-desc") as HTMLElement).textContent = pick.description;
                (document.getElementById("gacha-result-rating") as HTMLElement).textContent = String(pick.rating);
                (document.getElementById("gacha-result-link") as HTMLAnchorElement).href = `/games/${pick.id}`;
              }
            }, 500);
          }, 800);
        }

        spinBtn?.addEventListener("click", roll);
        ball?.addEventListener("click", roll);
      }

      // ── Compare Dock Manager ─────────────────────────
      function initCompareDock() {
        const dock = document.getElementById("compare-dock");
        const chipsContainer = document.getElementById("dock-chips-container");
        const countBadge = document.getElementById("dock-count-badge");
        const clearBtn = document.getElementById("dock-clear-btn");
        const compareBtn = document.getElementById("dock-compare-btn") as HTMLAnchorElement;

        function getCompareList(): { id: string; name: string }[] {
          try {
            return JSON.parse(localStorage.getItem("archivedex_compare_tray") || "[]");
          } catch {
            return [];
          }
        }

        function setCompareList(list: { id: string; name: string }[]) {
          localStorage.setItem("archivedex_compare_tray", JSON.stringify(list));
          updateDock();
        }

        function updateDock() {
          const list = getCompareList();
          if (!dock) return;

          if (list.length === 0) {
            dock.classList.add("hidden");
            return;
          }

          dock.classList.remove("hidden");
          if (countBadge) countBadge.textContent = `${list.length}/4`;

          if (chipsContainer) {
            chipsContainer.innerHTML = list.map((item) => `
              <div class="flex items-center gap-1.5 rounded-xl border border-cyan-400/30 bg-cyan-500/10 px-2.5 py-1 text-xs font-bold text-cyan-200">
                <span class="truncate max-w-[120px]">${item.name}</span>
                <button class="remove-dock-item text-slate-400 hover:text-red-400 font-black ml-1" data-id="${item.id}">✕</button>
              </div>
            `).join("");

            chipsContainer.querySelectorAll<HTMLButtonElement>(".remove-dock-item").forEach((btn) => {
              btn.addEventListener("click", () => {
                const id = btn.dataset.id;
                const next = getCompareList().filter((x) => x.id !== id);
                setCompareList(next);
              });
            });
          }

          if (compareBtn) {
            compareBtn.href = `/compare?games=${list.map((x) => x.id).join(",")}`;
          }
        }

        clearBtn?.addEventListener("click", () => {
          setCompareList([]);
        });

        // Global function for cards
        (window as any).toggleCompareItem = function (id: string, name: string) {
          const list = getCompareList();
          const exists = list.some((x) => x.id === id);
          if (exists) {
            setCompareList(list.filter((x) => x.id !== id));
            (window as any).showToast?.(`Removed ${name} from Compare`, "remove");
          } else {
            if (list.length >= 4) {
              (window as any).showToast?.("Compare Tray is full (max 4 games)", "info");
              return;
            }
            list.push({ id, name });
            setCompareList(list);
            (window as any).showToast?.(`Added ${name} to Compare Dock`, "success");
          }
        };

        updateDock();
      }

      // ── Watchlist Vault Manager ──────────────────────
      function initWatchlistManager() {
        const modal = document.getElementById("watchlist-modal");
        const openBtn = document.getElementById("open-watchlist-btn");
        const closeBtn = document.getElementById("close-watchlist-btn");
        const badge = document.getElementById("watchlist-count-badge");
        const itemsList = document.getElementById("watchlist-items-list");
        const wishTab = document.getElementById("watchlist-tab-wish");
        const doneTab = document.getElementById("watchlist-tab-done");

        let activeTab = "wish";

        function getWishlist(): string[] {
          try {
            return JSON.parse(localStorage.getItem("archivedex_wishlist") || "[]");
          } catch {
            return [];
          }
        }

        function getCompleted(): string[] {
          try {
            return JSON.parse(localStorage.getItem("archivedex_completed") || "[]");
          } catch {
            return [];
          }
        }

        function updateBadge() {
          const w = getWishlist();
          if (badge) badge.textContent = String(w.length);
        }

        async function renderList() {
          const ids = activeTab === "wish" ? getWishlist() : getCompleted();
          if (!itemsList) return;

          (document.getElementById("wishlist-tab-count") as HTMLElement).textContent = String(getWishlist().length);
          (document.getElementById("done-tab-count") as HTMLElement).textContent = String(getCompleted().length);

          if (!ids.length) {
            itemsList.innerHTML = `<div class="p-8 text-center text-xs text-slate-500 font-mono-spec">No games marked in ${activeTab === "wish" ? "Wishlist" : "Completed"}.</div>`;
            return;
          }

          const games = await getGamesList();
          const matches = games.filter((g: any) => ids.includes(g.id));

          itemsList.innerHTML = matches.map((g: any) => `
            <div class="flex items-center justify-between rounded-xl border border-white/[0.06] bg-[#111520] p-3">
              <div>
                <a href="/games/${g.id}" class="text-xs font-bold text-white hover:text-cyan-200">${g.name}</a>
                <div class="text-[10px] text-slate-500">${g.runtime} · ${g.base}</div>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-xs font-mono-spec text-yellow-300">${g.rating}</span>
                <button class="remove-watch-id text-slate-500 hover:text-red-400 text-xs font-black p-1" data-id="${g.id}">✕</button>
              </div>
            </div>
          `).join("");

          itemsList.querySelectorAll<HTMLButtonElement>(".remove-watch-id").forEach((btn) => {
            btn.addEventListener("click", () => {
              const id = btn.dataset.id!;
              if (activeTab === "wish") {
                const next = getWishlist().filter((x) => x !== id);
                localStorage.setItem("archivedex_wishlist", JSON.stringify(next));
              } else {
                const next = getCompleted().filter((x) => x !== id);
                localStorage.setItem("archivedex_completed", JSON.stringify(next));
              }
              renderList();
              updateBadge();
            });
          });
        }

        openBtn?.addEventListener("click", () => {
          modal?.classList.remove("hidden");
          modal?.classList.add("flex");
          renderList();
        });
        closeBtn?.addEventListener("click", () => {
          modal?.classList.add("hidden");
          modal?.classList.remove("flex");
        });
        modal?.addEventListener("click", (e) => {
          if (e.target === modal) {
            modal?.classList.add("hidden");
            modal?.classList.remove("flex");
          }
        });

        wishTab?.addEventListener("click", () => {
          activeTab = "wish";
          wishTab.className = "rounded-lg bg-rose-500/20 px-3 py-1.5 text-rose-300 font-bold";
          doneTab!.className = "rounded-lg bg-[#111520] px-3 py-1.5 text-slate-400 hover:text-white font-bold";
          renderList();
        });
        doneTab?.addEventListener("click", () => {
          activeTab = "done";
          doneTab!.className = "rounded-lg bg-emerald-500/20 px-3 py-1.5 text-emerald-300 font-bold";
          wishTab!.className = "rounded-lg bg-[#111520] px-3 py-1.5 text-slate-400 hover:text-white font-bold";
          renderList();
        });

        // Global functions for card toggles
        (window as any).toggleWishlist = function (id: string, name: string) {
          const list = getWishlist();
          if (list.includes(id)) {
            const next = list.filter((x) => x !== id);
            localStorage.setItem("archivedex_wishlist", JSON.stringify(next));
            (window as any).showToast?.(`Removed ${name} from Wishlist`, "remove");
          } else {
            list.push(id);
            localStorage.setItem("archivedex_wishlist", JSON.stringify(list));
            (window as any).showToast?.(`Saved ${name} to Wishlist`, "success");
          }
          updateBadge();
        };

        (window as any).toggleCompleted = function (id: string, name: string) {
          const list = getCompleted();
          if (list.includes(id)) {
            const next = list.filter((x) => x !== id);
            localStorage.setItem("archivedex_completed", JSON.stringify(next));
            (window as any).showToast?.(`Unmarked ${name} as Completed`, "remove");
          } else {
            list.push(id);
            localStorage.setItem("archivedex_completed", JSON.stringify(list));
            (window as any).showToast?.(`Marked ${name} as Completed!`, "success");
          }
        };

        updateBadge();
      }

      // ── Shared Toast System ──────────────────────────
      function showToast(message: string, type: "success" | "info" | "remove" = "info") {
        const stack = document.getElementById("toast-stack");
        if (!stack) return;
        const icon = type === "success" ? "✓" : type === "remove" ? "✕" : "ℹ";
        const el = document.createElement("div");
        el.className = `toast toast-${type}`;
        el.innerHTML = `<span class="toast-icon">${icon}</span><span>${message}</span>`;
        stack.appendChild(el);
        requestAnimationFrame(() => requestAnimationFrame(() => el.classList.add("toast-show")));
        const remove = () => {
          el.classList.remove("toast-show");
          setTimeout(() => el.remove(), 320);
        };
        const timer = setTimeout(remove, 2800);
        el.addEventListener("click", () => {
          clearTimeout(timer);
          remove();
        });
      }
      (window as any).showToast = showToast;

      // ── 3D Card Tilt Handler ─────────────────────────
      function initTilt() {
        const fine = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
        if (!fine) return;
        let current: HTMLElement | null = null;

        document.addEventListener("mousemove", (e) => {
          const card = (e.target as HTMLElement)?.closest?.(".tilt-card") as HTMLElement | null;
          if (!card) {
            if (current) {
              current.style.transform = "";
              current = null;
            }
            return;
          }
          current = card;
          const rect = card.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          const rotateX = ((y - rect.height / 2) / (rect.height / 2)) * -6;
          const rotateY = ((x - rect.width / 2) / (rect.width / 2)) * 6;
          card.style.transform = `perspective(900px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-4px)`;
          const glare = card.querySelector<HTMLElement>(".tilt-glare");
          if (glare) glare.style.background = `radial-gradient(circle at ${x}px ${y}px, rgba(255,255,255,0.18), transparent 55%)`;
        }, { passive: true });

        document.addEventListener("mouseleave", () => {
          if (current) {
            current.style.transform = "";
            current = null;
          }
        }, true);
      }

      // ── Scroll Reveal & Counters ────────────────────
      function initScrollReveal() {
        const reveals = document.querySelectorAll<HTMLElement>("[data-reveal]");
        if (!reveals.length) return;

        const mainScroll = document.getElementById("main-scroll-container");

        if (!("IntersectionObserver" in window)) {
          reveals.forEach((el) => el.classList.add("is-revealed"));
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-revealed");
                observer.unobserve(entry.target);
              }
            });
          },
          { 
            root: mainScroll || null,
            threshold: 0.05, 
            rootMargin: "0px 0px 80px 0px" 
          }
        );

        reveals.forEach((el) => {
          const containerRect = mainScroll 
            ? mainScroll.getBoundingClientRect() 
            : { top: 0, bottom: window.innerHeight };
          const rect = el.getBoundingClientRect();
          if (rect.top < containerRect.bottom && rect.bottom > containerRect.top) {
            el.classList.add("is-revealed");
          } else {
            observer.observe(el);
          }
        });

        // Safety fallback: ensure nothing stays invisible if observer lags
        setTimeout(() => {
          reveals.forEach((el) => el.classList.add("is-revealed"));
        }, 1000);
      }

      function initCounters() {
        const counters = document.querySelectorAll<HTMLElement>("[data-counter]");
        counters.forEach((el) => {
          const target = parseInt(el.dataset.counter || "0", 10);
          if (isNaN(target)) return;
          const duration = parseInt(el.dataset.counterDuration || "800", 10);
          const startTime = performance.now();
          function update(now: number) {
            const elapsed = now - startTime;
            const progress = Math.min(elapsed / duration, 1);
            const ease = progress === 1 ? 1 : 1 - Math.pow(2, -10 * progress);
            const current = Math.round(ease * target);
            el.textContent = current.toLocaleString();
            if (progress < 1) requestAnimationFrame(update);
          }
          requestAnimationFrame(update);
        });
      }

      // ── Master Init ──────────────────────────────────
      function initAll() {
        updateActiveNav();
        initThemeSwitcher();
        initLeftRail();
        initRightRail();
        initCommandPalette();
        initGacha();
        initCompareDock();
        initWatchlistManager();
        initScrollReveal();
        initCounters();
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initAll);
      } else {
        initAll();
      }
      document.addEventListener("astro:page-load", initAll);

      if (!(window as any).__adexShellInit) {
        (window as any).__adexShellInit = true;
        initTilt();
        window.addEventListener("popstate", updateActiveNav);

        // ── Global Card Click Delegation ──────────────────
        document.addEventListener("click", (e) => {
          const target = e.target as HTMLElement | null;
          if (!target) return;
          // If clicked inside interactive buttons, tag links, or inputs, do not intercept
          if (target.closest("button, .quick-actions-bar, a[href*='tag='], a[href*='category='], input, select, textarea")) {
            return;
          }
          const card = target.closest<HTMLElement>("[data-card-href]");
          if (card) {
            const href = card.getAttribute("data-card-href");
            if (href) {
              window.location.href = href;
            }
          }
        });
      }
    </script>
  </body>
</html>
