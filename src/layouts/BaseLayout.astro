---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { games } from "../data/games";
import { tools } from "../data/tools";

type Props = {
  title?: string;
  description?: string;
  isHome?: boolean;
};

const {
  title = "ArchiveDex · Pokémon ROM Hack & Fan Game Archive",
  description = "The definitive museum-grade archive and discovery launcher for Pokémon ROM hacks, fan games, and preservation projects.",
  isHome = false,
} = Astro.props;

const currentPath = Astro.url.pathname;
const totalPlayableGames = games.length;
const totalTools = tools.length;
const completeCount = games.filter((g) => g.status === "Complete").length;

const navItems = [
  { href: "/", label: "Home", icon: "⌂" },
  { href: "/library", label: "Library", icon: "📚" },
  { href: "/collections", label: "Collections", icon: "🗂️" },
  { href: "/compare", label: "Compare", icon: "⇄" },
  { href: "/matchmaker", label: "Matchmaker", icon: "🎯" },
  { href: "/tools", label: "Tools & Engines", icon: "🛠️" },
  { href: "/source-notes", label: "Source Notes", icon: "📋" },
];

const categoryShortcuts = [
  { label: "Essential Collection", cat: "Essential Collection", icon: "✦" },
  { label: "Must Play", cat: "Must Play", icon: "◆" },
  { label: "Story Focused", cat: "Story Focused", icon: "◈" },
  { label: "Open World", cat: "Open World", icon: "⬡" },
  { label: "Roguelike Runs", cat: "Roguelike", icon: "✧" },
  { label: "Difficulty & Kaizo", cat: "Difficulty", icon: "⚔" },
  { label: "Fakemon Worlds", cat: "Fakemon", icon: "★" },
  { label: "Hidden Gems", cat: "Hidden Gem", icon: "💎" },
];

const topRatedMini = [...games].sort((a, b) => b.rating - a.rating).slice(0, 5);

const latestUpdates = [
  { id: "pokemon-emerald-seaglass", name: "Emerald Seaglass", ver: "v2.0", tag: "Mega Evolutions & Mining", date: "Recent" },
  { id: "pokemon-unbound", name: "Pokémon Unbound", ver: "v2.1.1", tag: "Postgame & Frontier Fixes", date: "Stable" },
  { id: "pokemon-emerald-rogue", name: "Emerald Rogue", ver: "v2.0 EX", tag: "Gen 9 Roster & HUB Overhaul", date: "Major" },
  { id: "pokemon-radical-red", name: "Radical Red", ver: "v4.1", tag: "Paldea DLC Abilities & AI", date: "Update" },
  { id: "lazarus", name: "Pokémon Lazarus", ver: "v1.2", tag: "Ilios 9-Starter Balance", date: "New" },
];
---

<!doctype html>
<html lang="en" data-theme="cosmic">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      // Synchronously apply themes before paint and persist through Astro page transitions
      (function() {
        function applySavedTheme() {
          try {
            const savedTheme = localStorage.getItem("archivedex_theme") || "cosmic";
            document.documentElement.setAttribute("data-theme", savedTheme);
            if (document.body) document.body.setAttribute("data-theme", savedTheme);

            const savedCardTheme = localStorage.getItem("archivedex_card_theme") || "holo";
            document.documentElement.setAttribute("data-card-theme", savedCardTheme);
            if (document.body) document.body.setAttribute("data-card-theme", savedCardTheme);
          } catch (e) {}
        }
        applySavedTheme();
        document.addEventListener("astro:before-swap", applySavedTheme);
        document.addEventListener("astro:after-swap", applySavedTheme);
        document.addEventListener("astro:page-load", applySavedTheme);
      })();
    </script>
  </head>

  <body class="h-screen overflow-hidden flex flex-col text-slate-100 dot-matrix-grid antialiased selection:bg-cyan-500/30 selection:text-cyan-200">

    <!-- Top nav progress bar -->
    <div id="nav-progress" class="fixed top-0 left-0 h-[2px] w-0 bg-gradient-to-r from-cyan-400 via-violet-400 to-amber-300 transition-all duration-300 z-[99999]" transition:persist="nav-progress"></div>

    <!-- Toast Notification Stack -->
    <div id="toast-stack" aria-live="polite"></div>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- TOP GLOBAL HEADER (FIXED PERSISTENT SHELL)      -->
    <!-- ═══════════════════════════════════════════════ -->
    <header class="h-16 shrink-0 w-full z-30 flex items-center justify-between border-b border-white/[0.08] bg-[#111520]/95 px-4 sm:px-6 backdrop-blur-xl" transition:persist="main-header">
      
      <!-- Left: Mobile Toggle, Desktop Left Rail Toggle & Logo -->
      <div class="flex items-center gap-3">
        <!-- Mobile Drawer Hamburger -->
        <button id="open-mobile-rail" aria-label="Open Navigation" class="grid h-9 w-9 place-items-center rounded-xl border border-white/[0.12] bg-[#161B29] text-slate-300 md:hidden">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>

        <!-- Desktop Left Rail Toggle Button -->
        <button
          id="toggle-left-rail-btn"
          title="Toggle Navigation Rail (⌘B / Ctrl+B)"
          class="hidden md:flex items-center gap-1.5 rounded-xl border border-white/[0.08] bg-[#161B29] px-2.5 py-1.5 text-xs font-bold text-slate-300 transition hover:border-cyan-400/40 hover:bg-[#1E2538]"
        >
          <span class="text-xs">▤</span>
          <span class="text-[11px] font-mono-spec">Rail</span>
        </button>

        <!-- Logo -->
        <a href="/" class="flex items-center gap-2.5 group">
          <div class="relative grid h-9 w-9 place-items-center rounded-xl border border-cyan-400/30 bg-cyan-500/10 text-cyan-300 transition-all group-hover:border-cyan-400/60 group-hover:shadow-[0_0_20px_rgba(34,211,238,0.35)]">
            <span class="text-lg">⬡</span>
            <span class="absolute -top-1 -right-1 flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-cyan-400 opacity-75"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-cyan-500"></span>
            </span>
          </div>
          <div>
            <div class="text-sm font-black tracking-wider text-white">
              ARCHIVE<span class="theme-accent-text">DEX</span>
            </div>
            <div class="text-[9px] font-mono-spec tracking-widest text-slate-500 uppercase">
              Museum Launcher
            </div>
          </div>
        </a>
      </div>

      <!-- Center: Global Search Trigger (⌘K Spotlight) -->
      <div class="flex items-center">
        <button
          id="cmd-k-trigger"
          class="flex items-center gap-3 rounded-xl border border-white/[0.08] bg-[#161B29] px-4 py-2 text-xs font-medium text-slate-400 transition hover:border-cyan-400/40 hover:text-slate-200"
        >
          <span class="text-slate-500">🔍</span>
          <span class="hidden sm:inline">Search games, tags, creators…</span>
          <span class="sm:hidden">Search…</span>
          <span class="rounded bg-black/40 px-1.5 py-0.5 font-mono-spec text-[10px] font-bold text-slate-400 border border-white/[0.06]">
            ⌘K
          </span>
        </button>
      </div>

      <!-- Right: Theme Switchers, Quick-Links & Rail Toggles -->
      <div class="flex items-center gap-2 sm:gap-2.5">

        <!-- Pokédex & Card Theme Switcher Dropdown -->
        <div class="relative" id="theme-switcher-container">
          <button
            id="theme-dropdown-btn"
            aria-label="Theme & Style Settings"
            class="flex items-center gap-2 rounded-xl border border-white/[0.08] bg-[#161B29] px-3 py-2 text-xs font-bold text-slate-300 transition hover:border-white/[0.2] hover:bg-[#1E2538]"
          >
            <span class="flex items-center gap-1 shrink-0">
              <span class="h-2.5 w-2.5 rounded-full" style="background-color: var(--accent-primary); box-shadow: 0 0 6px var(--accent-glow);"></span>
              <span class="h-2 w-2 rounded-full" style="background-color: var(--accent-secondary); box-shadow: 0 0 6px var(--accent-secondary-glow);"></span>
            </span>
            <span id="theme-active-label" class="hidden sm:inline font-mono-spec text-[11px]">Cosmic Cyan</span>
            <span class="text-[9px] text-slate-500">▼</span>
          </button>

          <!-- Dropdown Menu -->
          <div
            id="theme-menu"
            class="absolute right-0 mt-2 hidden w-64 rounded-2xl border border-white/[0.12] bg-[#161B29] p-3 shadow-2xl backdrop-blur-2xl z-50 space-y-3"
          >
            <!-- Section 1: Pokédex Accent Colors -->
            <div>
              <div class="px-2 pb-1.5 text-[10px] font-black uppercase tracking-widest text-slate-500 font-mono-spec">
                Pokédex Color Palettes
              </div>
              <div class="space-y-1">
                <button data-set-theme="cosmic" class="theme-option flex w-full items-center justify-between rounded-xl px-2.5 py-1.5 text-left text-xs font-bold text-slate-200 transition hover:bg-[#1E2538]">
                  <div class="flex items-center gap-2.5">
                    <span class="flex items-center gap-1 shrink-0">
                      <span class="theme-swatch-dot h-3 w-3 rounded-full" style="background-color: #22d3ee !important; box-shadow: 0 0 6px rgba(34, 211, 238, 0.8) !important;"></span>
                      <span class="theme-swatch-dot h-2.5 w-2.5 rounded-full" style="background-color: #a855f7 !important; box-shadow: 0 0 6px rgba(168, 85, 247, 0.8) !important;"></span>
                    </span>
                    <span>Cosmic Cyan & Violet</span>
                  </div>
                </button>
                <button data-set-theme="atomic" class="theme-option flex w-full items-center justify-between rounded-xl px-2.5 py-1.5 text-left text-xs font-bold text-slate-200 transition hover:bg-[#1E2538]">
                  <div class="flex items-center gap-2.5">
                    <span class="flex items-center gap-1 shrink-0">
                      <span class="theme-swatch-dot h-3 w-3 rounded-full" style="background-color: #a855f7 !important; box-shadow: 0 0 6px rgba(168, 85, 247, 0.8) !important;"></span>
                      <span class="theme-swatch-dot h-2.5 w-2.5 rounded-full" style="background-color: #f43f5e !important; box-shadow: 0 0 6px rgba(244, 63, 94, 0.8) !important;"></span>
                    </span>
                    <span>Atomic Purple & Rose</span>
                  </div>
                </button>
                <button data-set-theme="emerald" class="theme-option flex w-full items-center justify-between rounded-xl px-2.5 py-1.5 text-left text-xs font-bold text-slate-200 transition hover:bg-[#1E2538]">
                  <div class="flex items-center gap-2.5">
                    <span class="flex items-center gap-1 shrink-0">
                      <span class="theme-swatch-dot h-3 w-3 rounded-full" style="background-color: #10b981 !important; box-shadow: 0 0 6px rgba(16, 185, 129, 0.8) !important;"></span>
                      <span class="theme-swatch-dot h-2.5 w-2.5 rounded-full" style="background-color: #06b6d4 !important; box-shadow: 0 0 6px rgba(6, 182, 212, 0.8) !important;"></span>
                    </span>
                    <span>Emerald & Sky Teal</span>
                  </div>
                </button>
                <button data-set-theme="firered" class="theme-option flex w-full items-center justify-between rounded-xl px-2.5 py-1.5 text-left text-xs font-bold text-slate-200 transition hover:bg-[#1E2538]">
                  <div class="flex items-center gap-2.5">
                    <span class="flex items-center gap-1 shrink-0">
                      <span class="theme-swatch-dot h-3 w-3 rounded-full" style="background-color: #ef4444 !important; box-shadow: 0 0 6px rgba(239, 68, 68, 0.8) !important;"></span>
                      <span class="theme-swatch-dot h-2.5 w-2.5 rounded-full" style="background-color: #f97316 !important; box-shadow: 0 0 6px rgba(249, 115, 22, 0.8) !important;"></span>
                    </span>
                    <span>FireRed & Amber</span>
                  </div>
                </button>
                <button data-set-theme="gold" class="theme-option flex w-full items-center justify-between rounded-xl px-2.5 py-1.5 text-left text-xs font-bold text-slate-200 transition hover:bg-[#1E2538]">
                  <div class="flex items-center gap-2.5">
                    <span class="flex items-center gap-1 shrink-0">
                      <span class="theme-swatch-dot h-3 w-3 rounded-full" style="background-color: #fbbf24 !important; box-shadow: 0 0 6px rgba(251, 191, 36, 0.8) !important;"></span>
                      <span class="theme-swatch-dot h-2.5 w-2.5 rounded-full" style="background-color: #dbeafe !important; box-shadow: 0 0 6px rgba(219, 234, 254, 0.8) !important;"></span>
                    </span>
                    <span>Solar Gold & Silver</span>
                  </div>
                </button>
                <button data-set-theme="sapphire" class="theme-option flex w-full items-center justify-between rounded-xl px-2.5 py-1.5 text-left text-xs font-bold text-slate-200 transition hover:bg-[#1E2538]">
                  <div class="flex items-center gap-2.5">
                    <span class="flex items-center gap-1 shrink-0">
                      <span class="theme-swatch-dot h-3 w-3 rounded-full" style="background-color: #0ea5e9 !important; box-shadow: 0 0 6px rgba(14, 165, 233, 0.8) !important;"></span>
                      <span class="theme-swatch-dot h-2.5 w-2.5 rounded-full" style="background-color: #14b8a6 !important; box-shadow: 0 0 6px rgba(20, 184, 166, 0.8) !important;"></span>
                    </span>
                    <span>Abyssal Sapphire & Aqua</span>
                  </div>
                </button>
                <button data-set-theme="pokeball" class="theme-option flex w-full items-center justify-between rounded-xl px-2.5 py-1.5 text-left text-xs font-bold text-slate-200 transition hover:bg-[#1E2538]">
                  <div class="flex items-center gap-2.5">
                    <span class="flex items-center gap-1 shrink-0">
                      <span class="theme-swatch-dot h-3 w-3 rounded-full" style="background-color: #f43f5e !important; box-shadow: 0 0 6px rgba(244, 63, 94, 0.8) !important;"></span>
                      <span class="theme-swatch-dot h-2.5 w-2.5 rounded-full" style="background-color: #ffffff !important; box-shadow: 0 0 6px rgba(255, 255, 255, 0.8) !important;"></span>
                    </span>
                    <span>Pokéball Contrast</span>
                  </div>
                </button>
              </div>
            </div>

            <!-- Section 2: Card View Theme Presets -->
            <div class="border-t border-white/[0.08] pt-2">
              <div class="px-2 pb-1.5 text-[10px] font-black uppercase tracking-widest text-slate-500 font-mono-spec">
                Card View Style
              </div>
              <div class="space-y-1">
                <button data-set-card-theme="holo" class="card-theme-option flex w-full items-center justify-between rounded-xl px-2.5 py-1.5 text-left text-xs font-bold text-slate-200 transition hover:bg-[#1E2538]">
                  <div class="flex items-center gap-2">
                    <span style="color: #22d3ee !important;">✦</span>
                    <span>Holo Neo</span>
                  </div>
                  <span class="text-[10px] text-slate-500 font-mono-spec">Glass & Glow</span>
                </button>
                <button data-set-card-theme="retro" class="card-theme-option flex w-full items-center justify-between rounded-xl px-2.5 py-1.5 text-left text-xs font-bold text-slate-200 transition hover:bg-[#1E2538]">
                  <div class="flex items-center gap-2">
                    <span class="text-yellow-400">🕹️</span>
                    <span>Retro Cartridge</span>
                  </div>
                  <span class="text-[10px] text-slate-500 font-mono-spec">Hardware Slate</span>
                </button>
                <button data-set-card-theme="monolith" class="card-theme-option flex w-full items-center justify-between rounded-xl px-2.5 py-1.5 text-left text-xs font-bold text-slate-200 transition hover:bg-[#1E2538]">
                  <div class="flex items-center gap-2">
                    <span class="text-white">⬛</span>
                    <span>Monolith Obsidian</span>
                  </div>
                  <span class="text-[10px] text-slate-500 font-mono-spec">Minimal Vault</span>
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Pokéball Gacha Randomizer Trigger -->
        <button
          id="open-gacha-btn"
          title="Pokéball Gacha Randomizer"
          class="flex items-center gap-1.5 rounded-xl border border-white/[0.08] bg-[#161B29] px-3 py-2 text-xs font-bold text-slate-300 transition hover:border-amber-400/40 hover:text-amber-300"
        >
          <span class="text-sm">🎲</span>
          <span class="hidden md:inline font-mono-spec text-[11px]">Gacha</span>
        </button>

        <!-- Watchlist Drawer Button -->
        <button
          id="open-watchlist-btn"
          title="View Wishlist & Completed Vault"
          class="flex items-center gap-1.5 rounded-xl border border-white/[0.08] bg-[#161B29] px-3 py-2 text-xs font-bold text-slate-300 transition hover:border-rose-400/40 hover:text-rose-300"
        >
          <span>♡</span>
          <span class="hidden md:inline font-mono-spec text-[11px]">Watchlist</span>
          <span id="watchlist-count-badge" class="rounded-full bg-rose-500/20 px-1.5 py-0.2 text-[10px] font-mono-spec font-bold text-rose-300">0</span>
        </button>

        <!-- Matchmaker Direct Link -->
        <a
          href="/matchmaker"
          class="hidden xl:flex items-center gap-1.5 rounded-xl theme-pill px-3 py-2 text-xs font-black transition hover:opacity-90"
        >
          <span>🎯</span>
          <span>Matchmaker</span>
        </a>

        <!-- Right Activity Rail Toggle -->
        <button
          id="toggle-right-rail-btn"
          title="Toggle Right Activity Feed (Latest Updates & Top Rated)"
          class="flex items-center gap-2 rounded-xl border border-white/[0.08] bg-[#161B29] px-3 py-2 text-xs font-bold text-slate-300 transition hover:border-cyan-400/40 hover:bg-[#1E2538]"
        >
          <span class="text-cyan-400 text-xs">⚡</span>
          <span class="hidden sm:inline font-mono-spec text-[11px]">Activity</span>
          <span id="right-rail-dot" class="h-1.5 w-1.5 rounded-full bg-cyan-400 shadow-[0_0_8px_#22d3ee] transition-all"></span>
        </button>

      </div>
    </header>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- 3-COLUMN LAUNCHER SHELL (INDEPENDENT SCROLLS)   -->
    <!-- ═══════════════════════════════════════════════ -->
    <div class="flex flex-1 w-full overflow-hidden min-h-0 relative">

      <!-- ═══════════════════════════════════════════════ -->
      <!-- COLUMN 1: LEFT RAIL (PERSISTENT NAV & VAULT)   -->
      <!-- ═══════════════════════════════════════════════ -->
      <aside
        id="launcher-sidebar"
        class="h-full flex flex-col border-r border-white/[0.08] bg-[#111520] shrink-0 transition-all duration-300 z-40 fixed inset-y-0 left-0 -translate-x-full md:static md:translate-x-0 w-64 overflow-hidden select-none"
      >
        <!-- Rail Header with Collapse button -->
        <div class="flex h-11 shrink-0 items-center justify-between border-b border-white/[0.08] px-4">
          <span class="text-[10px] font-black uppercase tracking-[0.25em] text-slate-500 font-mono-spec">Navigation</span>
          <button id="collapse-left-rail-btn" title="Collapse Rail (⌘B)" class="hidden md:flex items-center gap-1 text-[11px] font-mono-spec text-slate-400 hover:text-white rounded px-2 py-0.5 hover:bg-white/5 transition">
            <span>◀</span>
            <span class="text-[10px] font-bold">Collapse</span>
          </button>
          <button id="close-mobile-rail" class="grid h-7 w-7 place-items-center rounded-lg border border-slate-700 text-slate-400 md:hidden hover:text-white text-xs">✕</button>
        </div>

        <!-- Scrollable Navigation Area (Independent Scroll: Column 1 Only) -->
        <div class="flex-1 overflow-y-auto custom-scrollbar px-3 py-4 space-y-6">

          <!-- Primary Navigation -->
          <div>
            <div class="px-3 pb-2 text-[10px] font-black uppercase tracking-[0.25em] text-slate-500 font-mono-spec">
              Launcher Rail
            </div>
            <nav class="space-y-1">
              {navItems.map((item) => {
                const isActive =
                  currentPath === item.href ||
                  (item.href !== "/" && currentPath.startsWith(item.href)) ||
                  (item.href === "/library" && currentPath.startsWith("/games"));
                return (
                  <a
                    href={item.href}
                    data-astro-prefetch
                    class={`nav-item-link flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-xs font-bold transition-all ${
                      isActive
                        ? "theme-pill font-black shadow-[0_0_15px_var(--accent-glow)]"
                        : "text-slate-400 hover:bg-[#1E2538] hover:text-white"
                    }`}
                  >
                    <span class="text-base">{item.icon}</span>
                    <span class="flex-1">{item.label}</span>
                    {item.href === "/library" && (
                      <span class="rounded bg-black/40 px-1.5 py-0.5 text-[10px] font-mono-spec text-slate-400">
                        {totalPlayableGames}
                      </span>
                    )}
                    {item.href === "/tools" && (
                      <span class="rounded bg-cyan-500/10 px-1.5 py-0.5 text-[10px] font-mono-spec text-cyan-300">
                        {totalTools}
                      </span>
                    )}
                  </a>
                );
              })}
            </nav>
          </div>

          <!-- Category Quick Links -->
          <div>
            <div class="px-3 pb-2 text-[10px] font-black uppercase tracking-[0.25em] text-slate-500 font-mono-spec">
              Curated Routes
            </div>
            <div class="space-y-0.5">
              {categoryShortcuts.map((cat) => (
                <a
                  href={`/library?category=${encodeURIComponent(cat.cat)}`}
                  data-astro-prefetch
                  class="flex items-center gap-2.5 rounded-lg px-3 py-1.5 text-[11px] font-bold text-slate-400 transition hover:bg-[#1E2538] hover:text-cyan-300"
                >
                  <span class="text-xs text-slate-500">{cat.icon}</span>
                  <span class="truncate">{cat.label}</span>
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- Archive Status Vault Widget -->
        <div class="border-t border-white/[0.08] bg-[#0c0f17] p-3.5">
          <div class="rounded-xl border border-white/[0.08] bg-[#161B29] p-3 shadow-inner">
            <div class="flex items-center justify-between pb-2">
              <span class="text-[10px] font-black uppercase tracking-wider text-slate-400 font-mono-spec">
                Vault Status
              </span>
              <span class="inline-flex items-center gap-1 rounded-full bg-emerald-500/10 px-2 py-0.5 text-[9px] font-black text-emerald-300">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                Safe Patches
              </span>
            </div>

            <div class="grid grid-cols-2 gap-2 text-center pt-1 font-mono-spec">
              <div class="rounded-lg bg-[#111520] p-1.5 border border-white/[0.04]">
                <div class="text-sm font-black text-white">{totalPlayableGames}</div>
                <div class="text-[9px] text-slate-500">Games</div>
              </div>
              <div class="rounded-lg bg-[#111520] p-1.5 border border-white/[0.04]">
                <div class="text-sm font-black text-emerald-300">{completeCount}</div>
                <div class="text-[9px] text-slate-500">Complete</div>
              </div>
            </div>

