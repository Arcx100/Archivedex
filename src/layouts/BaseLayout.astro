---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { games } from "../data/games";

type Props = {
  title?: string;
  description?: string;
};

const {
  title = "ArchiveDex",
  description = "Premium discovery archive for Pokémon fan projects.",
} = Astro.props;

const currentPath = Astro.url.pathname;
const entryCount  = games.length;

const navLinks = [
  { href: "/library",      label: "Library" },
  { href: "/collections",  label: "Collections" },
  { href: "/compare",      label: "Compare" },
  { href: "/source-notes", label: "Source Notes" },
];

const categoryNav = [
  { label: "Essential",   cat: "Essential Collection" },
  { label: "Must Play",   cat: "Must Play" },
  { label: "Story",       cat: "Story Focused" },
  { label: "Open World",  cat: "Open World" },
  { label: "Roguelike",   cat: "Roguelike" },
  { label: "Difficulty",  cat: "Difficulty" },
  { label: "Fakemon",     cat: "Fakemon" },
  { label: "Competitive", cat: "Competitive" },
  { label: "Hidden Gems", cat: "Hidden Gem" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <ClientRouter />
  </head>

  <body class="min-h-screen archive-grid">

    <!-- Top navigation progress bar (page transitions) -->
    <div id="nav-progress" transition:persist="nav-progress"></div>

    <!-- Toast notification stack -->
    <div id="toast-stack" aria-live="polite"></div>

    <header class="sticky top-0 z-50 border-b border-slate-800/60 bg-[#070914]/90 backdrop-blur-xl" transition:persist="site-header">

      <!-- Primary nav -->
      <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-3.5">

        <!-- Logo -->
        <a href="/" data-astro-prefetch class="flex items-center gap-3 group">
          <div class="grid h-9 w-9 shrink-0 place-items-center rounded-xl border border-cyan-400/40 bg-cyan-400/10 text-base font-black text-cyan-300 transition group-hover:bg-cyan-400/20 group-hover:glow-cyan">
            A
          </div>
          <div>
            <div class="text-base font-black tracking-tight">
              <span class="text-white">ARCHIVE</span><span class="text-cyan-300 text-glow-cyan">DEX</span>
            </div>
            <div class="text-[10px] text-slate-600 leading-none">Fan Project Archive</div>
          </div>
        </a>

        <!-- Center: desktop nav -->
        <div class="hidden items-center gap-0.5 md:flex">
          {navLinks.map(({ href, label }) => (
            <a
              href={href}
              data-astro-prefetch
              class={`nav-link-underline rounded-xl px-4 py-2 text-sm font-bold transition hover:bg-slate-800/80 hover:text-cyan-300 ${
                currentPath === href || currentPath.startsWith(href + "/")
                  ? "active bg-slate-800/70 text-cyan-300"
                  : "text-slate-400"
              }`}
            >
              {label}
            </a>
          ))}

          <div class="mx-2 h-4 w-px bg-slate-700/80"></div>

          <a
            href="/random"
            class="magnetic-btn flex items-center gap-1.5 rounded-xl border border-slate-700/80 bg-slate-900/80 px-3.5 py-2 text-sm font-bold text-slate-400 transition hover:border-violet-400/50 hover:text-violet-300"
          >
            <span class="text-sm">🎲</span> Random
          </a>
        </div>

        <!-- Right: entry count + mobile controls -->
        <div class="flex items-center gap-3">
          <span class="hidden rounded-full border border-slate-700/60 bg-slate-900/60 px-3 py-1 text-[11px] font-black text-slate-500 sm:inline-flex">
            <span data-counter={entryCount} data-counter-duration="900">0</span> entries
          </span>
          <!-- Mobile controls -->
          <div class="flex items-center gap-2 md:hidden">
            <a href="/random" class="grid h-9 w-9 place-items-center rounded-xl border border-slate-700 bg-slate-900 text-sm transition hover:border-violet-400/50" title="Random game">🎲</a>
            <button id="mobile-menu-btn" aria-label="Toggle menu" class="grid h-9 w-9 place-items-center rounded-xl border border-slate-700 bg-slate-900 transition hover:border-slate-600">
              <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
              <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="hidden h-4 w-4 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>
        </div>
      </nav>

      <!-- Secondary: category quick-nav -->
      <div class="border-t border-slate-900/80">
        <div class="mx-auto max-w-7xl px-6">
          <div class="no-scrollbar flex items-center gap-1 overflow-x-auto py-2">
            {categoryNav.map(({ label, cat }) => (
              <a
                href={`/library?category=${encodeURIComponent(cat)}`}
                data-astro-prefetch
                class="cat-nav-link shrink-0 rounded-full px-3 py-1 text-[11px] font-bold text-slate-500 transition hover:bg-slate-800/70 hover:text-slate-300"
                data-cat={cat}
              >
                {label}
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Mobile dropdown -->
      <div id="mobile-menu" class="hidden border-t border-slate-800 md:hidden">
        <div class="mx-auto max-w-7xl space-y-1 px-6 py-3">
          <a href="/" data-astro-prefetch class="block rounded-xl px-4 py-2.5 text-sm font-bold text-slate-300 transition hover:bg-slate-800 hover:text-cyan-300">Home</a>
          {navLinks.map(({ href, label }) => (
            <a href={href} data-astro-prefetch class="block rounded-xl px-4 py-2.5 text-sm font-bold text-slate-300 transition hover:bg-slate-800 hover:text-cyan-300">{label}</a>
          ))}
          <a href="/random" class="flex items-center gap-2 rounded-xl px-4 py-2.5 text-sm font-bold text-violet-300 transition hover:bg-slate-800">
            <span>🎲</span> Random game
          </a>
        </div>
      </div>
    </header>

    <slot />

    <footer class="mt-20 border-t border-slate-800/60">
      <div class="mx-auto max-w-7xl px-6 py-8">
        <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
          <div>
            <div class="text-sm font-black">
              <span class="text-white">ARCHIVE</span><span class="text-cyan-300">DEX</span>
            </div>
            <p class="mt-1 text-xs text-slate-600">
              A discovery and documentation project. Does not host ROMs or prepatched files.
            </p>
          </div>
          <span class="rounded-full border border-slate-800 bg-slate-900/60 px-3 py-1 text-[11px] font-black text-slate-600">
            {entryCount} entries archived
          </span>
        </div>
      </div>
    </footer>

    <style>
      .no-scrollbar::-webkit-scrollbar { display: none; }
      .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    </style>

    <script>
      // ════════════════════════════════════════════════════════
      // ArchiveDex shared client runtime
      // Re-initialized on every load AND every ClientRouter
      // transition via the astro:page-load event.
      // ════════════════════════════════════════════════════════

      // ── Toasts ─────────────────────────────────────────────
      function showToast(message: string, type: "success" | "info" | "remove" = "info") {
        const stack = document.getElementById("toast-stack");
        if (!stack) return;
        const icon = type === "success" ? "✓" : type === "remove" ? "✕" : "ℹ";
        const el = document.createElement("div");
        el.className = `toast toast-${type}`;
        el.innerHTML = `<span class="toast-icon">${icon}</span><span>${message}</span>`;
        stack.appendChild(el);
        requestAnimationFrame(() => requestAnimationFrame(() => el.classList.add("toast-show")));
        const remove = () => {
          el.classList.remove("toast-show");
          setTimeout(() => el.remove(), 320);
        };
        const timer = setTimeout(remove, 2600);
        el.addEventListener("click", () => { clearTimeout(timer); remove(); });
      }
      (window as any).showToast = showToast;

      // ── Animated counters ──────────────────────────────────
      function animateCounter(el: HTMLElement) {
        const target = parseFloat(el.dataset.counter || "0");
        const duration = parseInt(el.dataset.counterDuration || "1200", 10);
        const isDecimal = !Number.isInteger(target);
        const start = performance.now();
        function tick(now: number) {
          const p = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - p, 3);
          const val = target * eased;
          el.textContent = isDecimal ? val.toFixed(1) : Math.round(val).toString();
          if (p < 1) requestAnimationFrame(tick);
          else el.textContent = isDecimal ? target.toFixed(1) : target.toString();
        }
        requestAnimationFrame(tick);
      }

      function initCounters() {
        const els = document.querySelectorAll<HTMLElement>("[data-counter]:not([data-counter-done])");
        if (!els.length) return;
        const obs = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const target = entry.target as HTMLElement;
              target.setAttribute("data-counter-done", "1");
              animateCounter(target);
              obs.unobserve(target);
            }
          });
        }, { threshold: 0.4 });
        els.forEach((el) => obs.observe(el));
      }

      // ── Scroll reveal ──────────────────────────────────────
      function initScrollReveal() {
        const els = document.querySelectorAll<HTMLElement>("[data-reveal]:not(.is-revealed)");
        if (!els.length) return;
        const obs = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-revealed");
              obs.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12, rootMargin: "0px 0px -60px 0px" });
        els.forEach((el, i) => {
          if (!el.style.getPropertyValue("--reveal-delay")) {
            el.style.setProperty("--reveal-delay", `${Math.min(i % 8, 8) * 60}ms`);
          }
          obs.observe(el);
        });
      }

      // ── 3D card tilt (delegated, desktop pointer only) ─────
      function initTilt() {
        const fine = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
        if (!fine) return;
        let current: HTMLElement | null = null;

        document.addEventListener("mousemove", (e) => {
          const card = (e.target as HTMLElement)?.closest?.(".tilt-card") as HTMLElement | null;
          if (!card) {
            if (current) { current.style.transform = ""; current = null; }
            return;
          }
          current = card;
          const rect = card.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          const rotateX = ((y - rect.height / 2) / (rect.height / 2)) * -5;
          const rotateY = ((x - rect.width / 2) / (rect.width / 2)) * 5;
          card.style.transform = `perspective(900px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-4px)`;
          const glare = card.querySelector<HTMLElement>(".tilt-glare");
          if (glare) glare.style.background = `radial-gradient(circle at ${x}px ${y}px, rgba(255,255,255,0.18), transparent 55%)`;
        }, { passive: true });

        document.addEventListener("mouseleave", () => {
          if (current) { current.style.transform = ""; current = null; }
        }, true);
      }

      // ── Mobile menu ─────────────────────────────────────────
      function closeMobileMenu() {
        document.getElementById("mobile-menu")?.classList.add("hidden");
        document.getElementById("icon-open")?.classList.remove("hidden");
        document.getElementById("icon-close")?.classList.add("hidden");
      }

      function initMobileMenu() {
        const btn       = document.getElementById("mobile-menu-btn");
        const menu      = document.getElementById("mobile-menu");
        const iconOpen  = document.getElementById("icon-open");
        const iconClose = document.getElementById("icon-close");
        btn?.addEventListener("click", () => {
          const isOpen = !menu?.classList.contains("hidden");
          menu?.classList.toggle("hidden", isOpen);
          iconOpen?.classList.toggle("hidden", !isOpen);
          iconClose?.classList.toggle("hidden", isOpen);
        });
      }

      // ── Active category highlight ──────────────────────────
      function initCategoryHighlight() {
        const params = new URLSearchParams(window.location.search);
        const activeCat = window.location.pathname === "/library" ? params.get("category") : null;
        document.querySelectorAll<HTMLAnchorElement>(".cat-nav-link").forEach((link) => {
          const on = !!activeCat && link.dataset.cat === activeCat;
          link.classList.toggle("bg-slate-800/70", on);
          link.classList.toggle("text-cyan-300", on);
          link.classList.toggle("text-slate-500", !on);
        });
      }

      // ── Nav progress bar across transitions ────────────────
      function initNavProgress() {
        const bar = document.getElementById("nav-progress");
        if (!bar) return;
        document.addEventListener("astro:before-preparation", () => {
          bar.classList.add("active");
          bar.style.width = "30%";
        });
        document.addEventListener("astro:after-preparation", () => {
          bar.style.width = "75%";
        });
        document.addEventListener("astro:page-load", () => {
          bar.style.width = "100%";
          setTimeout(() => {
            bar.classList.remove("active");
            bar.style.width = "0%";
          }, 280);
        });
      }

      // ── Master init, runs on first load + every transition ─
      // (only targets elements that live INSIDE <slot/> page content,
      //  which is fully replaced on every navigation)
      function initAll() {
        closeMobileMenu(); // header persists across transitions, so reset it whenever a navigation completes — otherwise tapping a link inside the open menu leaves it open on the destination page
        initCounters();
        initScrollReveal();
        initCategoryHighlight();
      }

      document.addEventListener("astro:page-load", initAll);

      // Delegated, document-level listeners AND anything targeting
      // elements inside the persisted <header> only need to bind once —
      // guard against double-binding in case this script block re-runs.
      if (!(window as any).__adexOnceInit) {
        (window as any).__adexOnceInit = true;
        initTilt();
        initNavProgress();
        initMobileMenu(); // button lives in transition:persist header
      }
    </script>
  </body>
</html>
